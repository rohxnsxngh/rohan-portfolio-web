---
import { ViewTransitions } from 'astro:transitions';
import Seo from "../components/Seo.astro";
import CustomCursor from "../components/CustomCursor.astro";
import Preloader from "../components/Preloader.astro";

const { title, description, image, frontmatter, robots } = Astro.props;
---

<html lang="en" class="bg-secondary text-primary" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/jpeg" href="/images/RS.jpg" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title ?? "Rohan Singh"}</title>
    <meta name="description" content={description} />

    <!-- The font lives in public/ so the URL resolves in the production build.
         It previously pointed at /src/fonts/… which only exists under the dev
         server, so every deployed page silently fell back to the platform's
         default monospace. -->
    <link
      rel="preload"
      href="/fonts/IBMPlexMono-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <Seo {title} {description} url={Astro.url} {image} {frontmatter} {robots} />
    <ViewTransitions />

    <style is:global>
      @font-face {
        font-family: 'IBM Plex Mono';
        src: url('/fonts/IBMPlexMono-Regular.woff2') format('woff2'),
             url('/fonts/IBMPlexMono-Regular.ttf') format('truetype');
        /* Only the Regular weight ships, so keep the declaration at `normal`
           and let the browser synthesise the bold/black weights the headers
           use — same rendering the dev server produced. */
        font-weight: normal;
        font-style: normal;
        font-display: swap;
      }

      :root {
        --transition-speed: 0.3s;
        color-scheme: dark;
      }

      /* Override DaisyUI's base content color to pure white */
      [data-theme="dark"] {
        --bc: 1 0 0; /* Pure white in OKLCH: lightness=1, chroma=0, hue=0 */
        --b1: 0 0 0; /* Pure black background */
        --b2: 0.05 0 0; /* Slightly lighter for secondary backgrounds */
        --b3: 0.1 0 0; /* Even lighter for tertiary */
      }

      * {
        font-family: 'IBM Plex Mono', monospace;
      }

      /* Consistent font rendering across platforms */
      html {
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
      }

      body {
        background-color: #000000;
        color: #FFFFFF;
        line-height: 1.6;
        letter-spacing: 0.02em;
      }

      ::selection {
        background-color: #FFFFFF;
        color: #000000;
      }

      .fade-in {
        animation: fadeIn 0.5s ease-in-out;
      }

      .slide-up {
        animation: slideUp 0.5s ease-out;
      }

      /* Lenis smooth scroll */
      html.lenis, html.lenis body {
        height: auto;
      }
      .lenis.lenis-smooth {
        scroll-behavior: auto;
      }
      .lenis.lenis-smooth [data-lenis-prevent] {
        overscroll-behavior: contain;
      }
      .lenis.lenis-stopped {
        overflow: hidden;
      }

      /* Custom scrollbar */
      ::-webkit-scrollbar {
        width: 8px;
      }

      ::-webkit-scrollbar-track {
        background: #000000;
      }

      ::-webkit-scrollbar-thumb {
        background: #333333;
        border-radius: 4px;
      }

      ::-webkit-scrollbar-thumb:hover {
        background: #666666;
      }

      /* ===== ACCESSIBILITY IMPROVEMENTS ===== */

      /* Skip to main content link - hidden until focused */
      .skip-link {
        position: absolute;
        top: -100px;
        left: 50%;
        transform: translateX(-50%);
        background: #ffffff;
        color: #000000;
        padding: 8px 16px;
        z-index: 10000;
        font-weight: bold;
        text-decoration: none;
        transition: top 0.2s ease;
        border-radius: 0 0 4px 4px;
      }

      .skip-link:focus {
        top: 0;
      }

      .skip-link:not(:focus) {
        clip: rect(0 0 0 0);
        clip-path: inset(50%);
        height: 1px;
        width: 1px;
        overflow: hidden;
        white-space: nowrap;
      }

      /* Focus indicators - visible on keyboard navigation */
      *:focus {
        outline: none;
      }

      *:focus-visible {
        outline: 2px solid #ffffff;
        outline-offset: 2px;
        border-radius: 2px;
      }

      /* Interactive elements focus styles */
      a:focus-visible,
      button:focus-visible,
      input:focus-visible,
      textarea:focus-visible,
      select:focus-visible,
      [tabindex]:focus-visible {
        outline: 2px solid #ffffff;
        outline-offset: 2px;
        box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.2);
      }

      /* Card and container focus styles */
      .project-card:focus-visible,
      .blog-card:focus-visible,
      .journey-card-wrapper:focus-visible {
        outline: 2px solid #ffffff;
        outline-offset: 4px;
      }

      /* Improve color contrast for low-opacity text - boost all opacity values for better cross-monitor consistency */
      .text-primary\/30 {
        color: rgba(255, 255, 255, 0.5) !important; /* Bumped from 30% to 50% */
      }

      .text-primary\/40 {
        color: rgba(255, 255, 255, 0.6) !important; /* Bumped from 40% to 60% */
      }

      .text-primary\/50 {
        color: rgba(255, 255, 255, 0.7) !important; /* Bumped from 50% to 70% */
      }

      .text-primary\/60 {
        color: rgba(255, 255, 255, 0.75) !important; /* Bumped from 60% to 75% */
      }

      .text-primary\/70 {
        color: rgba(255, 255, 255, 0.85) !important; /* Bumped from 70% to 85% */
      }

      .text-primary\/80 {
        color: rgba(255, 255, 255, 0.9) !important; /* Bumped from 80% to 90% */
      }

      /* Also boost text-white opacity variants */
      .text-white\/50 {
        color: rgba(255, 255, 255, 0.7) !important;
      }

      .text-white\/60 {
        color: rgba(255, 255, 255, 0.75) !important;
      }

      .text-white\/70 {
        color: rgba(255, 255, 255, 0.85) !important;
      }

      .text-white\/80 {
        color: rgba(255, 255, 255, 0.9) !important;
      }

      /* Reduced motion support */
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }

        .typewriter-cursor {
          animation: none !important;
        }

        .tech-grid {
          animation: none !important;
        }

        /* Disable parallax effects */
        .hero-content {
          transform: none !important;
        }
      }

      /* High contrast mode support */
      @media (prefers-contrast: high) {
        .text-primary\/30,
        .text-primary\/40,
        .text-primary\/50,
        .text-primary\/60,
        .text-primary\/70,
        .text-primary\/80,
        .text-white\/50,
        .text-white\/60,
        .text-white\/70,
        .text-white\/80 {
          color: rgba(255, 255, 255, 1) !important;
        }

        .border-accent\/10,
        .border-accent\/20,
        .border-accent\/30 {
          border-color: rgba(255, 255, 255, 0.5) !important;
        }
      }

      /* Fallback for browsers with poor OKLCH support */
      @supports not (color: oklch(1 0 0)) {
        [data-theme="dark"] {
          --fallback-bc: #ffffff;
          --fallback-b1: #000000;
          --fallback-b2: #0d0d0d;
          --fallback-b3: #1a1a1a;
        }
      }

      /* ===== REVEAL SAFETY NET =====
         Every page hides its hero/section content with `opacity: 0` in CSS and
         relies on the page's GSAP intro (which runs on `astro:page-load`) to
         reveal it. When that event does not arrive the content stays invisible
         forever — a blank page with a working navbar.

         `astro:page-load` genuinely does go missing: Astro only fires it from
         `viewTransition.ready.then(...)`, so any aborted View Transition
         (backgrounded tab, a second navigation interrupting the first, the
         renderer refusing to snapshot) swallows the event along with every
         init it drives.

         The inline watchdog in <head> re-dispatches the event, and if content
         is *still* hidden a moment later it sets `.reveal-fallback` here as a
         last resort. Scoped to intro-state selectors only — hover overlays
         (`.glow-overlay`, `.card-grid-overlay`, …) are legitimately opacity 0
         and must stay that way. */
      html.reveal-fallback .char,
      html.reveal-fallback .hero-subtitle,
      html.reveal-fallback .hero-description,
      html.reveal-fallback .scroll-indicator,
      html.reveal-fallback .scroll-indicator-minimal,
      html.reveal-fallback .section-title,
      html.reveal-fallback .label-intro,
      html.reveal-fallback .statement,
      html.reveal-fallback .cta-section,
      html.reveal-fallback .profile-section,
      html.reveal-fallback .intro-section,
      html.reveal-fallback .story-block,
      html.reveal-fallback .videos-section,
      html.reveal-fallback .gallery-section,
      html.reveal-fallback .artwork-card,
      html.reveal-fallback .coming-soon-section,
      html.reveal-fallback .slide-up,
      html.reveal-fallback .journey-card-wrapper,
      html.reveal-fallback .experience-card,
      html.reveal-fallback .research-card,
      html.reveal-fallback .project-card,
      html.reveal-fallback .blog-card,
      html.reveal-fallback .contact-form,
      html.reveal-fallback .footer-reveal {
        opacity: 1 !important;
        transform: none !important;
        visibility: visible !important;
      }

      html.reveal-fallback .accent-line {
        width: 200px !important;
      }

      /* ===== CUSTOM VIEW TRANSITION ANIMATIONS =====
         One animation owns the route change. There used to be a second,
         GSAP-driven black curtain (#transition-overlay) running at the same
         time; because that element was not `transition:persist`ed, the swap
         replaced the half-animated node with a fresh one, so the "out" tween
         restarted from a fully opaque black screen *after* the new page had
         already rendered — the flash of black between routes. */
      ::view-transition-old(root) {
        animation: vt-fade-out 0.28s cubic-bezier(0.4, 0, 1, 1) forwards;
      }

      ::view-transition-new(root) {
        animation: vt-fade-in 0.34s cubic-bezier(0, 0, 0.2, 1) forwards;
      }

      @keyframes vt-fade-out {
        0% {
          opacity: 1;
          transform: translateY(0);
        }
        100% {
          opacity: 0;
          transform: translateY(-16px);
        }
      }

      @keyframes vt-fade-in {
        0% {
          opacity: 0;
          transform: translateY(16px);
        }
        100% {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* The <h1> on every route carries transition:name="page-title", so the
         header morphs between routes instead of being cross-faded with the
         rest of the page. Give it its own slightly longer curve so it reads as
         one continuous element travelling between pages. */
      ::view-transition-old(page-title),
      ::view-transition-new(page-title) {
        animation-duration: 0.42s;
        animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1);
      }

      ::view-transition-group(page-title) {
        animation-duration: 0.42s;
        animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1);
      }

      /* Reduced motion: instant swap */
      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(root),
        ::view-transition-new(root),
        ::view-transition-old(page-title),
        ::view-transition-new(page-title) {
          animation: none !important;
        }
      }

      /* ===== MOBILE HERO INTRO (CSS-only, no GSAP) =====
         On phones (< 768px) the GSAP intro tweens are skipped in JS — these
         keyframes take over so the chars/subtitle/description still animate
         in, but via the compositor instead of allocating tween objects per
         element. Cheaper memory and CPU on weaker devices. */
      @keyframes mobileCharReveal {
        0%   { opacity: 0; transform: translateY(100px) scale(0.8); }
        60%  { transform: translateY(-10px) scale(1.02); }
        100% { opacity: 1; transform: translateY(0) scale(1); }
      }

      @keyframes mobileFadeInUp {
        from { opacity: 0; transform: translateY(30px); }
        to   { opacity: 1; transform: translateY(0); }
      }

      @keyframes mobileFadeIn {
        from { opacity: 0; }
        to   { opacity: 1; }
      }

      @keyframes mobileLineExpand {
        from { width: 0; }
        to   { width: 200px; }
      }

      @media (max-width: 767px) {
        /* Matches the desktop behaviour: on a client-side navigation the
           header is morphed between routes by the page-title view transition,
           so re-running the reveal from opacity 0 would flash it. */
        html:not(.spa-nav) .char {
          animation: mobileCharReveal 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
        .char-1  { animation-delay: 0.05s; }
        .char-2  { animation-delay: 0.10s; }
        .char-3  { animation-delay: 0.15s; }
        .char-4  { animation-delay: 0.20s; }
        .char-5  { animation-delay: 0.25s; }
        .char-6  { animation-delay: 0.30s; }
        .char-7  { animation-delay: 0.35s; }
        .char-8  { animation-delay: 0.40s; }
        .char-9  { animation-delay: 0.45s; }
        .char-10 { animation-delay: 0.50s; }

        .hero-subtitle    { animation: mobileFadeInUp 0.8s ease-out 0.5s forwards; }
        .hero-description { animation: mobileFadeInUp 0.8s ease-out 0.7s forwards; }
        .scroll-indicator,
        .scroll-indicator-minimal { animation: mobileFadeIn 0.8s ease-out 1s forwards; }
        .accent-line      { animation: mobileLineExpand 1.2s ease-out 0.3s forwards; }

        /* Home-specific elements */
        .label-intro { animation: mobileFadeInUp 0.8s ease-out 0s forwards; }
        .statement   { animation: mobileFadeInUp 0.8s ease-out 0.5s forwards; }
        .cta-section { animation: mobileFadeInUp 0.8s ease-out 0.7s forwards; }

        @media (prefers-reduced-motion: reduce) {
          .char,
          .hero-subtitle,
          .hero-description,
          .scroll-indicator,
          .scroll-indicator-minimal,
          .accent-line,
          .label-intro,
          .statement,
          .cta-section {
            animation: none !important;
            opacity: 1 !important;
            transform: none !important;
            width: auto;
          }
          .accent-line { width: 200px; }
        }
      }

      /* ===== MOBILE HOLD-TO-PLAY HINT =====
         Desktop has the cursor caption via [data-cursor-label] — that surface
         doesn't exist on touch devices, so on mobile a small bottom-anchored
         caption fades in over each model container and self-dismisses after
         a few seconds. Pure CSS, no JS, runs once per page load. */
      @media (hover: none) and (pointer: coarse) {
        [data-cursor-press]::after {
          content: 'TOUCH \00a0 & \00a0 HOLD';
          position: absolute;
          bottom: 16px;
          left: 50%;
          transform: translate(-50%, 8px);
          font-family: 'IBM Plex Mono', monospace;
          font-size: 9px;
          font-weight: 600;
          letter-spacing: 0.3em;
          color: rgba(255, 255, 255, 0.85);
          padding: 6px 12px;
          background: rgba(0, 0, 0, 0.72);
          border: 1px solid rgba(255, 255, 255, 0.18);
          pointer-events: none;
          opacity: 0;
          z-index: 10;
          animation: mobileHoldHint 5s ease-out forwards;
        }
      }

      @keyframes mobileHoldHint {
        0%        { opacity: 0; transform: translate(-50%, 8px); }
        12%, 70%  { opacity: 1; transform: translate(-50%, 0); }
        100%      { opacity: 0; transform: translate(-50%, 0); }
      }

      @media (hover: none) and (pointer: coarse) and (prefers-reduced-motion: reduce) {
        [data-cursor-press]::after {
          animation: none;
          opacity: 0.85;
          transform: translate(-50%, 0);
        }
      }
    </style>
  </head>
  <body class="min-h-screen">
    <!-- Skip to main content link for keyboard users -->
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <CustomCursor transition:persist="custom-cursor-singleton" />
    <Preloader />

    <!-- Reveal watchdog. Deliberately `is:inline` and byte-identical on every
         page: Astro's swap marks inline scripts whose text already exists in
         the document as executed, so this registers exactly once per session
         and survives navigations without accumulating duplicate handlers.
         Being inline also means it cannot fail to arrive over the network —
         it is the one piece of JS guaranteed to run. -->
    <script is:inline>
      (function () {
        if (window.__revealWatchdog) return;
        window.__revealWatchdog = true;

        var root = document.documentElement;
        var recoverTimer = null;
        var fallbackTimer = null;
        var attempts = 0;

        // Read by src/scripts/pageReady.ts. A page script that finishes
        // evaluating after Astro has already dispatched astro:page-load needs
        // to know it missed the event so it can initialise anyway. This script
        // is inline, so it is registered before any module can run.
        window.__astroPageLoaded = false;

        // ---- Keep an aborted View Transition from stranding the page -------
        //
        // Astro's router does all of its post-navigation work inside
        // `viewTransition.ready.then(...)`:
        //
        //     viewTransition.ready.then(async () => {
        //       await runScripts();   // activates the new page's <script> tags
        //       onPageLoad();         // fires astro:page-load
        //     });
        //
        // so when `ready` rejects, the incoming route's scripts are never even
        // executed and astro:page-load never fires. The DOM has already been
        // swapped by that point, which is how you end up looking at a new page
        // whose header, body copy and 3D viewer never initialise — the exact
        // "text and headers don't load" failure.
        //
        // The browser rejects `ready` routinely: it refuses to run a view
        // transition on a hidden document (switch tabs or apps mid-navigation
        // and you come back to a dead page), and it aborts on a handful of
        // other invalid states. Patching `startViewTransition` here degrades
        // those cases to a plain, un-animated swap instead of a broken page.
        var nativeStartViewTransition = document.startViewTransition &&
          document.startViewTransition.bind(document);

        if (nativeStartViewTransition) {
          document.startViewTransition = function (callback) {
            // A hidden document cannot run a view transition at all, so skip
            // straight to the plain swap rather than starting one to fail.
            if (document.visibilityState === 'hidden') {
              var done = Promise.resolve().then(callback);
              return {
                updateCallbackDone: done,
                ready: done,
                finished: done,
                skipTransition: function () {},
              };
            }

            var vt = nativeStartViewTransition(callback);

            return {
              updateCallbackDone: vt.updateCallbackDone,
              // Fall back to "the DOM update finished" so Astro still runs the
              // new page's scripts. If the update callback itself rejected —
              // Astro throws there when a newer navigation supersedes this one
              // — this stays rejected and the stale navigation correctly does
              // nothing.
              ready: vt.ready.catch(function () { return vt.updateCallbackDone; }),
              finished: vt.finished.catch(function () {}),
              skipTransition: function () { return vt.skipTransition(); },
            };
          };
        }

        // Selectors that are hidden purely as an intro state. Hover-driven
        // overlays are intentionally excluded.
        var INTRO = [
          '.char', '.hero-subtitle', '.hero-description', '.scroll-indicator',
          '.scroll-indicator-minimal', '.section-title', '.label-intro',
          '.statement', '.cta-section', '.profile-section', '.intro-section',
          '.story-block', '.videos-section', '.gallery-section',
          '.artwork-card', '.coming-soon-section', '.slide-up',
          '.journey-card-wrapper', '.experience-card', '.research-card',
          '.project-card', '.blog-card', '.contact-form'
        ].join(',');

        function anythingStillHidden() {
          var els = document.querySelectorAll(INTRO);
          for (var i = 0; i < els.length; i++) {
            var el = els[i];

            // GSAP writes an inline opacity and tags elements it controls with
            // a `_gsap` record. Either means the page's animations DID run, so
            // a zero opacity here is deliberate — the hero fading out as you
            // scroll, a card waiting below the fold. Only elements the page
            // script never touched indicate the init was skipped.
            if (el.style && el.style.opacity !== '') continue;
            if (el._gsap) continue;

            // Below-the-fold content is legitimately hidden while it waits for
            // its scroll trigger; only judge what is actually on screen.
            var r = el.getBoundingClientRect();
            if (r.bottom < 0 || r.top > window.innerHeight) continue;
            if (r.width === 0 && r.height === 0) continue;

            if (parseFloat(getComputedStyle(el).opacity) < 0.05) return true;
          }
          return false;
        }

        function clearTimers() {
          clearTimeout(recoverTimer);
          clearTimeout(fallbackTimer);
        }

        // Watches a single page view. Two things can go wrong: Astro never
        // fires astro:page-load (an aborted View Transition swallows it), or it
        // fires but a page script registered too late to hear it. Both leave
        // the same fingerprint — on-screen content still sitting at the
        // opacity: 0 its intro was supposed to clear — so both are handled by
        // re-dispatching the event, and by forcing the content visible if even
        // that does not take.
        function arm() {
          clearTimers();
          recoverTimer = setTimeout(function () {
            if (!anythingStillHidden()) return;

            if (attempts < 2) {
              attempts++;
              // Page handlers all tear down their previous state first, so
              // re-running them is safe. This re-enters arm() via the listener
              // below, which is why the attempt counter exists.
              document.dispatchEvent(new Event('astro:page-load'));
              return;
            }

            root.classList.add('reveal-fallback');
          }, 700);
        }

        // A swap happened. If astro:page-load does not follow, the View
        // Transition was aborted and Astro skipped every init it drives.
        document.addEventListener('astro:after-swap', function () {
          // Mark this as a client-side navigation. The <h1> on every route
          // shares transition:name="page-title", so the browser morphs it from
          // the old page to the new one — but it snapshots the *new* header
          // right after this event, long before astro:page-load runs the intro
          // animation. With the usual `.char { opacity: 0 }` intro state still
          // applied, that snapshot is an empty box and the header appears to
          // vanish and pop back in. Marking the document here (the swap wipes
          // <html>'s attributes, so it has to be re-applied every time) lets
          // the per-page CSS skip the hidden intro state and hand the header
          // to the morph already visible.
          root.classList.add('spa-nav');

          window.__astroPageLoaded = false;
          attempts = 0;
          root.classList.remove('reveal-fallback');
          arm();
        });

        document.addEventListener('astro:page-load', function () {
          window.__astroPageLoaded = true;
          arm();
        });

        // Belt-and-braces for the very first paint, before any Astro event.
        arm();
      })();
    </script>

    <script>
      import "../scripts/haptics";
    </script>
    <script>
      import { initSmoothScroll, destroySmoothScroll } from '../scripts/smooth-scroll';
      import { initMagneticButtons } from '../scripts/magnetic';
      import { killAllScrollTriggers, scrollReveal, refreshScrollTriggers, revealStragglers } from '../scripts/animations';
      import gsap from 'gsap';

      // Astro bundles each page's hoisted scripts into its own chunk, and this
      // layout script is inlined into every one of them. Navigating to a route
      // whose chunk has not run yet therefore executes this module *again* —
      // previously adding a second, third, nth copy of every listener below,
      // so `initSmoothScroll` and the rest ran once per route ever visited.
      // Register once per document instead.
      if (!(window as any).__layoutBound) {
        (window as any).__layoutBound = true;

        // Cleanup before page swap (View Transitions)
        document.addEventListener('astro:before-swap', () => {
          killAllScrollTriggers();

          // Kill ALL active GSAP tweens and timelines to prevent stale inline
          // styles and accumulated repeat:-1 tweens leaking across navigations
          gsap.globalTimeline.getChildren(true, true, true).forEach((child: any) => {
            child.kill();
          });

          // Clear GSAP inline styles so the View Transition captures a clean
          // state (no leftover opacity:0, transform, etc.)
          document.querySelectorAll('.char, .name-line, .hero-name, .label-intro, .statement, .cta-section, .scroll-indicator-minimal, .scroll-indicator, .hero-subtitle, .hero-description, .hero-overlay').forEach(el => {
            gsap.set(el, { clearProps: 'all' });
          });

          destroySmoothScroll();
        });

        // Init on every page load (initial + View Transition navigations).
        // Each init runs independently — a throw in one (e.g. smooth-scroll)
        // must not prevent scrollReveal from running and revealing the footer,
        // which would otherwise stay permanently invisible for the page view.
        document.addEventListener('astro:page-load', () => {
          // Safety: ensure the preloader is gone (fallback for edge cases)
          const preloader = document.getElementById('preloader');
          if (preloader && !preloader.classList.contains('hidden')) {
            preloader.classList.add('hidden');
          }

          try { initSmoothScroll(); } catch (e) { console.error('[Layout] initSmoothScroll failed', e); }
          try { initMagneticButtons(); } catch (e) { console.error('[Layout] initMagneticButtons failed', e); }
          try { scrollReveal('.footer-reveal'); } catch (e) { console.error('[Layout] scrollReveal failed', e); }

          // ScrollTrigger caches each trigger's start/end against the document
          // height measured at creation time. After a swap the DOM is entirely
          // new and images, web fonts and the 3D canvases all settle *after*
          // these triggers are built, leaving the cached offsets pointing at
          // the wrong scroll positions — which is why section headings would
          // sometimes never reach their trigger and stay at opacity 0.
          // Nothing called refresh() anywhere in the app before this.
          try { refreshScrollTriggers(); } catch (e) { console.error('[Layout] refreshScrollTriggers failed', e); }

          // Last sweep once everything has settled: fade in anything a trigger
          // stranded invisible inside the viewport.
          setTimeout(() => {
            try { revealStragglers(); } catch (e) { console.error('[Layout] revealStragglers failed', e); }
          }, 2000);
        });
      }
    </script>
    <main id="main-content" role="main">
      <slot />
    </main>
  </body>
</html>
