---
import { ViewTransitions } from 'astro:transitions';
import Seo from "../components/Seo.astro";
import CustomCursor from "../components/CustomCursor.astro";
import Preloader from "../components/Preloader.astro";

const { title, description, image, frontmatter, robots } = Astro.props;
---

<html lang="en" class="bg-secondary text-primary" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/jpeg" href="/images/RS.jpg" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <meta
      name="description"
      content="Learn about Rohan Singh, a software engineer with a background in mechanical engineering. Explore his projects, skills, and experiences."
    />
    <title>Rohan Singh</title>
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <Seo {title} {description} url={Astro.url} {image} {frontmatter} {robots} />
    <ViewTransitions />

    <style is:global>
      @font-face {
        font-family: 'IBM Plex Mono';
        src: url('/src/fonts/IBMPlexMono-Regular.ttf') format('truetype');
        font-weight: normal;
        font-style: normal;
        font-display: swap;
      }

      :root {
        --transition-speed: 0.3s;
        color-scheme: dark;
      }

      /* Override DaisyUI's base content color to pure white */
      [data-theme="dark"] {
        --bc: 1 0 0; /* Pure white in OKLCH: lightness=1, chroma=0, hue=0 */
        --b1: 0 0 0; /* Pure black background */
        --b2: 0.05 0 0; /* Slightly lighter for secondary backgrounds */
        --b3: 0.1 0 0; /* Even lighter for tertiary */
      }

      * {
        font-family: 'IBM Plex Mono', monospace;
      }

      /* Consistent font rendering across platforms */
      html {
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
      }

      body {
        background-color: #000000;
        color: #FFFFFF;
        line-height: 1.6;
        letter-spacing: 0.02em;
      }

      ::selection {
        background-color: #FFFFFF;
        color: #000000;
      }

      .fade-in {
        animation: fadeIn 0.5s ease-in-out;
      }

      .slide-up {
        animation: slideUp 0.5s ease-out;
      }

      /* Lenis smooth scroll */
      html.lenis, html.lenis body {
        height: auto;
      }
      .lenis.lenis-smooth {
        scroll-behavior: auto;
      }
      .lenis.lenis-smooth [data-lenis-prevent] {
        overscroll-behavior: contain;
      }
      .lenis.lenis-stopped {
        overflow: hidden;
      }

      /* Custom scrollbar */
      ::-webkit-scrollbar {
        width: 8px;
      }

      ::-webkit-scrollbar-track {
        background: #000000;
      }

      ::-webkit-scrollbar-thumb {
        background: #333333;
        border-radius: 4px;
      }

      ::-webkit-scrollbar-thumb:hover {
        background: #666666;
      }

      /* ===== ACCESSIBILITY IMPROVEMENTS ===== */

      /* Skip to main content link - hidden until focused */
      .skip-link {
        position: absolute;
        top: -100px;
        left: 50%;
        transform: translateX(-50%);
        background: #ffffff;
        color: #000000;
        padding: 8px 16px;
        z-index: 10000;
        font-weight: bold;
        text-decoration: none;
        transition: top 0.2s ease;
        border-radius: 0 0 4px 4px;
      }

      .skip-link:focus {
        top: 0;
      }

      .skip-link:not(:focus) {
        clip: rect(0 0 0 0);
        clip-path: inset(50%);
        height: 1px;
        width: 1px;
        overflow: hidden;
        white-space: nowrap;
      }

      /* Focus indicators - visible on keyboard navigation */
      *:focus {
        outline: none;
      }

      *:focus-visible {
        outline: 2px solid #ffffff;
        outline-offset: 2px;
        border-radius: 2px;
      }

      /* Interactive elements focus styles */
      a:focus-visible,
      button:focus-visible,
      input:focus-visible,
      textarea:focus-visible,
      select:focus-visible,
      [tabindex]:focus-visible {
        outline: 2px solid #ffffff;
        outline-offset: 2px;
        box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.2);
      }

      /* Card and container focus styles */
      .project-card:focus-visible,
      .blog-card:focus-visible,
      .journey-card-wrapper:focus-visible {
        outline: 2px solid #ffffff;
        outline-offset: 4px;
      }

      /* Improve color contrast for low-opacity text - boost all opacity values for better cross-monitor consistency */
      .text-primary\/30 {
        color: rgba(255, 255, 255, 0.5) !important; /* Bumped from 30% to 50% */
      }

      .text-primary\/40 {
        color: rgba(255, 255, 255, 0.6) !important; /* Bumped from 40% to 60% */
      }

      .text-primary\/50 {
        color: rgba(255, 255, 255, 0.7) !important; /* Bumped from 50% to 70% */
      }

      .text-primary\/60 {
        color: rgba(255, 255, 255, 0.75) !important; /* Bumped from 60% to 75% */
      }

      .text-primary\/70 {
        color: rgba(255, 255, 255, 0.85) !important; /* Bumped from 70% to 85% */
      }

      .text-primary\/80 {
        color: rgba(255, 255, 255, 0.9) !important; /* Bumped from 80% to 90% */
      }

      /* Also boost text-white opacity variants */
      .text-white\/50 {
        color: rgba(255, 255, 255, 0.7) !important;
      }

      .text-white\/60 {
        color: rgba(255, 255, 255, 0.75) !important;
      }

      .text-white\/70 {
        color: rgba(255, 255, 255, 0.85) !important;
      }

      .text-white\/80 {
        color: rgba(255, 255, 255, 0.9) !important;
      }

      /* Reduced motion support */
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }

        .typewriter-cursor {
          animation: none !important;
        }

        .tech-grid {
          animation: none !important;
        }

        /* Disable parallax effects */
        .hero-content {
          transform: none !important;
        }
      }

      /* High contrast mode support */
      @media (prefers-contrast: high) {
        .text-primary\/30,
        .text-primary\/40,
        .text-primary\/50,
        .text-primary\/60,
        .text-primary\/70,
        .text-primary\/80,
        .text-white\/50,
        .text-white\/60,
        .text-white\/70,
        .text-white\/80 {
          color: rgba(255, 255, 255, 1) !important;
        }

        .border-accent\/10,
        .border-accent\/20,
        .border-accent\/30 {
          border-color: rgba(255, 255, 255, 0.5) !important;
        }
      }

      /* Fallback for browsers with poor OKLCH support */
      @supports not (color: oklch(1 0 0)) {
        [data-theme="dark"] {
          --fallback-bc: #ffffff;
          --fallback-b1: #000000;
          --fallback-b2: #0d0d0d;
          --fallback-b3: #1a1a1a;
        }
      }

      /* ===== VIEW TRANSITION OVERLAY ===== */
      .transition-overlay {
        position: fixed;
        inset: 0;
        z-index: 9998;
        background: #000000;
        pointer-events: none;
        transform: scaleY(0);
        transform-origin: bottom;
      }

      /* ===== CUSTOM VIEW TRANSITION ANIMATIONS ===== */
      ::view-transition-old(root) {
        animation: vt-slide-out 0.4s cubic-bezier(0.76, 0, 0.24, 1) forwards;
      }

      ::view-transition-new(root) {
        animation: vt-slide-in 0.4s cubic-bezier(0.76, 0, 0.24, 1) forwards;
        animation-delay: 0.15s;
      }

      @keyframes vt-slide-out {
        0% {
          opacity: 1;
          transform: translateY(0);
        }
        100% {
          opacity: 0;
          transform: translateY(-30px);
        }
      }

      @keyframes vt-slide-in {
        0% {
          opacity: 0;
          transform: translateY(30px);
        }
        100% {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* Reduced motion: instant swap */
      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(root),
        ::view-transition-new(root) {
          animation: none !important;
        }
      }

      /* ===== MOBILE HERO INTRO (CSS-only, no GSAP) =====
         On phones (< 768px) the GSAP intro tweens are skipped in JS — these
         keyframes take over so the chars/subtitle/description still animate
         in, but via the compositor instead of allocating tween objects per
         element. Cheaper memory and CPU on weaker devices. */
      @keyframes mobileCharReveal {
        0%   { opacity: 0; transform: translateY(100px) scale(0.8); }
        60%  { transform: translateY(-10px) scale(1.02); }
        100% { opacity: 1; transform: translateY(0) scale(1); }
      }

      @keyframes mobileFadeInUp {
        from { opacity: 0; transform: translateY(30px); }
        to   { opacity: 1; transform: translateY(0); }
      }

      @keyframes mobileFadeIn {
        from { opacity: 0; }
        to   { opacity: 1; }
      }

      @keyframes mobileLineExpand {
        from { width: 0; }
        to   { width: 200px; }
      }

      @media (max-width: 767px) {
        .char {
          animation: mobileCharReveal 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
        .char-1  { animation-delay: 0.05s; }
        .char-2  { animation-delay: 0.10s; }
        .char-3  { animation-delay: 0.15s; }
        .char-4  { animation-delay: 0.20s; }
        .char-5  { animation-delay: 0.25s; }
        .char-6  { animation-delay: 0.30s; }
        .char-7  { animation-delay: 0.35s; }
        .char-8  { animation-delay: 0.40s; }
        .char-9  { animation-delay: 0.45s; }
        .char-10 { animation-delay: 0.50s; }

        .hero-subtitle    { animation: mobileFadeInUp 0.8s ease-out 0.5s forwards; }
        .hero-description { animation: mobileFadeInUp 0.8s ease-out 0.7s forwards; }
        .scroll-indicator,
        .scroll-indicator-minimal { animation: mobileFadeIn 0.8s ease-out 1s forwards; }
        .accent-line      { animation: mobileLineExpand 1.2s ease-out 0.3s forwards; }

        /* Home-specific elements */
        .label-intro { animation: mobileFadeInUp 0.8s ease-out 0s forwards; }
        .statement   { animation: mobileFadeInUp 0.8s ease-out 0.5s forwards; }
        .cta-section { animation: mobileFadeInUp 0.8s ease-out 0.7s forwards; }

        @media (prefers-reduced-motion: reduce) {
          .char,
          .hero-subtitle,
          .hero-description,
          .scroll-indicator,
          .scroll-indicator-minimal,
          .accent-line,
          .label-intro,
          .statement,
          .cta-section {
            animation: none !important;
            opacity: 1 !important;
            transform: none !important;
            width: auto;
          }
          .accent-line { width: 200px; }
        }
      }

      /* ===== MOBILE HOLD-TO-PLAY HINT =====
         Desktop has the cursor caption via [data-cursor-label] — that surface
         doesn't exist on touch devices, so on mobile a small bottom-anchored
         caption fades in over each model container and self-dismisses after
         a few seconds. Pure CSS, no JS, runs once per page load. */
      @media (hover: none) and (pointer: coarse) {
        [data-cursor-press]::after {
          content: 'TOUCH \00a0 & \00a0 HOLD';
          position: absolute;
          bottom: 16px;
          left: 50%;
          transform: translate(-50%, 8px);
          font-family: 'IBM Plex Mono', monospace;
          font-size: 9px;
          font-weight: 600;
          letter-spacing: 0.3em;
          color: rgba(255, 255, 255, 0.85);
          padding: 6px 12px;
          background: rgba(0, 0, 0, 0.72);
          border: 1px solid rgba(255, 255, 255, 0.18);
          pointer-events: none;
          opacity: 0;
          z-index: 10;
          animation: mobileHoldHint 5s ease-out forwards;
        }
      }

      @keyframes mobileHoldHint {
        0%        { opacity: 0; transform: translate(-50%, 8px); }
        12%, 70%  { opacity: 1; transform: translate(-50%, 0); }
        100%      { opacity: 0; transform: translate(-50%, 0); }
      }

      @media (hover: none) and (pointer: coarse) and (prefers-reduced-motion: reduce) {
        [data-cursor-press]::after {
          animation: none;
          opacity: 0.85;
          transform: translate(-50%, 0);
        }
      }
    </style>
  </head>
  <body class="min-h-screen">
    <!-- Skip to main content link for keyboard users -->
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <CustomCursor transition:persist="custom-cursor-singleton" />
    <Preloader />
    <div class="transition-overlay" id="transition-overlay"></div>
    <script>
      import "../scripts/haptics";
    </script>
    <script>
      import { initSmoothScroll, destroySmoothScroll } from '../scripts/smooth-scroll';
      import { initMagneticButtons } from '../scripts/magnetic';
      import { killAllScrollTriggers, scrollReveal } from '../scripts/animations';
      import gsap from 'gsap';

      console.log('[Layout] Script loaded');

      // Track whether first navigation has happened (skip overlay on initial load)
      let hasNavigated = false;

      // Transition overlay animation — only during actual View Transition navigations
      document.addEventListener('astro:before-preparation', () => {
        console.log('[Layout] astro:before-preparation fired, hasNavigated:', hasNavigated);
        if (!hasNavigated) return; // Skip on initial page load
        const overlay = document.getElementById('transition-overlay');
        if (overlay) {
          console.log('[Layout] Animating overlay IN (scaleY 0→1)');
          gsap.fromTo(overlay,
            { scaleY: 0, transformOrigin: 'bottom' },
            { scaleY: 1, duration: 0.4, ease: 'expo.inOut' }
          );
        }
      });

      document.addEventListener('astro:after-swap', () => {
        console.log('[Layout] astro:after-swap fired');
        const overlay = document.getElementById('transition-overlay');
        if (overlay) {
          console.log('[Layout] Animating overlay OUT (scaleY 1→0)');
          gsap.fromTo(overlay,
            { scaleY: 1, transformOrigin: 'top' },
            { scaleY: 0, duration: 0.4, ease: 'expo.inOut', delay: 0.05 }
          );
        }
      });

      // Cleanup before page swap (View Transitions)
      document.addEventListener('astro:before-swap', () => {
        console.log('[Layout] astro:before-swap fired — cleaning up');

        // Kill all ScrollTriggers first
        killAllScrollTriggers();

        // Kill ALL active GSAP tweens and timelines to prevent stale inline styles
        // and accumulated repeat:-1 tweens from leaking across navigations
        gsap.globalTimeline.getChildren(true, true, true).forEach((child: any) => {
          child.kill();
        });

        // Clear GSAP inline styles from animated elements so View Transition
        // captures clean state (no leftover opacity:0, transform, etc.)
        document.querySelectorAll('.char, .name-line, .hero-name, .label-intro, .statement, .cta-section, .scroll-indicator-minimal, .scroll-indicator, .hero-subtitle, .hero-description, .hero-overlay, [class*="title"] .char').forEach(el => {
          gsap.set(el, { clearProps: 'all' });
        });

        destroySmoothScroll();
      });

      // Init on every page load (initial + View Transition navigations)
      document.addEventListener('astro:page-load', () => {
        console.log('[Layout] astro:page-load fired, URL:', window.location.pathname);

        // Mark that we've loaded — future navigations will use overlay
        hasNavigated = true;

        // Safety: ensure transition overlay is definitely hidden
        const overlay = document.getElementById('transition-overlay');
        if (overlay) {
          const overlayTransform = getComputedStyle(overlay).transform;
          console.log('[Layout] Overlay current transform:', overlayTransform);
          // Force it hidden if it's somehow stuck
          gsap.set(overlay, { scaleY: 0 });
        }

        // Safety: ensure preloader is gone (fallback for edge cases)
        const preloader = document.getElementById('preloader');
        if (preloader && !preloader.classList.contains('hidden') && preloader.style.display !== 'none') {
          console.warn('[Layout] Preloader still visible on page-load! Force hiding.');
          preloader.classList.add('hidden');
        }

        // Debug: check what might be covering the screen
        const allFixed = document.querySelectorAll('*');
        allFixed.forEach(el => {
          const style = getComputedStyle(el);
          if (style.position === 'fixed' && style.zIndex && parseInt(style.zIndex) > 100) {
            const rect = (el as HTMLElement).getBoundingClientRect();
            if (rect.width > 0 && rect.height > 0 && style.opacity !== '0' && style.display !== 'none' && style.visibility !== 'hidden') {
              const transform = style.transform;
              console.log(`[Layout] Fixed high-z element: ${(el as HTMLElement).id || el.tagName}.${(el as HTMLElement).className.split(' ')[0]}`, {
                zIndex: style.zIndex,
                opacity: style.opacity,
                transform: transform,
                size: `${rect.width}x${rect.height}`,
              });
            }
          }
        });

        initSmoothScroll();
        initMagneticButtons();
        scrollReveal('.footer-reveal');

        console.log('[Layout] Page init complete');
      });
    </script>
    <main id="main-content" role="main">
      <slot />
    </main>
  </body>
</html>
