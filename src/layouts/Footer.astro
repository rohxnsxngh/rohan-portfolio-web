---
import { Image } from "astro:assets";
import RS from "@images/RS.jpg";
import ObfuscatedEmail from "../components/ObfuscatedEmail.astro";

// Astro frontmatter runs at build time, so this is stamped once per deploy
// rather than read from the visitor's clock. The copyright had been frozen at
// 2024 while the newest work on the site is dated 2026, which reads like the
// site was abandoned.
const currentYear = new Date().getFullYear();
---

<footer class="site-footer footer-reveal w-full py-4 relative z-40" role="contentinfo" aria-label="Site footer" style="opacity: 0; transform: translateY(20px);">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-12">
    <div class="flex flex-row justify-between items-center">
      <div class="flex items-center gap-2">
        <!-- Same treatment as the navbar logo: a 20px box does not need the
             1024px q=100 source Astro emitted without an explicit size. -->
        <Image
          src={RS}
          alt="Rohan Singh"
          class="footer-logo h-4 w-4 sm:h-5 sm:w-5 rounded-full opacity-20"
          width={48}
          height={48}
          quality={60}
          loading="lazy"
        />
        <div class="footer-copy text-primary/20 text-[9px] sm:text-[10px] font-mono tracking-wider">
          <p>© {currentYear} Rohan Singh</p>
        </div>
      </div>

      <nav class="flex items-center gap-3 sm:gap-4" aria-label="Social links">
        <a href="https://github.com/rohxnsxngh"
            class="footer-social text-primary/20 hover:text-primary/50 transition-colors duration-300 group"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub">
          <img src="/github.svg" class="w-3 h-3 sm:w-3.5 sm:h-3.5 brightness-0 invert opacity-20 group-hover:opacity-50 transition-opacity" alt="GitHub" loading="lazy"/>
        </a>
        <a href="https://www.linkedin.com/in/rohxnsxngh/"
            class="footer-social text-primary/20 hover:text-primary/50 transition-colors duration-300 group"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn">
          <img src="/linkedin.svg" class="w-3 h-3 sm:w-3.5 sm:h-3.5 brightness-0 invert opacity-20 group-hover:opacity-50 transition-opacity" alt="LinkedIn" loading="lazy"/>
        </a>
        <ObfuscatedEmail
          email="rohan.singh.do@gmail.com"
          class="footer-social text-primary/20 hover:text-primary/50 transition-colors duration-300 group"
        >
          <img src="/google.svg" class="w-3 h-3 sm:w-3.5 sm:h-3.5 brightness-0 invert opacity-20 group-hover:opacity-50 transition-opacity" alt="Email" loading="lazy"/>
        </ObfuscatedEmail>
        <a href="/Rohan_Singh_Resume.pdf"
            class="footer-social text-primary/20 hover:text-primary/50 transition-colors duration-300 group"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Resume">
          <img src="/document.svg" class="w-3 h-3 sm:w-3.5 sm:h-3.5 brightness-0 invert opacity-20 group-hover:opacity-50 transition-opacity" alt="Resume" loading="lazy"/>
        </a>
      </nav>
    </div>
  </div>
</footer>

<!-- is:global, prefixed with .site-footer, rather than Astro's scoped styles:
     a scoped rule compiles to `.footer-social[data-astro-cid-…]`, and
     ObfuscatedEmail renders its own <a> without forwarding that attribute,
     so the email icon silently missed every rule below when this was scoped.
     Everything here is gated on a touch surface so desktop keeps the utility
     classes in the markup exactly as they were. -->
<style is:global>
  @media (hover: none) and (pointer: coarse) {
    /* The 9px, 20%-white copy was about 1.6:1 against black, below what a
       phone in daylight can resolve. 0.7 is what this site's text-primary/50
       utility renders as after the contrast bump in Layout.astro, so the
       footer reads at the same level as every other /50 caption. */
    .site-footer .footer-copy {
      color: rgba(255, 255, 255, 0.7);
      font-size: 11px;
    }
    .site-footer .footer-logo,
    .site-footer .footer-social img {
      opacity: 0.5;
    }
    .site-footer .footer-social img {
      width: 0.875rem;
      height: 0.875rem;
    }

    /* Each icon is 14px, so the anchor is padded out to a 44px square, the
       iOS minimum touch target. The negative margins pull the extra area
       back out of the flow so the footer height and the icon rhythm stay
       put. Horizontally the pull is capped at half the 12px gap: a 44px box
       with a 32px flow width extends exactly 6px into the gap on each side,
       so neighbouring boxes meet without overlapping and every icon keeps
       the full 44px of exclusive hit area (at sm:gap-4 they sit 4px apart).
       Pulling the full 15px on that axis, as this first shipped, made
       adjacent boxes overlap by 18px and a tap just right of an icon opened
       the next link. */
    .site-footer .footer-social {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 44px;
      min-height: 44px;
      margin: -15px -6px;
    }
  }
</style>
