---
import { Image } from "astro:assets";
import RS from "@images/RS.jpg";

const currentPath = Astro.url.pathname;
function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<nav class="nav-root fixed w-full z-50" role="navigation" aria-label="Main navigation" transition:persist>
  <div class="sm:px-20 px-6">
    <div class="flex justify-between items-center h-14">
      <!-- Minimal Logo - far left -->
      <div class="flex-shrink-0">
        <a href="/" class="nav-logo flex items-center space-x-2 transition-opacity duration-300" aria-label="Rohan Singh - Home">
          <!-- Rendered in a 24px box, so 48px covers 2x screens. Without an
               explicit size Astro emitted the source's 1024px at q=100 as an
               eager request on every page, which weighed more than the HTML
               and CSS of the home page combined. -->
          <Image
            src={RS}
            alt="Rohan Singh logo"
            class="h-6 w-6 rounded-full opacity-40"
            width={48}
            height={48}
            quality={60}
            loading="eager"
          />
          <span class="text-primary/40 font-mono text-xs tracking-[0.3em] uppercase" aria-hidden="true">RS</span>
        </a>
      </div>

      <!-- Desktop Navigation - far right -->
      <div class="hidden md:flex items-center space-x-8" role="menubar">
        <a href="/" class={`nav-link ${isActive('/') ? 'nav-active' : ''}`} role="menuitem" data-haptic="selection" data-magnetic>Home</a>
        <a href="/about/" class={`nav-link ${isActive('/about') ? 'nav-active' : ''}`} role="menuitem" data-haptic="selection" data-magnetic>About</a>
        <a href="/experience/" class={`nav-link ${isActive('/experience') ? 'nav-active' : ''}`} role="menuitem" data-haptic="selection" data-magnetic>Experience</a>
        <a href="/project/" class={`nav-link ${isActive('/project') ? 'nav-active' : ''}`} role="menuitem" data-haptic="selection" data-magnetic>Projects</a>
        <a href="/research/" class={`nav-link ${isActive('/research') ? 'nav-active' : ''}`} role="menuitem" data-haptic="selection" data-magnetic>Research</a>
        <a href="/forge/" class={`nav-link ${isActive('/forge') ? 'nav-active' : ''}`} role="menuitem" data-haptic="selection" data-magnetic>Forge</a>
        <a href="/blog/" class={`nav-link ${isActive('/blog') ? 'nav-active' : ''}`} role="menuitem" data-haptic="selection" data-magnetic>Writing</a>
        <a href="/art/" class={`nav-link ${isActive('/art') ? 'nav-active' : ''}`} role="menuitem" data-haptic="selection" data-magnetic>Art</a>
        <a href="/contact/" class={`nav-link ${isActive('/contact') ? 'nav-active' : ''}`} role="menuitem" data-haptic="selection" data-magnetic>Contact</a>
      </div>

      <!-- Mobile menu button -->
      <div class="md:hidden">
        <button
          id="mobile-menu-button"
          class="text-primary/30 transition-colors p-3 -mr-1"
          data-haptic="light"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Navigation -->
  <div id="mobile-menu" class="hidden md:hidden bg-black/30 backdrop-blur-md" role="menu" aria-label="Mobile navigation">
    <div class="sm:px-20 px-6 pt-2 pb-3 space-y-1">
      <a href="/" class={`mobile-nav-link ${isActive('/') ? 'nav-active' : ''}`} role="menuitem" data-haptic="selection">Home</a>
      <a href="/about/" class={`mobile-nav-link ${isActive('/about') ? 'nav-active' : ''}`} role="menuitem" data-haptic="selection">About</a>
      <a href="/experience/" class={`mobile-nav-link ${isActive('/experience') ? 'nav-active' : ''}`} role="menuitem" data-haptic="selection">Experience</a>
      <a href="/project/" class={`mobile-nav-link ${isActive('/project') ? 'nav-active' : ''}`} role="menuitem" data-haptic="selection">Projects</a>
      <a href="/research/" class={`mobile-nav-link ${isActive('/research') ? 'nav-active' : ''}`} role="menuitem" data-haptic="selection">Research</a>
      <a href="/forge/" class={`mobile-nav-link ${isActive('/forge') ? 'nav-active' : ''}`} role="menuitem" data-haptic="selection">Forge</a>
      <a href="/blog/" class={`mobile-nav-link ${isActive('/blog') ? 'nav-active' : ''}`} role="menuitem" data-haptic="selection">Writing</a>
      <a href="/art/" class={`mobile-nav-link ${isActive('/art') ? 'nav-active' : ''}`} role="menuitem" data-haptic="selection">Art</a>
      <a href="/contact/" class={`mobile-nav-link ${isActive('/contact') ? 'nav-active' : ''}`} role="menuitem" data-haptic="selection">Contact</a>
    </div>
  </div>
</nav>

<!-- Main content slot with proper spacing -->
<div class="pt-14">
  <slot />
</div>

<style>
  /* Gradient scrim behind the navbar — keeps links legible when 3D/particle
     content scrolls underneath without adding a visible "bar". */
  .nav-root::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 96px;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.55) 0%,
      rgba(0, 0, 0, 0.25) 55%,
      rgba(0, 0, 0, 0) 100%
    );
    pointer-events: none;
    z-index: -1;
  }

  .nav-link {
    @apply text-primary/30 transition-colors duration-300 text-xs font-mono tracking-wider;
    position: relative;
  }

  /* Hover colours only where a pointer can hover. iOS Safari emulates :hover
     as a sticky state on tap, so without the gate the link a user just tapped
     stays lit after the menu closes and reads as a second "active" item. The
     hamburger and the logo live here too, rather than as Tailwind hover:
     utilities in the markup, for the same reason: the button the user just
     tapped to close the menu would otherwise stay lit. */
  @media (hover: hover) {
    .nav-link:hover {
      @apply text-primary/70;
    }
    .mobile-nav-link:hover {
      @apply text-primary/80 bg-white/5;
    }
    .nav-logo:hover {
      @apply opacity-70;
    }
    #mobile-menu-button:hover {
      @apply text-primary/60;
    }
  }

  .nav-link.nav-active {
    @apply text-primary/70;
  }

  .nav-link.nav-active::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.6), rgba(255, 255, 255, 0.1));
  }

  /* py-3 + text-sm gives a 44px row, the minimum comfortable thumb target;
     the previous py-2/text-xs rows were 32px. transition-colors rather than
     transition-all so the row does not animate layout properties. */
  .mobile-nav-link {
    @apply block px-3 py-3 text-primary/40 transition-colors duration-300 text-sm font-mono tracking-wider;
  }

  .mobile-nav-link.nav-active {
    @apply text-primary/80;
  }

  /* Add slide animation for mobile menu */
  #mobile-menu {
    transition: transform 0.3s ease-in-out;
  }

  #mobile-menu.show {
    display: block;
    animation: slideDown 0.3s ease-out forwards;
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  import { onPageReady } from '../scripts/pageReady';
  // Mobile menu toggle with accessibility support.
  // Nav is transition:persist, so this astro:page-load handler fires on every
  // navigation against the SAME DOM nodes — an AbortController lets us drop
  // the previous navigation's listeners before adding new ones instead of
  // accumulating duplicates forever.
  let navAbort: AbortController | null = null;

  onPageReady(() => {
    navAbort?.abort();
    navAbort = new AbortController();
    const { signal } = navAbort;

    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');

    // The one place the menu is closed from: Escape, an outside tap, a link
    // tap, and the navigation itself (at the bottom) all go through here so
    // the three-statement dance cannot drift between call sites.
    const closeMenu = () => {
      if (!mobileMenu || mobileMenu.classList.contains('hidden')) return;
      mobileMenu.classList.add('hidden');
      mobileMenu.classList.remove('show');
      mobileMenuButton?.setAttribute('aria-expanded', 'false');
    };

    if (mobileMenuButton && mobileMenu) {
      mobileMenuButton.addEventListener('click', () => {
        const isExpanded = mobileMenuButton.getAttribute('aria-expanded') === 'true';
        mobileMenuButton.setAttribute('aria-expanded', (!isExpanded).toString());
        mobileMenu.classList.toggle('hidden');
        mobileMenu.classList.toggle('show');
      }, { signal });

      // Close menu on Escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !mobileMenu.classList.contains('hidden')) {
          closeMenu();
          mobileMenuButton.focus();
        }
      }, { signal });

      // Tapping anywhere outside the open menu closes it. pointerdown rather
      // than click because on iOS a tap on the page behind the menu is often
      // consumed as a scroll or a 3D-viewer gesture and never becomes a click,
      // which left the menu stuck open over the hero.
      document.addEventListener('pointerdown', (e) => {
        const target = e.target as Node | null;
        if (!target) return;
        if (mobileMenu.contains(target) || mobileMenuButton.contains(target)) return;
        closeMenu();
      }, { signal });

      // Tapping a link closes the menu immediately. Astro's page swap also
      // closes it (below), but on a hash link or the current page there is
      // no swap, and on a slow connection the menu otherwise stays open until
      // the new page arrives.
      mobileMenu.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) closeMenu();
      }, { signal });
    }

    // Update active nav state (needed since nav is persisted across transitions)
    const currentPath = window.location.pathname;
    const navLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-link, .mobile-nav-link');
    navLinks.forEach((link) => {
      const href = link.getAttribute('href') || '';
      const isActive = href === '/' ? currentPath === '/' : currentPath.startsWith(href);
      link.classList.toggle('nav-active', isActive);
    });

    // Close mobile menu on navigation
    closeMenu();
  });
</script>
