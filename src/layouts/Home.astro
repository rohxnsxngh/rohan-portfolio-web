---
import RobotModelViewer from "../components/RobotModelViewer.astro";
---

<div
  class="hero-section relative min-h-screen bg-secondary flex items-center justify-center overflow-hidden"
  id="hero-section"
  data-page="home"
>
  <!-- FULL PAGE ROBOT BACKGROUND -->
  <div class="robot-background-container absolute inset-0 z-[1]" id="robot-container">
    <div class="robot-frame-fullscreen w-full h-full">
      <div class="w-full h-full robot-viewer" id="robot-viewer">
        <RobotModelViewer />
      </div>
    </div>

    <!-- Dark overlay to dim robot heavily by default (almost invisible) -->
    <div class="robot-overlay absolute inset-0 bg-black/[0.85] pointer-events-none transition-all duration-500" id="robot-dim"></div>
  </div>

  <!-- Tech grid overlay for texture -->
  <div class="absolute inset-0 tech-grid opacity-10 z-[6] pointer-events-none"></div>

  <!-- Main content - layered on top with semi-transparent effect -->
  <div class="hero-content relative z-[10] w-full px-4 sm:px-6 lg:px-8 pointer-events-none transition-opacity duration-300" id="hero-content">
    <div class="max-w-7xl mx-auto">

      <!-- Small intro label -->
      <div class="label-intro mb-6 sm:mb-8">
        <span class="text-primary/50 font-mono text-xs sm:text-sm tracking-[0.3em] uppercase">
          Engineer • Builder • Creator
        </span>
      </div>

      <!-- MASSIVE name display -->
      <div class="name-display mb-6 sm:mb-10">
        <h1 class="hero-name font-mono font-black tracking-tighter leading-none select-none" transition:name="page-title" transition:animate="fade">
          <div class="name-line">
            <span class="char char-1">R</span><span class="char char-2">O</span><span class="char char-3">H</span><span class="char char-4">A</span><span class="char char-5">N</span>
          </div>
          <div class="name-line">
            <span class="char char-6">S</span><span class="char char-7">I</span><span class="char char-8">N</span><span class="char char-9">G</span><span class="char char-10">H</span>
          </div>
        </h1>
      </div>

      <!-- Bold statement -->
      <div class="statement mb-8 sm:mb-12 max-w-4xl">
        <p class="statement-text text-primary/60 font-mono tracking-wide leading-relaxed">
          Keep <span class="highlight">Building</span> 
        </p>
      </div>

      <!-- CTA Section -->
      <div class="cta-section flex flex-col sm:flex-row gap-4 sm:gap-6 items-start sm:items-center pointer-events-auto">
        <a
          href="/project"
          class="cta-primary group relative inline-flex items-center justify-center px-7 py-3 bg-primary text-secondary font-mono text-sm sm:text-base tracking-wider font-bold overflow-hidden transition-all duration-300 hover:scale-105 hover:shadow-2xl hover:shadow-primary/40"
          data-haptic="medium"
          data-magnetic
        >
          <span class="relative z-10">VIEW MY WORK</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5 ml-3 group-hover:translate-x-2 transition-transform relative z-10"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2.5"
              d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
          <div class="cta-shine"></div>
        </a>

        <a
          href="/about"
          class="cta-secondary group inline-flex items-center text-primary/70 hover:text-primary font-mono text-sm sm:text-base tracking-wider transition-all duration-300"
          data-haptic="light"
        >
          Learn more about me
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4 ml-2 group-hover:translate-x-1 transition-transform"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  /* ===== THEME: BOLD TECH MINIMALISM ===== */

  /* Tech grid background */
  .tech-grid {
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 100px 100px;
    animation: gridPan 60s linear infinite;
  }

  @keyframes gridPan {
    0% { background-position: 0 0; }
    100% { background-position: 100px 100px; }
  }

  /* Gradient overlay for depth */
  .gradient-overlay {
    background: radial-gradient(circle at 30% 50%, rgba(255, 255, 255, 0.03), transparent 50%);
  }

  /* ===== MASSIVE TYPOGRAPHY ===== */
  .hero-name {
    font-size: clamp(5rem, 22vw, 24rem);
    line-height: 0.8;
    letter-spacing: -0.1em;
    color: #ffffff;
    text-transform: uppercase;
    font-weight: 900;
    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.3);
  }

  .hero-name .name-line {
    display: block;
    position: relative;
  }

  /* Individual character animations - driven by GSAP */
  .hero-name .char {
    display: inline-block;
  }

  /* The hidden intro state is skipped on client-side navigations: the header
     carries transition:name="page-title" and is snapshotted for the morph
     before the intro animation runs, so it has to already be visible. A full
     page load still gets the staggered character reveal. */
  html:not(.spa-nav) .hero-name .char {
    opacity: 0;
    transform: translateY(100px) scale(0.8);
    text-shadow:
      0 0 40px rgba(255, 255, 255, 0.1),
      0 10px 30px rgba(0, 0, 0, 0.5);
  }

  /* Label intro - initial state for GSAP */
  .label-intro {
    opacity: 0;
    transform: translateY(-20px);
  }

  /* Statement text */
  .statement {
    opacity: 0;
    transform: translateY(30px);
  }

  .statement-text {
    font-size: clamp(1rem, 2.5vw, 1.5rem);
    line-height: 1.6;
  }

  .highlight {
    color: #ffffff;
    font-weight: 700;
    position: relative;
  }

  .highlight::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.5), transparent);
  }

  /* CTA Section - initial state for GSAP */
  .cta-section {
    opacity: 0;
    transform: translateY(30px);
  }

  /* Primary CTA Button */
  .cta-primary {
    position: relative;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
  }

  .cta-shine {
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
    transition: left 0.7s;
  }

  .cta-primary:hover .cta-shine {
    left: 100%;
  }

  /* Secondary CTA */
  .cta-secondary {
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.2);
    text-underline-offset: 6px;
    text-decoration-thickness: 1px;
  }

  .cta-secondary:hover {
    text-decoration-color: rgba(255, 255, 255, 0.6);
  }

  /* ===== ROBOT AS FULL BACKGROUND ===== */

  .robot-background-container {
    opacity: 1;
  }

  .robot-frame-fullscreen {
    position: absolute;
    inset: 0;
  }

  /* Robot overlay - dims the robot heavily, lightens on hover */
  .robot-overlay {
    z-index: 1;
    transition: background 0.6s ease-out;
  }

  /* Hero content with slower fade transitions for psychology */
  .hero-content {
    opacity: 1;
    transition: opacity 0.5s ease-out;
  }

  /* Typography with enhanced text shadow for better readability */
  .hero-name {
    text-shadow:
      0 3px 25px rgba(0, 0, 0, 0.9),
      0 6px 45px rgba(0, 0, 0, 0.7),
      0 0 80px rgba(0, 0, 0, 0.5);
  }

  .statement-text,
  .label-intro span {
    text-shadow:
      0 2px 15px rgba(0, 0, 0, 0.95),
      0 4px 25px rgba(0, 0, 0, 0.8);
  }

  /* Mouse interaction states - slower transitions */
  .hero-section.mouse-active .hero-content {
    opacity: 0.05;
    transition: opacity 0.6s ease-out;
  }

  .hero-section.mouse-active .robot-overlay {
    background: rgba(0, 0, 0, 0.2) !important;
  }

  /* When mouse becomes inactive, fade back slowly to let user admire */
  .hero-section:not(.mouse-active) .hero-content {
    transition: opacity 2s ease-in-out;
  }

  .hero-section:not(.mouse-active) .robot-overlay {
    transition: background 2.5s ease-in-out;
  }

  /* Scroll indicator */
  .scroll-indicator-minimal {
    opacity: 0;
  }

  @keyframes scroll-dot {
    0%, 100% {
      transform: translateY(0);
      opacity: 1;
    }
    50% {
      transform: translateY(12px);
      opacity: 0.5;
    }
  }

  .animate-scroll-dot {
    animation: scroll-dot 2s ease-in-out infinite;
  }

  /* ===== RESPONSIVE DESIGN ===== */

  @media (max-width: 1024px) {
    .hero-name {
      font-size: clamp(4.5rem, 20vw, 18rem);
      letter-spacing: -0.08em;
    }

    .robot-accent {
      width: 14rem;
      height: 14rem;
    }
  }

  @media (max-width: 768px) {
    .scroll-indicator-minimal {
      display: none !important;
    }

    .hero-name {
      font-size: clamp(4rem, 22vw, 14rem);
      letter-spacing: -0.06em;
    }

    .statement-text {
      font-size: clamp(0.9rem, 3vw, 1.25rem);
    }

    /* Less aggressive hover effect on tablet */
    .hero-section.mouse-active .hero-content {
      opacity: 0.08;
    }
  }

  @media (max-width: 640px) {
    .hero-name {
      font-size: clamp(3.5rem, 24vw, 11rem);
      letter-spacing: -0.04em;
    }

    .label-intro span {
      font-size: 0.65rem;
      letter-spacing: 0.2em;
    }

    .cta-primary {
      width: 100%;
    }

    /* Slightly more visible robot on mobile - but still dim */
    .robot-overlay {
      background: rgba(0, 0, 0, 0.88) !important;
    }

    /* Enable touch interaction on mobile */
    .hero-section.mouse-active .hero-content {
      opacity: 0.05;
    }

    .hero-section.mouse-active .robot-overlay {
      background: rgba(0, 0, 0, 0.2) !important;
    }
  }

  /* Prevent layout shift */
  .hero-section {
    min-height: 100vh;
    min-height: 100dvh; /* Dynamic viewport height for mobile */
  }
</style>

<script>
  import { onPageReady } from '../scripts/pageReady';
  import { addHeroCharIntro, createHeroParallax, createPageIntroTimeline } from '../scripts/animations';
  import { initKineticText } from '../scripts/kinetic-text';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  let kineticCleanup: (() => void) | null = null;
  let glowTween: gsap.core.Tween | null = null;
  let introTimeline: gsap.core.Timeline | null = null;
  let splitTimeline: gsap.core.Timeline | null = null;
  // Hoisted so astro:before-swap (via cleanupHomeAnimations) can clear a
  // pending hero-interaction timeout left over from navigating away mid-hover.
  let mouseTimeout: number | null = null;

  function cleanupHomeAnimations() {
    // Kill accumulated GSAP tweens on home elements to prevent stale inline styles
    const chars = document.querySelectorAll('.hero-name .char');
    const nameLines = document.querySelectorAll('.hero-name .name-line');
    if (chars.length) {
      gsap.killTweensOf(chars);
      gsap.set(chars, { clearProps: 'all' });
    }
    if (nameLines.length) {
      gsap.killTweensOf(nameLines);
      gsap.set(nameLines, { clearProps: 'all' });
    }
    gsap.killTweensOf('.label-intro');
    gsap.killTweensOf('.statement');
    gsap.killTweensOf('.cta-section');
    gsap.killTweensOf('.scroll-indicator-minimal');
    gsap.killTweensOf('#robot-dim');

    if (glowTween) { glowTween.kill(); glowTween = null; }
    if (introTimeline) { introTimeline.kill(); introTimeline = null; }
    if (splitTimeline) { splitTimeline.kill(); splitTimeline = null; }

    if (mouseTimeout) { clearTimeout(mouseTimeout); mouseTimeout = null; }

    kineticCleanup?.();
    kineticCleanup = null;
  }

  function initHomeAnimations() {
    // Clean up any leftover GSAP state from previous navigation
    cleanupHomeAnimations();

    // GSAP intro timeline
    introTimeline = createPageIntroTimeline();
    const tl = introTimeline;
    const isDesktop = window.matchMedia('(min-width: 768px)').matches;

    // Desktop only: rich GSAP intro. On mobile, CSS keyframes in Layout.astro
    // handle the intro instead — no per-element tween objects allocated.
    if (isDesktop) {
      // Label intro (fade in from above)
      tl.to('.label-intro', {
        opacity: 1,
        y: 0,
        duration: 0.8,
        ease: 'expo.out',
      }, 0);

      // Character reveal. Skipped on client-side navigations — the header is
      // being morphed between routes by the shared page-title view transition
      // instead, and re-animating it on arrival fought that morph.
      addHeroCharIntro(tl, document.querySelectorAll('.hero-name .char'), 0.1);

      // Statement
      tl.to('.statement', {
        opacity: 1,
        y: 0,
        duration: 1,
        ease: 'expo.out',
      }, 0.5);

      // CTA section
      tl.to('.cta-section', {
        opacity: 1,
        y: 0,
        duration: 1,
        ease: 'expo.out',
      }, 0.7);

      // Scroll indicator
      const scrollIndicator = document.querySelector('.scroll-indicator-minimal');
      if (scrollIndicator) {
        tl.to(scrollIndicator, {
          opacity: 1,
          duration: 1,
          ease: 'expo.out',
        }, 1.2);
      }
    }

    // Hero scroll-split effect — ROHAN slides left, SINGH slides right
    const nameLines = document.querySelectorAll('.hero-name .name-line');
    const heroSection = document.getElementById('hero-section');
    const robotOverlay = document.getElementById('robot-dim');

    if (nameLines.length >= 2 && heroSection && !window.matchMedia('(prefers-reduced-motion: reduce)').matches && window.matchMedia('(min-width: 768px)').matches) {
      const splitTl = splitTimeline = gsap.timeline({
        scrollTrigger: {
          trigger: heroSection,
          start: 'top top',
          end: 'bottom top',
          scrub: true,
        },
      });

      // ROHAN slides left
      splitTl.fromTo(nameLines[0], { x: 0, opacity: 1 }, { x: '-30vw', opacity: 0, ease: 'none' }, 0);
      // SINGH slides right
      splitTl.fromTo(nameLines[1], { x: 0, opacity: 1 }, { x: '30vw', opacity: 0, ease: 'none' }, 0);
      // Label, statement, CTA fade out faster
      splitTl.fromTo('.label-intro', { opacity: 1 }, { opacity: 0, ease: 'none' }, 0);
      splitTl.fromTo('.statement', { opacity: 1 }, { opacity: 0, ease: 'none', duration: 0.5 }, 0);
      splitTl.fromTo('.cta-section', { opacity: 1 }, { opacity: 0, ease: 'none', duration: 0.5 }, 0);
      // Robot overlay dims from 0.85 to 0.3
      if (robotOverlay) {
        splitTl.to(robotOverlay, { backgroundColor: 'rgba(0, 0, 0, 0.3)', ease: 'none' }, 0);
      }
    } else {
      // Fallback: standard hero parallax for reduced motion
      createHeroParallax('.hero-content');
    }

    // Continuous hero glow pulse — subtle living, breathing typography
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && window.matchMedia('(min-width: 768px)').matches) {
      tl.call(() => {
        const glowChars = document.querySelectorAll('.hero-name .char');
        if (glowChars.length) {
          glowTween = gsap.to(glowChars, {
            textShadow: '0 0 40px rgba(255, 255, 255, 0.3), 0 0 80px rgba(255, 255, 255, 0.1)',
            duration: 2,
            stagger: 0.15,
            yoyo: true,
            repeat: -1,
            ease: 'sine.inOut',
          });
        }
      });
    }

    // Kinetic text effect
    kineticCleanup = initKineticText('.hero-name');
  }

  function initHomeInteractions() {
    const heroSection = document.getElementById("hero-section");
    const robotContainer = document.getElementById("robot-container");

    let mouseActive = false;
    // Uses the module-level `mouseTimeout` so cleanupHomeAnimations() (run on
    // astro:before-swap) can clear a pending timer left over from navigating
    // away mid-hover, instead of it firing against a detached hero section.

    const handleInteraction = (clientX: number, clientY: number) => {
      const rect = heroSection!.getBoundingClientRect();
      const mouseX = (clientX - rect.left) / rect.width;
      const mouseY = (clientY - rect.top) / rect.height;

      if (!mouseActive) {
        heroSection!.classList.add('mouse-active');
        mouseActive = true;
      }

      if (mouseTimeout) clearTimeout(mouseTimeout);

      document.dispatchEvent(
        new CustomEvent("robotMouseMove", {
          detail: { x: mouseX, y: mouseY, clientX, clientY },
        })
      );

      mouseTimeout = window.setTimeout(() => {
        heroSection!.classList.remove('mouse-active');
        mouseActive = false;
        document.dispatchEvent(new CustomEvent("robotMouseInactive", { detail: { inactive: true } }));
      }, 800);
    };

    let touchStartY = 0;
    let touchStartX = 0;
    let isScrolling = false;
    const SCROLL_THRESHOLD = 10;

    if (heroSection && robotContainer) {
      heroSection.addEventListener("mousemove", (e) => handleInteraction(e.clientX, e.clientY));

      heroSection.addEventListener("touchstart", (e) => {
        if (e.touches.length > 0) {
          const touch = e.touches[0];
          touchStartX = touch.clientX;
          touchStartY = touch.clientY;
          isScrolling = false;
          handleInteraction(touch.clientX, touch.clientY);
        }
      }, { passive: true });

      heroSection.addEventListener("touchmove", (e) => {
        if (e.touches.length > 0) {
          const touch = e.touches[0];
          const deltaY = Math.abs(touch.clientY - touchStartY);
          const deltaX = Math.abs(touch.clientX - touchStartX);
          if (deltaY > SCROLL_THRESHOLD && deltaY > deltaX) isScrolling = true;
          if (!isScrolling) handleInteraction(touch.clientX, touch.clientY);
        }
      }, { passive: true });

      heroSection.addEventListener("touchend", () => {
        heroSection.classList.remove('mouse-active');
        mouseActive = false;
        isScrolling = false;
        if (mouseTimeout) { clearTimeout(mouseTimeout); mouseTimeout = null; }
        document.dispatchEvent(new CustomEvent("robotMouseLeave", { detail: { left: true } }));
      });

      heroSection.addEventListener("mouseleave", () => {
        heroSection.classList.remove('mouse-active');
        mouseActive = false;
        if (mouseTimeout) { clearTimeout(mouseTimeout); mouseTimeout = null; }
        document.dispatchEvent(new CustomEvent("robotMouseLeave", { detail: { left: true } }));
      });

      heroSection.addEventListener("mouseenter", () => {
        document.dispatchEvent(new CustomEvent("robotMouseEnter", { detail: { entered: true } }));
      });
    }

    const scrollIndicator = document.querySelector(".scroll-indicator-minimal");
    if (scrollIndicator) {
      scrollIndicator.addEventListener("click", () => {
        window.scrollTo({ top: window.innerHeight, behavior: "smooth" });
      });
    }
  }

  // Use astro:page-load for View Transitions compatibility
  // Guard: only run on the homepage
  onPageReady(() => {
    if (!document.querySelector('[data-page="home"]')) return;
    initHomeAnimations();
    initHomeInteractions();
  });

  // Full cleanup on navigation — kill all GSAP tweens, ScrollTriggers, kinetic text
  document.addEventListener('astro:before-swap', () => {
    cleanupHomeAnimations();
  });
</script>
