---
import Navbar from "../layouts/Navigation.astro";
import Footer from "../layouts/Footer.astro";
import Layout from "../layouts/Layout.astro";
import ObfuscatedEmail from "../components/ObfuscatedEmail.astro";
import ContactRobotViewer from "../components/ContactRobotViewer.astro";

// Static at build time. Nothing on this page reads request-time state, so it is
// served straight from the edge instead of invoking a function per request.
export const prerender = true;
---

<Layout title="Contact" description="Get in touch about engineering work, collaborations or anything you are building.">
  <Navbar>
    <!-- HERO SECTION - Full page robot background -->
    <div
      class="hero-section relative min-h-screen bg-secondary flex items-center justify-center overflow-hidden"
      id="hero-section"
    >
      <!-- FULL PAGE ROBOT BACKGROUND -->
      <div class="robot-background-container absolute inset-0 z-[1]" id="robot-container">
        <div class="robot-frame-fullscreen w-full h-full">
          <div class="w-full h-full robot-viewer" id="robot-viewer">
            <ContactRobotViewer />
          </div>
        </div>

        <!-- Dark overlay to dim robot by default -->
        <div class="robot-overlay absolute inset-0 bg-black/[0.85] pointer-events-none transition-all duration-500" id="robot-dim"></div>
      </div>

      <!-- Tech grid overlay for texture -->
      <div class="absolute inset-0 tech-grid opacity-10 z-[5] pointer-events-none"></div>

      <!-- Main content - layered on top -->
      <div class="hero-content relative z-10 w-full px-4 sm:px-6 lg:px-8 pointer-events-none transition-opacity duration-300" id="hero-content">
        <div class="max-w-7xl mx-auto">
          <!-- Small intro label -->
          <div class="label-intro mb-6 sm:mb-8">
            <span class="text-primary/50 font-mono text-xs sm:text-sm tracking-[0.3em] uppercase">
              Let's Connect
            </span>
          </div>

          <!-- MASSIVE title display -->
          <div class="name-display mb-6 sm:mb-10">
            <h1 class="contact-title font-mono font-black tracking-tighter leading-none select-none" transition:name="page-title" transition:animate="fade">
              <span class="char char-1">C</span><span class="char char-2">O</span><span class="char char-3">N</span><span class="char char-4">T</span><span class="char char-5">A</span><span class="char char-6">C</span><span class="char char-7">T</span>
            </h1>
          </div>

          <!-- Bold statement -->
          <div class="statement mb-8 sm:mb-12 max-w-4xl">
            <p class="statement-text text-primary/60 font-mono tracking-wide leading-relaxed">
              <span class="highlight">Have a project in mind?</span> Let's talk.
            </p>
          </div>

          <!-- CTA Section -->
          <div class="cta-section flex flex-col sm:flex-row gap-4 sm:gap-6 items-start sm:items-center pointer-events-auto">
            <a
              href="#contact-content"
              class="cta-primary group relative inline-flex items-center justify-center px-7 py-3 bg-primary text-secondary font-mono text-sm sm:text-base tracking-wider font-bold overflow-hidden transition-all duration-300 hover:scale-105 hover:shadow-2xl hover:shadow-primary/40"
              data-haptic="medium"
            >
              <span class="relative z-10">GET IN TOUCH</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5 ml-3 group-hover:translate-y-1 transition-transform relative z-10"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2.5"
                  d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
              </svg>
              <div class="cta-shine"></div>
            </a>

            <a
              href="/"
              class="cta-secondary group inline-flex items-center text-primary/70 hover:text-primary font-mono text-sm sm:text-base tracking-wider transition-all duration-300"
              data-haptic="light"
            >
              Back to home
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-4 w-4 ml-2 group-hover:-translate-x-1 transition-transform"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M7 16l-4-4m0 0l4-4m-4 4h18"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Scroll Indicator -->
      <div class="scroll-indicator absolute bottom-8 left-1/2 -translate-x-1/2 z-20 pointer-events-none">
        <div class="scroll-content flex flex-col items-center gap-2">
          <span class="text-primary/40 font-mono text-xs tracking-widest uppercase">Scroll</span>
          <div class="scroll-arrow">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary/40" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
          </div>
        </div>
      </div>
    </div>

    <!-- CONTACT FORM SECTION -->
    <div class="relative bg-secondary" id="contact-content">
      <!-- Tech grid overlay -->
      <div class="absolute inset-0 tech-grid opacity-10 z-0 pointer-events-none"></div>

      <!-- Main Content -->
      <div class="relative z-10 sm:px-20 px-6 py-16">
        <!-- Section Header -->
        <div class="header-section mb-12">
          <p class="intro-label font-mono text-xs sm:text-sm tracking-[0.3em] uppercase text-primary/50 mb-4">
            // GET IN TOUCH
          </p>
          <div class="accent-line"></div>
        </div>

            <!-- CONTACT FORM SECTION -->
            <div class="max-w-2xl">
              <!-- Intro Text -->
              <div class="intro-section mb-12">
                <p class="intro-text text-lg sm:text-xl text-primary/70 leading-relaxed">
                  Have a project in mind, want to collaborate, or just want to say hello?
                  Drop me a message and I'll get back to you as soon as possible.
                </p>
              </div>

              <!-- Contact Form -->
              <form id="contact-form" class="contact-form space-y-6">
                <!-- Name Field -->
                <div class="form-group">
                  <label for="name" class="form-label font-mono text-xs tracking-[0.2em] uppercase text-primary/50 mb-2 block">
                    Name
                  </label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    class="form-input w-full px-4 py-3 bg-black/50 border border-accent/20 rounded-lg text-primary placeholder-primary/30 focus:outline-none focus:border-primary/50 transition-all duration-300"
                    placeholder="Your name"
                  />
                </div>

                <!-- Email Field -->
                <div class="form-group">
                  <label for="email" class="form-label font-mono text-xs tracking-[0.2em] uppercase text-primary/50 mb-2 block">
                    Email
                  </label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    class="form-input w-full px-4 py-3 bg-black/50 border border-accent/20 rounded-lg text-primary placeholder-primary/30 focus:outline-none focus:border-primary/50 transition-all duration-300"
                    placeholder="your@email.com"
                  />
                </div>

                <!-- Subject Field -->
                <div class="form-group">
                  <label for="subject" class="form-label font-mono text-xs tracking-[0.2em] uppercase text-primary/50 mb-2 block">
                    Subject
                  </label>
                  <input
                    type="text"
                    id="subject"
                    name="subject"
                    required
                    class="form-input w-full px-4 py-3 bg-black/50 border border-accent/20 rounded-lg text-primary placeholder-primary/30 focus:outline-none focus:border-primary/50 transition-all duration-300"
                    placeholder="What's this about?"
                  />
                </div>

                <!-- Message Field -->
                <div class="form-group">
                  <label for="message" class="form-label font-mono text-xs tracking-[0.2em] uppercase text-primary/50 mb-2 block">
                    Message
                  </label>
                  <textarea
                    id="message"
                    name="message"
                    required
                    rows="6"
                    class="form-input w-full px-4 py-3 bg-black/50 border border-accent/20 rounded-lg text-primary placeholder-primary/30 focus:outline-none focus:border-primary/50 transition-all duration-300 resize-none"
                    placeholder="Your message..."
                  ></textarea>
                </div>

                <!-- Submit Button -->
                <div class="form-group pt-4">
                  <button
                    type="submit"
                    id="submit-btn"
                    class="submit-button group relative w-full sm:w-auto"
                    data-haptic="medium"
                  >
                    <span class="button-text relative z-10 inline-flex items-center justify-center">
                      SEND MESSAGE
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-5 w-5 ml-3 group-hover:translate-x-2 transition-transform"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2.5"
                          d="M13 7l5 5m0 0l-5 5m5-5H6"
                        />
                      </svg>
                    </span>
                    <span class="button-loading hidden relative z-10 inline-flex items-center justify-center">
                      <svg class="animate-spin h-5 w-5 mr-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                      </svg>
                      SENDING...
                    </span>
                    <div class="button-shine"></div>
                  </button>
                </div>

                <!-- Status Messages -->
                <div id="form-status" class="hidden">
                  <div id="success-message" class="hidden p-4 rounded-lg bg-green-500/10 border border-green-500/30 text-green-400">
                    <div class="flex items-center">
                      <svg class="h-5 w-5 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                      </svg>
                      <span>Message sent successfully! I'll get back to you soon.</span>
                    </div>
                  </div>
                  <div id="error-message" class="hidden p-4 rounded-lg bg-red-500/10 border border-red-500/30 text-red-400">
                    <div class="flex items-center">
                      <svg class="h-5 w-5 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                      </svg>
                      <span id="error-text">Something went wrong. Please try again.</span>
                    </div>
                  </div>
                </div>
              </form>

              <!-- Alternative Contact -->
              <div class="alt-contact mt-16 pt-8 border-t border-accent/10">
                <p class="text-center text-primary/50 font-mono text-sm mb-6">
                  Or reach out directly
                </p>
                <div class="flex flex-wrap justify-center gap-6">
                  <ObfuscatedEmail
                    email="rohan.singh.do@gmail.com"
                    class="contact-link group flex items-center text-primary/70 hover:text-primary transition-colors" data-haptic="selection"
                  >
                    <svg class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                    <span class="font-mono text-sm">Email</span>
                  </ObfuscatedEmail>
                  <a
                    href="https://www.linkedin.com/in/rohxnsxngh/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="contact-link group flex items-center text-primary/70 hover:text-primary transition-colors" data-haptic="selection"
                  >
                    <svg class="h-5 w-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                    </svg>
                    <span class="font-mono text-sm">LinkedIn</span>
                  </a>
                  <a
                    href="https://github.com/rohxnsxngh"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="contact-link group flex items-center text-primary/70 hover:text-primary transition-colors" data-haptic="selection"
                  >
                    <svg class="h-5 w-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                    </svg>
                    <span class="font-mono text-sm">GitHub</span>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </Navbar>
    <Footer />
</Layout>

<style>
  /* ===== HERO SECTION STYLES ===== */

  /* Tech grid background */
  .tech-grid {
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 100px 100px;
    animation: gridPan 60s linear infinite;
  }

  @keyframes gridPan {
    0% { background-position: 0 0; }
    100% { background-position: 100px 100px; }
  }

  /* Robot background */
  .robot-background-container {
    opacity: 1;
  }

  .robot-frame-fullscreen {
    position: absolute;
    inset: 0;
  }

  /* Overlay - dims the robot heavily, lightens on hover */
  .robot-overlay {
    z-index: 1;
    transition: background 0.6s ease-out;
  }

  /* Hero content transitions */
  .hero-content {
    opacity: 1;
    transition: opacity 0.5s ease-out;
  }

  /* Mouse interaction states */
  .hero-section.mouse-active .hero-content {
    opacity: 0.05;
    transition: opacity 0.6s ease-out;
  }

  .hero-section.mouse-active .robot-overlay {
    background: rgba(0, 0, 0, 0.2) !important;
  }

  .hero-section:not(.mouse-active) .hero-content {
    transition: opacity 2s ease-in-out;
  }

  .hero-section:not(.mouse-active) .robot-overlay {
    transition: background 2.5s ease-in-out;
  }

  /* Prevent layout shift */
  .hero-section {
    min-height: 100vh;
    min-height: 100dvh;
    min-height: 100dvh;
  }

  /* Label intro */
  .label-intro {
    opacity: 0;
    transform: translateY(-20px);
  }

  /* Statement text */
  .statement {
    opacity: 0;
    transform: translateY(30px);
  }

  .statement-text {
    font-size: clamp(1rem, 2.5vw, 1.5rem);
    line-height: 1.6;
  }

  .highlight {
    color: #ffffff;
    font-weight: 700;
    position: relative;
  }

  .highlight::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.5), transparent);
  }

  /* CTA Section */
  .cta-section {
    opacity: 0;
    transform: translateY(30px);
  }

  /* Primary CTA Button */
  .cta-primary {
    position: relative;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
  }

  .cta-shine {
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
    transition: left 0.7s;
  }

  .cta-primary:hover .cta-shine {
    left: 100%;
  }

  /* Secondary CTA */
  .cta-secondary {
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.2);
    text-underline-offset: 6px;
    text-decoration-thickness: 1px;
  }

  .cta-secondary:hover {
    text-decoration-color: rgba(255, 255, 255, 0.6);
  }

  /* Scroll indicator */
  .scroll-indicator {
    opacity: 0;
  }

  .scroll-arrow {
    animation: bounceDown 1.5s ease-in-out infinite;
  }

  @keyframes bounceDown {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(8px);
    }
  }

  @keyframes floatUpDown {
    0%, 100% {
      transform: translateX(-50%) translateY(0);
    }
    50% {
      transform: translateX(-50%) translateY(-5px);
    }
  }

  .hero-section.mouse-active .scroll-indicator {
    opacity: 0 !important;
    transition: opacity 0.3s ease-out;
  }

  /* ===== CONTACT TITLE ===== */
  .contact-title {
    font-size: clamp(2rem, 12vw, 14rem);
    line-height: 0.85;
    letter-spacing: -0.05em;
    color: #ffffff;
    text-transform: uppercase;
    font-weight: 900;
    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.3);
    white-space: nowrap;
    text-shadow:
      0 3px 25px rgba(0, 0, 0, 0.9),
      0 6px 45px rgba(0, 0, 0, 0.7);
  }

  /* Individual character initial state */
  .contact-title .char {
    display: inline-block;
  }

  /* The hidden intro state is skipped on client-side navigations: the header
     carries transition:name="page-title" and is snapshotted for the morph
     before the intro animation runs, so it has to already be visible. A full
     page load still gets the staggered character reveal. */
  html:not(.spa-nav) .contact-title .char {
    opacity: 0;
    transform: translateY(100px) scale(0.8);
  }

  /* Accent line */
  .accent-line {
    height: 3px;
    width: 0;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.8), transparent);
  }

  /* INTRO SECTION */
  .intro-section {
    opacity: 0;
    transform: translateY(30px);
  }

  /* CONTACT FORM */
  .contact-form {
    opacity: 0;
    transform: translateY(30px);
  }

  .form-group {
  }

  .form-input {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 1rem;
  }

  .form-input:focus {
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.1);
  }

  /* Submit Button */
  .submit-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem 2.5rem;
    background: rgba(255, 255, 255, 1);
    color: #000000;
    font-family: monospace;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    overflow: hidden;
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    border: none;
    cursor: pointer;
  }

  .submit-button:hover:not(:disabled) {
    transform: scale(1.02);
    box-shadow: 0 10px 40px rgba(255, 255, 255, 0.3);
  }

  .submit-button:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .button-shine {
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(0, 0, 0, 0.2), transparent);
    transition: left 0.7s;
  }

  .submit-button:hover:not(:disabled) .button-shine {
    left: 100%;
  }

  /* Alternative Contact Section */
  .alt-contact {
  }

  .contact-link {
    padding: 0.5rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.5rem;
    transition: all 0.3s ease;
  }

  .contact-link:hover {
    border-color: rgba(255, 255, 255, 0.3);
    background: rgba(255, 255, 255, 0.05);
  }

  /* RESPONSIVE */
  @media (max-width: 1024px) {
    .contact-title {
      font-size: clamp(2.5rem, 12vw, 10rem);
    }
  }

  @media (max-width: 768px) {
    .scroll-indicator {
      display: none !important;
    }

    .contact-title {
      font-size: clamp(2rem, 14vw, 8rem);
    }
  }

  @media (max-width: 640px) {
    .contact-title {
      font-size: clamp(1.8rem, 16vw, 6rem);
    }

    .submit-button {
      width: 100%;
    }
  }
</style>

<script>
  import { onPageReady } from '../scripts/pageReady';
  import { addHeroCharIntro, animateLineExpand, scrollReveal, createPageIntroTimeline } from '../scripts/animations';
  import { initKineticText } from '../scripts/kinetic-text';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { haptic } from "../scripts/haptics";

  gsap.registerPlugin(ScrollTrigger);

  let kineticCleanup: (() => void) | null = null;
  // Hoisted so astro:before-swap can clear a pending hero-interaction timeout
  // left over from navigating away mid-hover.
  let contactMouseTimeout: number | null = null;

  document.addEventListener('astro:before-swap', () => {
    if (contactMouseTimeout) {
      clearTimeout(contactMouseTimeout);
      contactMouseTimeout = null;
    }
  });

  onPageReady(() => {
    if (!document.querySelector('.contact-title')) return;

    if (kineticCleanup) { kineticCleanup(); kineticCleanup = null; }

    const tl = createPageIntroTimeline();
    const isDesktop = window.matchMedia('(min-width: 768px)').matches;

    // Desktop only: rich GSAP intro. On mobile, CSS keyframes in Layout.astro
    // handle the intro instead — no per-element tween objects allocated.
    if (isDesktop) {
      tl.to('.label-intro', { opacity: 1, y: 0, duration: 0.8, ease: 'expo.out' }, 0);
      // Skipped on client-side navigations — the header is being morphed
      // between routes by the shared page-title view transition instead.
      addHeroCharIntro(tl, document.querySelectorAll('.contact-title .char'), 0);
      tl.add(() => animateLineExpand('.accent-line'), 0.3);
      tl.to('.statement', { opacity: 1, y: 0, duration: 1, ease: 'expo.out' }, 0.5);
      tl.to('.cta-section', { opacity: 1, y: 0, duration: 1, ease: 'expo.out' }, 0.7);
      tl.to('.scroll-indicator', { opacity: 1, duration: 1, ease: 'expo.out' }, 1.0);
    }

    // Hero scroll-split effect
    const heroSection = document.getElementById('hero-section');
    const robotOverlay = document.getElementById('robot-dim');
    const allChars = Array.from(document.querySelectorAll('.contact-title .char'));
    const halfLen = Math.ceil(allChars.length / 2);
    const leftChars = allChars.slice(0, halfLen);
    const rightChars = allChars.slice(halfLen);

    if (leftChars.length && rightChars.length && heroSection && !window.matchMedia('(prefers-reduced-motion: reduce)').matches && isDesktop) {
      const splitTl = gsap.timeline({
        scrollTrigger: {
          trigger: heroSection,
          start: 'top top',
          end: 'bottom top',
          scrub: true,
        },
      });
      splitTl.fromTo(leftChars, { x: 0, opacity: 1 }, { x: '-30vw', opacity: 0, ease: 'none' }, 0);
      splitTl.fromTo(rightChars, { x: 0, opacity: 1 }, { x: '30vw', opacity: 0, ease: 'none' }, 0);
      splitTl.fromTo('.label-intro', { opacity: 1 }, { opacity: 0, ease: 'none' }, 0);
      splitTl.fromTo('.statement', { opacity: 1 }, { opacity: 0, ease: 'none', duration: 0.5 }, 0);
      splitTl.fromTo('.cta-section', { opacity: 1 }, { opacity: 0, ease: 'none', duration: 0.5 }, 0);
      if (robotOverlay) {
        splitTl.fromTo(robotOverlay, { backgroundColor: 'rgba(0, 0, 0, 0.85)' }, { backgroundColor: 'rgba(0, 0, 0, 0.3)', ease: 'none' }, 0);
      }
    }

    // Continuous glow pulse on hero chars
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && isDesktop) {
      tl.call(() => {
        const glowChars = document.querySelectorAll('.contact-title .char');
        if (glowChars.length) {
          gsap.to(glowChars, {
            textShadow: '0 0 40px rgba(255, 255, 255, 0.3), 0 0 80px rgba(255, 255, 255, 0.1)',
            duration: 2, stagger: 0.15, yoyo: true, repeat: -1, ease: 'sine.inOut',
          });
        }
      });
    }

    scrollReveal('.contact-form');
    scrollReveal('.alt-contact');

    kineticCleanup = initKineticText('.contact-title');

    const form = document.getElementById('contact-form') as HTMLFormElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const buttonText = submitBtn.querySelector('.button-text') as HTMLElement;
    const buttonLoading = submitBtn.querySelector('.button-loading') as HTMLElement;
    const formStatus = document.getElementById('form-status') as HTMLElement;
    const successMessage = document.getElementById('success-message') as HTMLElement;
    const errorMessage = document.getElementById('error-message') as HTMLElement;
    const errorText = document.getElementById('error-text') as HTMLElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Get form data
      const formData = new FormData(form);
      const data = {
        name: formData.get('name') as string,
        email: formData.get('email') as string,
        subject: formData.get('subject') as string,
        message: formData.get('message') as string,
      };

      // Validate
      if (!data.name || !data.email || !data.subject || !data.message) {
        showError('Please fill in all fields.');
        return;
      }

      // Show loading state
      submitBtn.disabled = true;
      buttonText.classList.add('hidden');
      buttonLoading.classList.remove('hidden');
      formStatus.classList.add('hidden');
      successMessage.classList.add('hidden');
      errorMessage.classList.add('hidden');

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(data),
        });

        const result = await response.json();

        if (response.ok) {
          // Success
          haptic('success');
          formStatus.classList.remove('hidden');
          successMessage.classList.remove('hidden');
          form.reset();
        } else {
          // Error from API
          haptic('error');
          showError(result.error || 'Something went wrong. Please try again.');
        }
      } catch (error) {
        // Network error
        haptic('error');
        showError('Network error. Please check your connection and try again.');
      } finally {
        // Reset button state
        submitBtn.disabled = false;
        buttonText.classList.remove('hidden');
        buttonLoading.classList.add('hidden');
      }
    });

    function showError(message: string) {
      formStatus.classList.remove('hidden');
      errorMessage.classList.remove('hidden');
      errorText.textContent = message;
    }

    // ===== HERO SECTION ROBOT INTERACTION =====
    const robotContainer = document.getElementById("robot-container");

    let mouseActive = false;
    let mouseTimeout: number | null = null;

    const handleInteraction = (clientX: number, clientY: number) => {
      const rect = heroSection!.getBoundingClientRect();

      const mouseX = (clientX - rect.left) / rect.width;
      const mouseY = (clientY - rect.top) / rect.height;

      if (!mouseActive) {
        heroSection!.classList.add('mouse-active');
        mouseActive = true;
      }

      if (mouseTimeout) {
        clearTimeout(mouseTimeout);
      }

      // Dispatch position to THREE.js robot viewer
      document.dispatchEvent(
        new CustomEvent("contactRobotMouseMove", {
          detail: {
            x: mouseX,
            y: mouseY,
            clientX: clientX,
            clientY: clientY
          },
        })
      );

      mouseTimeout = window.setTimeout(() => {
        heroSection!.classList.remove('mouse-active');
        mouseActive = false;

        document.dispatchEvent(
          new CustomEvent("contactRobotMouseInactive", {
            detail: { inactive: true },
          })
        );
      }, 800);
    };

    // Touch tracking for scroll vs interaction detection
    let touchStartY = 0;
    let touchStartX = 0;
    let isScrolling = false;
    const SCROLL_THRESHOLD = 10; // pixels of vertical movement to trigger scroll

    if (heroSection && robotContainer) {
      heroSection.addEventListener("mousemove", (e) => {
        handleInteraction(e.clientX, e.clientY);
      });

      heroSection.addEventListener("touchstart", (e) => {
        if (e.touches.length > 0) {
          const touch = e.touches[0];
          touchStartX = touch.clientX;
          touchStartY = touch.clientY;
          isScrolling = false;
          handleInteraction(touch.clientX, touch.clientY);
        }
      }, { passive: true });

      heroSection.addEventListener("touchmove", (e) => {
        if (e.touches.length > 0) {
          const touch = e.touches[0];
          const deltaY = Math.abs(touch.clientY - touchStartY);
          const deltaX = Math.abs(touch.clientX - touchStartX);

          // If vertical movement exceeds threshold and is greater than horizontal, allow scrolling
          if (deltaY > SCROLL_THRESHOLD && deltaY > deltaX) {
            isScrolling = true;
          }

          // Only trigger interaction effect, don't block scrolling
          if (!isScrolling) {
            handleInteraction(touch.clientX, touch.clientY);
          }
        }
      }, { passive: true });

      heroSection.addEventListener("touchend", () => {
        heroSection.classList.remove('mouse-active');
        mouseActive = false;
        isScrolling = false;

        if (mouseTimeout) {
          clearTimeout(mouseTimeout);
          mouseTimeout = null;
        }

        document.dispatchEvent(
          new CustomEvent("contactRobotMouseLeave", {
            detail: { left: true },
          })
        );
      });

      heroSection.addEventListener("mouseleave", () => {
        heroSection.classList.remove('mouse-active');
        mouseActive = false;

        if (mouseTimeout) {
          clearTimeout(mouseTimeout);
          mouseTimeout = null;
        }

        document.dispatchEvent(
          new CustomEvent("contactRobotMouseLeave", {
            detail: { left: true },
          })
        );
      });

      heroSection.addEventListener("mouseenter", () => {
        document.dispatchEvent(
          new CustomEvent("contactRobotMouseEnter", {
            detail: { entered: true },
          })
        );
      });
    }

  });
</script>
