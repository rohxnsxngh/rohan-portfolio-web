---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Navbar from "../layouts/Navigation.astro";
import Footer from "../layouts/Footer.astro";
import ArtParticleViewer from "../components/ArtParticleViewer.astro";

// Get all research with error handling
let allResearch: any[] = [];
try {
  allResearch = await getCollection("research");
} catch (error) {
  // Silently handle error - empty research array will be used
}

// Make sure we have valid research items
const validResearch = allResearch.filter(research =>
  research && research.data && research.data.title
);

// Sort research by status (completed first, then in-progress, then coming-soon)
const sortedResearch = [...validResearch].sort((a, b) => {
  const statusOrder = { 
    completed: 0, 
    "in-progress": 1, 
    "coming-soon": 2 
  };
  
  const statusA = a.data?.status || "completed";
  const statusB = b.data?.status || "completed";
  
  //@ts-ignore
  const statusCompare = statusOrder[statusA] - statusOrder[statusB];
  
  // If same status, sort by date (newest first)
  if (statusCompare === 0) {
    const dateA = new Date(a.data?.date || 0).getTime();
    const dateB = new Date(b.data?.date || 0).getTime();
    return dateB - dateA;
  }
  
  return statusCompare;
});

// Status colors and text
const statusColors = {
  completed: "bg-green-500/10 text-green-400",
  "in-progress": "bg-blue-500/10 text-blue-400",
  "coming-soon": "bg-purple-500/10 text-purple-400",
};

const statusText = {
  completed: "Completed",
  "in-progress": "In Progress",
  "coming-soon": "Coming Soon",
};
---

<Layout title="Research">
  <div class="min-h-screen flex flex-col bg-secondary">
    <div class="flex-grow">
      <Navbar>
        <!-- HERO SECTION WITH PARTICLE EFFECT -->
        <div class="hero-section relative min-h-screen bg-secondary flex items-center justify-center overflow-hidden" id="hero-section">
          <!-- Particle background with large distortion effect -->
          <ArtParticleViewer mouseRadius={6.0} />

          <!-- Dark overlay -->
          <div class="hero-overlay absolute inset-0 bg-black/70 pointer-events-none"></div>

          <!-- Hero content -->
          <div class="hero-content relative z-[10] w-full px-4 sm:px-6 lg:px-8 pointer-events-none transition-opacity duration-300">
            <div class="max-w-7xl mx-auto">
              <h1 class="hero-title font-mono font-black tracking-tighter leading-none select-none">
                <span class="char char-1">R</span><span class="char char-2">E</span><span class="char char-3">S</span><span class="char char-4">E</span><span class="char char-5">A</span><span class="char char-6">R</span><span class="char char-7">C</span><span class="char char-8">H</span>
              </h1>
              <p class="hero-subtitle font-mono text-primary/50 text-sm sm:text-base tracking-[0.3em] uppercase mt-6">
                // EXPLORING IDEAS
              </p>
              <p class="hero-description text-primary/60 max-w-xl mt-4">
                Academic research, experiments, and technical deep-dives
              </p>
            </div>
          </div>

          <!-- Scroll indicator -->
          <div class="scroll-indicator absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 animate-bounce z-20 pointer-events-none">
            <span class="text-primary/40 text-xs font-mono tracking-wider">SCROLL</span>
            <svg class="w-5 h-5 text-primary/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
            </svg>
          </div>
        </div>

        <div class="relative overflow-hidden">
          <!-- Tech grid overlay -->
          <div class="absolute inset-0 tech-grid opacity-10 z-0 pointer-events-none"></div>

          <div class="relative z-10 sm:px-20 px-6 py-12">
            <!-- Section header -->
            <div class="header-section mb-12">
              <h2 class="section-title font-mono font-bold text-2xl sm:text-3xl text-primary/90 mb-4">
                Research Projects
              </h2>
              <div class="accent-line"></div>
            </div>

      <!-- Grid layout matching blog page -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8" id="researchGrid">
        {sortedResearch.length > 0 ? (
          sortedResearch.map((research) => {
            try {
              // Default values for missing data
              const title = research.data?.title || "Untitled Research";
              const description = research.data?.description || "No description available";
              const status = research.data?.status || "completed";
              const date = research.data?.date || new Date().toISOString();
              const tags = Array.isArray(research.data?.tags) ? research.data.tags : [];
              const github = research.data?.github || "";
              const paper = research.data?.paper || "";

              // Use default color if status is not recognized
              //@ts-ignore
              const statusColor = statusColors[status] || "bg-gray-500/10 text-gray-400";

              //@ts-ignore
              const statusDisplay = statusText[status] || "Unknown";

              return (
                <a href={`/research/${research.slug}`} class="group h-full relative research-card" data-haptic="light">
                  <!-- Corner accent marks -->
                  <div class="card-corner-accent card-corner-tl"></div>
                  <div class="card-corner-accent card-corner-tr"></div>
                  <div class="card-corner-accent card-corner-bl"></div>
                  <div class="card-corner-accent card-corner-br"></div>

                  <!-- Animated gradient border -->
                  <div class="card-gradient-border"></div>

                  <!-- Grid overlay -->
                  <div class="card-grid-overlay"></div>

                  <!-- Glow overlay that follows mouse -->
                  <div class="glow-overlay"></div>

                  <div class="card-content p-6 border border-accent/20 rounded-xl bg-secondary hover:bg-accent/5 transition-all duration-300 transform hover:-translate-y-1 hover:shadow-xl h-full flex flex-col relative z-10">
                    <div class="flex flex-col h-full">
                      <div class="flex justify-between items-start mb-3">
                        <h2 class="text-xl font-bold group-hover:text-primary/90 transition-colors">{title}</h2>
                        <span class={`px-2 py-0.5 ml-2 rounded-full text-xs whitespace-nowrap flex-shrink-0 ${statusColor}`}>
                          {statusDisplay}
                        </span>
                      </div>
                      <p class="text-sm text-primary/60 mb-4">
                        {new Date(date).toLocaleDateString("en-US", {
                          year: "numeric",
                          month: "long",
                          day: "numeric"
                        })}
                      </p>
                      <p class="text-primary/80 flex-grow line-clamp-3">{description}</p>
                      <div class="mt-4 flex flex-wrap gap-2">
                        {tags.map((tag: unknown) => (
                          <span class="px-3 py-1 text-xs rounded-full bg-accent/10 text-primary/70">{tag}</span>
                        ))}
                      </div>
                      {(github || paper) && (
                        <div class="mt-4 pt-4 border-t border-accent/20 flex gap-4">
                          {github && (
                            <a
                              href={github}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="text-sm text-primary/80 hover:text-primary transition-colors"
                              onclick="arguments[0].stopPropagation()"
                            >
                              GitHub →
                            </a>
                          )}
                          {paper && (
                            <a
                              href={paper}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="text-sm text-primary/80 hover:text-primary transition-colors"
                              onclick="arguments[0].stopPropagation()"
                            >
                              Read Paper →
                            </a>
                          )}
                        </div>
                      )}
                    </div>
                  </div>
                </a>
              );
            } catch {
              return (
                <div class="bg-red-500/20 p-4 rounded-xl text-white">
                  Error rendering research item
                </div>
              );
            }
          })
        ) : (
          <div class="col-span-3 text-center py-8 bg-base-200/30 rounded-xl">
            <p class="text-white/80">No research found. Check your content collection.</p>
          </div>
        )}
      </div>
          </div>
        </div>
      </Navbar>
    </div>
    <Footer />
  </div>
</Layout>

<style>
  /* Tech grid background */
  .tech-grid {
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 100px 100px;
    animation: gridPan 60s linear infinite;
  }

  @keyframes gridPan {
    0% { background-position: 0 0; }
    100% { background-position: 100px 100px; }
  }

  /* HERO SECTION */
  .hero-section {
    position: relative;
    /* Removed fixed height to allow flex centering */
  }

  .hero-overlay {
    z-index: 5;
  }

  /* HERO TITLE - Large centered title */
  .hero-title {
    font-size: clamp(2.5rem, 11vw, 16rem);
    line-height: 0.85;
    letter-spacing: -0.06em;
    color: #ffffff;
    text-transform: uppercase;
    font-weight: 900;
    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.3);
    white-space: nowrap;
    text-shadow:
      0 3px 25px rgba(0, 0, 0, 0.9),
      0 6px 45px rgba(0, 0, 0, 0.7);
  }

  /* Character animations for hero */
  .hero-title .char {
    display: inline-block;
    opacity: 0;
    transform: translateY(100px) scale(0.8);
  }

  .hero-subtitle {
    opacity: 0;
    transform: translateY(30px);
  }

  .hero-description {
    opacity: 0;
    transform: translateY(30px);
  }

  /* Section title */
  .section-title {
    opacity: 0;
  }

  /* Accent line */
  .accent-line {
    height: 3px;
    width: 0;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.8), transparent);
  }

  /* Add Tailwind's line-clamp utility if not available in your Tailwind setup */
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Border animation styles */
  .research-card {
    transition: transform 0.3s ease-out;
    overflow: hidden;
  }

  .research-card:hover {
    transform: translateY(-4px);
  }

  /* Corner accent marks */
  .card-corner-accent {
    position: absolute;
    width: 20px;
    height: 20px;
    border: 2px solid rgba(255, 255, 255, 0.4);
    z-index: 15;
    pointer-events: none;
    transition: all 0.3s ease;
    opacity: 1;
  }

  .card-corner-tl {
    top: -1px;
    left: -1px;
    border-right: none;
    border-bottom: none;
    border-radius: 12px 0 0 0;
  }

  .card-corner-tr {
    top: -1px;
    right: -1px;
    border-left: none;
    border-bottom: none;
    border-radius: 0 12px 0 0;
  }

  .card-corner-bl {
    bottom: -1px;
    left: -1px;
    border-right: none;
    border-top: none;
    border-radius: 0 0 0 12px;
  }

  .card-corner-br {
    bottom: -1px;
    right: -1px;
    border-left: none;
    border-top: none;
    border-radius: 0 0 12px 0;
  }

  .research-card:hover .card-corner-accent {
    width: 30px;
    height: 30px;
    border-color: rgba(255, 255, 255, 0.8);
    filter: drop-shadow(0 0 8px rgba(255, 255, 255, 0.5));
  }

  /* Animated gradient border */
  .card-gradient-border {
    position: absolute;
    inset: -2px;
    border-radius: 0.75rem;
    padding: 2px;
    background: linear-gradient(
      45deg,
      transparent,
      rgba(0, 255, 255, 0.3),
      transparent,
      rgba(255, 0, 255, 0.3),
      transparent
    );
    background-size: 200% 200%;
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    animation: borderGlow 4s linear infinite;
    opacity: 0.6;
    pointer-events: none;
    z-index: 5;
  }

  @keyframes borderGlow {
    0%, 100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  .research-card:hover .card-gradient-border {
    opacity: 1;
    animation-duration: 2s;
  }

  /* Grid overlay */
  .card-grid-overlay {
    position: absolute;
    inset: 0;
    border-radius: 0.75rem;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 20px 20px;
    pointer-events: none;
    z-index: 11;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .research-card:hover .card-grid-overlay {
    opacity: 1;
  }

  /* Mouse-following glow effect */
  .glow-overlay {
    position: absolute;
    inset: 0;
    border-radius: 0.75rem;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
    z-index: 50;
    background: radial-gradient(
      600px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
      rgba(255, 102, 0, 0.2),
      rgba(255, 170, 68, 0.15),
      rgba(255, 68, 68, 0.08),
      transparent 40%
    );
    mix-blend-mode: screen;
    will-change: opacity;
  }

  .research-card:hover .glow-overlay {
    opacity: 1;
  }

  /* Enhanced card content hover with cyan/magenta glow */
  .card-content {
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05), 0 10px 30px rgba(0, 0, 0, 0.5);
  }

  .research-card:hover .card-content {
    border-color: rgba(255, 255, 255, 0.3);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.1),
      0 20px 40px rgba(0, 0, 0, 0.6),
      0 0 40px rgba(0, 255, 255, 0.1),
      0 0 80px rgba(255, 0, 255, 0.1);
  }

  /* Responsive corner accents for smaller screens */
  @media (max-width: 640px) {
    .card-corner-accent {
      width: 15px;
      height: 15px;
    }

    .research-card:hover .card-corner-accent {
      width: 20px;
      height: 20px;
    }
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .hero-title {
      font-size: clamp(2.5rem, 10vw, 10rem);
    }
  }

  @media (max-width: 768px) {
    .scroll-indicator {
      display: none !important;
    }

    .hero-title {
      font-size: clamp(2rem, 12vw, 8rem);
    }
  }

  @media (max-width: 640px) {
    .hero-title {
      font-size: clamp(1.8rem, 14vw, 6rem);
    }
  }
</style>

<script>
import { animateLineExpand, batchScrollReveal, createPageIntroTimeline } from '../scripts/animations';
import gsap from 'gsap';

document.addEventListener('astro:page-load', () => {
    if (!document.querySelector('.research-card')) return;

    const tl = createPageIntroTimeline();
    const chars = document.querySelectorAll('.hero-title .char');
    if (chars.length) {
      gsap.set(chars, { opacity: 0, y: 100, scale: 0.8 });
      tl.to(chars, { opacity: 1, y: 0, scale: 1, duration: 1, stagger: 0.05, ease: 'expo.out' }, 0);
    }
    tl.add(() => animateLineExpand('.accent-line'), 0.3);
    tl.to('.hero-subtitle', { opacity: 1, y: 0, duration: 1, ease: 'expo.out' }, 0.5);
    tl.to('.hero-description', { opacity: 1, y: 0, duration: 1, ease: 'expo.out' }, 0.7);
    batchScrollReveal('.research-card');
});

document.addEventListener('astro:page-load', () => {
  if (!document.querySelector('.research-card')) return;
  // ===== HERO SECTION PARTICLE DISTORTION =====
  const heroSection = document.getElementById('hero-section');
  let mouseTimeout: number | null = null;

  // Touch tracking for scroll vs interaction detection
  let touchStartY = 0;
  let touchStartX = 0;
  let isScrolling = false;
  const SCROLL_THRESHOLD = 10;

  if (heroSection) {
    // Track mouse movement over hero section
    heroSection.addEventListener('mousemove', (e) => {
      const rect = heroSection.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width;
      const y = (e.clientY - rect.top) / rect.height;

      // Dispatch event for particle distortion
      document.dispatchEvent(new CustomEvent('researchMouseMove', {
        detail: { x, y, clientX: e.clientX, clientY: e.clientY }
      }));

      // Clear existing timeout
      if (mouseTimeout) clearTimeout(mouseTimeout);

      // Set inactive after delay
      mouseTimeout = window.setTimeout(() => {
        document.dispatchEvent(new CustomEvent('researchMouseInactive'));
      }, 800);
    });

    heroSection.addEventListener('mouseleave', () => {
      document.dispatchEvent(new CustomEvent('researchMouseLeave'));
    });

    // Touch support - allow scrolling
    heroSection.addEventListener('touchstart', (e) => {
      if (e.touches.length > 0) {
        const touch = e.touches[0];
        touchStartX = touch.clientX;
        touchStartY = touch.clientY;
        isScrolling = false;
      }
    }, { passive: true });

    heroSection.addEventListener('touchmove', (e) => {
      if (e.touches.length > 0) {
        const touch = e.touches[0];
        const deltaY = Math.abs(touch.clientY - touchStartY);
        const deltaX = Math.abs(touch.clientX - touchStartX);

        if (deltaY > SCROLL_THRESHOLD && deltaY > deltaX) {
          isScrolling = true;
        }

        if (!isScrolling) {
          const rect = heroSection.getBoundingClientRect();
          const x = (touch.clientX - rect.left) / rect.width;
          const y = (touch.clientY - rect.top) / rect.height;

          document.dispatchEvent(new CustomEvent('researchMouseMove', {
            detail: { x, y, clientX: touch.clientX, clientY: touch.clientY }
          }));
        }
      }
    }, { passive: true });

    heroSection.addEventListener('touchend', () => {
      isScrolling = false;
      document.dispatchEvent(new CustomEvent('researchMouseLeave'));
    });
  }

  // ===== RESEARCH CARDS GLOW EFFECT =====
  const researchCards = document.querySelectorAll('.research-card');

  researchCards.forEach((card) => {
    const glowOverlay = card.querySelector<HTMLElement>('.glow-overlay');
    if (!glowOverlay) return;

    card.addEventListener('mousemove', (e) => {
      const mouseEvent = e as MouseEvent;
      const rect = card.getBoundingClientRect();
      const x = ((mouseEvent.clientX - rect.left) / rect.width) * 100;
      const y = ((mouseEvent.clientY - rect.top) / rect.height) * 100;

      glowOverlay.style.setProperty('--mouse-x', `${x}%`);
      glowOverlay.style.setProperty('--mouse-y', `${y}%`);
    });

    card.addEventListener('mouseleave', () => {
      glowOverlay.style.setProperty('--mouse-x', '50%');
      glowOverlay.style.setProperty('--mouse-y', '50%');
    });
  });
});
</script>