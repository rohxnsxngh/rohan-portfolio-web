      0 0 80px rgba(255, 102, 0, 0.15);
  }

  .experience-card[data-company^="quaternion"]:hover .card-content {
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.1),
      0 20px 40px rgba(0, 0, 0, 0.6),
      0 0 40px rgba(100, 200, 255, 0.2),
      0 0 80px rgba(100, 200, 255, 0.1);
  }

  .experience-card[data-company^="boston"]:hover .card-content {
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.1),
      0 20px 40px rgba(0, 0, 0, 0.6),
      0 0 40px rgba(150, 255, 150, 0.2),
      0 0 80px rgba(150, 255, 150, 0.1);
  }

  /* Responsive corner accents for smaller screens */
  @media (max-width: 640px) {
    .card-corner-accent {
      width: 15px;
      height: 15px;
    }

    .experience-card:hover .card-corner-accent {
      width: 20px;
      height: 20px;
    }
  }

  /* Accent bar */
  .accent-bar {
    background: currentColor;
  }

  /* Subtle glow on hover */
  .experience-card:hover .card-glow {
    opacity: 1;
  }

  /* Company badge */
  .company-badge {
    background: rgba(0, 0, 0, 0.3);
    transition: all 0.3s ease;
  }

  .experience-card:hover .company-badge {
    background: rgba(0, 0, 0, 0.5);
  }

  /* Timeline container */
  #experience-timeline {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .cards-container {
    width: 100%;
    max-width: 100%;
    overflow: hidden;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .experience-title {
      font-size: clamp(2.5rem, 10vw, 10rem);
    }
  }

  @media (max-width: 768px) {
    .scroll-indicator {
      display: none !important;
    }

    .experience-title {
      font-size: clamp(2rem, 12vw, 8rem);
    }

    .card-content {
      padding: 1.5rem;
    }

    /* Fix text overflow on tablet */
    .card-content h2 {
      word-wrap: break-word;
      overflow-wrap: break-word;
      hyphens: auto;
    }

    .card-content p {
      word-wrap: break-word;
      overflow-wrap: break-word;
    }

    .company-badge {
      font-size: 0.75rem;
      padding: 0.375rem 0.75rem;
    }
  }

  @media (max-width: 640px) {
    .experience-title {
      font-size: clamp(1.8rem, 14vw, 6rem);
    }

    /* Ensure page wrapper doesn't overflow */
    body {
      overflow-x: hidden;
    }

    #experience-timeline {
      padding: 0;
      margin: 0;
      overflow-x: hidden;
    }

    .cards-container {
      padding: 0;
      margin: 0;
    }

    .experience-card {
      margin: 0 0 2rem 0;
      width: 100%;
      max-width: 100%;
    }

    .card-content {
      padding: 1rem;
      width: 100%;
      max-width: 100%;
      box-sizing: border-box;
    }

    /* Fix all text elements */
    .card-content * {
      word-wrap: break-word;
      overflow-wrap: break-word;
      max-width: 100%;
      box-sizing: border-box;
    }

    /* REDESIGNED MOBILE FRONTMATTER */

    /* Header - Complete redesign for mobile */
    .card-content > div:first-child {
      flex-direction: column-reverse !important;
      align-items: flex-start !important;
      gap: 0;
      width: 100%;
      margin-bottom: 1rem;
    }

    /* Company badge - make it the top element, more prominent. Stacked above
       the title so a long employer name gets the card's full width. */
    .card-header {
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: 0;
    }

    .company-badge {
      font-size: 0.625rem !important;
      font-weight: 600 !important;
      padding: 0.375rem 0.75rem;
      white-space: normal;
      max-width: 100%;
      position: static;
      margin-bottom: 0.75rem;
      /* Logo and name on one row, the divider below spanning both columns */
      display: inline-grid;
      grid-template-columns: auto 1fr;
      align-items: center;
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }

    /* Title section wrapper */
    .card-content > div:first-child > div:first-child {
      width: 100%;
      order: 2;
    }

    /* Job title - larger, more readable */
    .card-content h2 {
      font-size: 1.375rem !important;
      line-height: 1.35;
      margin-bottom: 0.5rem;
      padding-right: 0;
      font-weight: 700;
    }

    /* Date - subtle, below title */
    .card-content .text-xs {
      font-size: 0.625rem !important;
      opacity: 0.6;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    /* Description paragraph */
    .card-content > p {
      font-size: 0.9375rem !important;
      line-height: 1.65;
      margin-bottom: 1rem;
      max-width: 100%;
      width: 100%;
      overflow-wrap: break-word;
      word-break: break-word;
      color: rgba(255, 255, 255, 0.75);
    }

    /* Tags section - more compact */
    .card-content > div:nth-child(3) {
      gap: 0.375rem !important;
      margin-bottom: 1rem;
    }

    .card-content > div:nth-child(3) span {
      font-size: 0.625rem !important;
      padding: 0.3rem 0.6rem;
      letter-spacing: 0.03em;
    }

    /* Call to action - slightly larger for easier tapping */
    .card-content > div:last-child {
      font-size: 0.8125rem !important;
      padding-top: 0.25rem;
    }

    .card-content > div:last-child span {
      font-weight: 600;
    }

    .card-content > div:last-child svg {
      width: 1rem;
      height: 1rem;
    }

    /* Add subtle divider after company badge */
    .company-badge::after {
      content: '';
      display: block;
      grid-column: 1 / -1;
      height: 2px;
      /* Full row under the logo and name; the line itself stays 40px */
      background: linear-gradient(currentColor, currentColor) left / 40px 100% no-repeat;
      opacity: 0.3;
      margin-top: 0.75rem;
    }
  }
</style>

<script>
  import { onPageReady } from '../scripts/pageReady';
  import { DURATION, EASE } from '../scripts/motion';
  import { addHeroCharIntro, batchScrollReveal, scrollReveal, createPageIntroTimeline, initHeroGlow, bindPointerGlow } from '../scripts/animations';
  import { getLenis } from '../scripts/smooth-scroll';
  import { initKineticText } from '../scripts/kinetic-text';
  import { shouldSkipHeavy3D } from '../scripts/heavy3d';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  let kineticCleanup: (() => void) | null = null;
  // Scopes card/journey listeners and the glow-sweep RAF loops so they're torn
  // down on every navigation instead of accumulating (the RAF loop in
  // particular never self-terminates, so it would otherwise keep the whole
  // previous visit's card DOM alive forever).
  let experienceAbort: AbortController | null = null;
  let experienceRafCancellers: (() => void)[] = [];
  let experienceMouseTimeout: number | null = null;

  document.addEventListener('astro:before-swap', () => {
    experienceAbort?.abort();
    experienceAbort = null;
    experienceRafCancellers.forEach((cancel) => cancel());
    experienceRafCancellers = [];
    if (experienceMouseTimeout) {
      clearTimeout(experienceMouseTimeout);
      experienceMouseTimeout = null;
    }
  });

  onPageReady(() => {
    if (!document.querySelector('.experience-title')) return;

    if (kineticCleanup) { kineticCleanup(); kineticCleanup = null; }

    // GSAP intro timeline
    const tl = createPageIntroTimeline();
    const isDesktop = window.matchMedia('(min-width: 768px)').matches;

    // Desktop only: rich GSAP intro. On mobile, CSS keyframes in Layout.astro
    // handle the intro instead — no per-element tween objects allocated.
    if (isDesktop) {
      // Skipped on client-side navigations — the header is being morphed
      // between routes by the shared page-title view transition instead.
      addHeroCharIntro(tl, document.querySelectorAll('.experience-title .char'), 0);

      // Hero subtitle and description
      tl.to('.hero-subtitle', { opacity: 1, y: 0, duration: DURATION.page, ease: EASE.enter }, 0.35);
      tl.to('.hero-description', { opacity: 1, y: 0, duration: DURATION.page, ease: EASE.enter }, 0.45);
      tl.to('.scroll-indicator', { opacity: 1, duration: DURATION.page, ease: EASE.enter }, 0.6);
    }

    // Hero scroll-split effect
    const heroSection = document.getElementById('hero-section');
    const heroOverlay = document.querySelector('.hero-overlay') as HTMLElement;
    const allChars = Array.from(document.querySelectorAll('.experience-title .char'));
    const halfLen = Math.ceil(allChars.length / 2);
    const leftChars = allChars.slice(0, halfLen);
    const rightChars = allChars.slice(halfLen);

    if (leftChars.length && rightChars.length && heroSection && !window.matchMedia('(prefers-reduced-motion: reduce)').matches && window.matchMedia('(min-width: 768px)').matches) {
      const splitTl = gsap.timeline({
        scrollTrigger: {
          trigger: heroSection,
          start: 'top top',
          end: 'bottom top',
          scrub: true,
        },
      });
      splitTl.fromTo(leftChars, { x: 0, opacity: 1 }, { x: '-30vw', opacity: 0, ease: 'none' }, 0);
      splitTl.fromTo(rightChars, { x: 0, opacity: 1 }, { x: '30vw', opacity: 0, ease: 'none' }, 0);
      splitTl.fromTo('.hero-subtitle', { opacity: 1 }, { opacity: 0, ease: 'none' }, 0);
      splitTl.fromTo('.hero-description', { opacity: 1 }, { opacity: 0, ease: 'none', duration: 0.5 }, 0);
      splitTl.fromTo('.scroll-indicator', { opacity: 1 }, { opacity: 0, ease: 'none', duration: 0.3 }, 0);
      if (heroOverlay) {
        splitTl.fromTo(heroOverlay, { opacity: 0.7 }, { opacity: 0.2, ease: 'none' }, 0);
      }
    }

    // Continuous glow pulse on hero chars. Composited opacity on a glow copy
    // of each char, paused while the hero is off screen (see initHeroGlow).
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && window.matchMedia('(min-width: 768px)').matches) {
      tl.call(() => {
        initHeroGlow(document.querySelectorAll('.experience-title .char'), document.getElementById('hero-section'));
      });
    }

    // Reveal the journey section via scroll
    scrollReveal('.journey-section');

    // Batch scroll reveal for journey cards
    batchScrollReveal('.journey-card-wrapper');

    // 3D tilt card reveals for experience cards — alternating directions
    const experienceCards = document.querySelectorAll('.experience-card');
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (experienceCards.length && !prefersReduced) {
      experienceCards.forEach((card, i) => {
        const fromLeft = i % 2 === 0;
        gsap.set(card, {
          opacity: 0,
          x: fromLeft ? -60 : 60,
          rotateY: fromLeft ? 3 : -3,
          transformPerspective: 1000,
        });

        // y as well: GSAP adopts the CSS resting translateY(30px) as y when it
        // first writes the transform, and without this the card stayed 30px low.
        gsap.to(card, {
          opacity: 1,
          x: 0,
          y: 0,
          rotateY: 0,
          duration: 0.8,
          ease: 'expo.out',
          scrollTrigger: {
            trigger: card,
            start: 'top 85%',
            toggleActions: 'play none none none',
          },
        });
      });
    } else {
      batchScrollReveal('.experience-card');
    }

    kineticCleanup = initKineticText('.experience-title');
  });

  /**
   * Scrolls to the experience card for `slug` and gives it a brief pulse.
   *
   * Goes through Lenis when it is running: a native smooth scrollTo while
   * Lenis owns the wheel meant two smooth scrolls fighting over one page. The
   * pulse is a GSAP scale tween rather than an inline `transform`, which
   * overwrote the x/rotateY GSAP had left on the card and made it snap.
   */
  function scrollToExperienceCard(slug: string) {
    const card = document.querySelector<HTMLElement>(
      `.experience-card[data-slug="${CSS.escape(slug)}"]`
    );
    if (!card) return;

    const offset = -100; // Clears the fixed header
    const lenis = getLenis();
    if (lenis) {
      lenis.scrollTo(card, { offset });
    } else {
      const y = card.getBoundingClientRect().top + window.scrollY + offset;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: y, behavior: reduce ? 'auto' : 'smooth' });
    }

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      gsap.fromTo(card, { scale: 1.02 }, { scale: 1, duration: DURATION.card, ease: EASE.enter, overwrite: 'auto' });
    }
  }

  onPageReady(() => {
    if (!document.querySelector('.experience-title')) return;

    experienceAbort?.abort();
    experienceAbort = new AbortController();
    const { signal } = experienceAbort;

    // Pointer-following glows. Each caches its host's rect per hover and
    // batches its writes into one frame (see bindPointerGlow).
    document.querySelectorAll<HTMLElement>('.experience-card').forEach((cardEl) => {
      const cardContent = cardEl.querySelector<HTMLElement>('.card-content');
      const glow = cardEl.querySelector<HTMLElement>('.card-glow');
      const glowOverlayWarm = cardEl.querySelector<HTMLElement>('.glow-overlay-warm');

      if (cardContent && glow) bindPointerGlow(cardContent, glow, { unit: 'px', signal });
      if (glowOverlayWarm) bindPointerGlow(cardEl, glowOverlayWarm, { signal });
    });

    // Journey cards. One binding per wrapper: the wrapper and the card inside
    // it used to both track the pointer into the same overlay.
    const wrappers = Array.from(document.querySelectorAll<HTMLElement>('.journey-card-wrapper'));

    wrappers.forEach((wrapperEl) => {
      const glowOverlay = wrapperEl.querySelector<HTMLElement>('.journey-glow-overlay');
      if (glowOverlay) bindPointerGlow(wrapperEl, glowOverlay, { signal });

      // Keyed by slug: two wrappers are Tesla, and keying by company sent
      // the 2022 card to the 2023 one.
      wrapperEl.addEventListener('click', () => {
        const slug = wrapperEl.dataset.slug;
        if (slug) scrollToExperienceCard(slug);
      }, { signal });
    });

    // The auto-hover cascade. Each wrapper's slot in the cycle is spread
    // evenly across however many cards exist, and handed to the CSS keyframes
    // through --journey-delay. The old hard-coded seven-entry table had no
    // slot for the eighth card, which got NaN and never swept.
    const cycleDuration = 15000; // ms, matches the 15s keyframes
    const delays = wrappers.map((_, i) => (i * cycleDuration) / wrappers.length);
    wrappers.forEach((wrapperEl, i) => {
      wrapperEl.style.setProperty('--journey-delay', `${delays[i]}ms`);
    });

    // The glow sweep mirrors that CSS cycle, which only exists under
    // (hover: hover) and (min-width: 1024px); everywhere else the overlay
    // stays at opacity 0, so nothing would see the sweep.
    const runsGlowSweep =
      window.matchMedia('(hover: hover) and (min-width: 1024px)').matches &&
      !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const grid = document.querySelector<HTMLElement>('.journey-cards-grid');
    if (!runsGlowSweep || !grid || !wrappers.length) return;

    // The glow is visible for the first 20% of each card's slot (the
    // glowFadeIn keyframes fade in by 5% and out by 20%); the sweep spans that
    // whole window so it is still travelling while the glow fades.
    const sweepDuration = cycleDuration * 0.2;
    // 30 fps is plenty for a soft radial gradient drifting 100% in 3s.
    const FRAME_MS = 1000 / 30;

    const overlays = wrappers.map((w) => w.querySelector<HTMLElement>('.journey-glow-overlay'));
    const hovering = wrappers.map(() => false);
    const lastX = wrappers.map(() => -1);
    wrappers.forEach((wrapperEl, i) => {
      wrapperEl.addEventListener('mouseenter', () => { hovering[i] = true; }, { signal });
      wrapperEl.addEventListener('mouseleave', () => { hovering[i] = false; lastX[i] = -1; }, { signal });
    });

    // Each card's clock is its own glowFadeIn animation, when the browser
    // exposes it, so the sweep stays locked to the fade the keyframes are
    // showing through hover pauses and the off-screen pause below. Page time
    // is the fallback.
    const clocks = overlays.map((o) =>
      o?.getAnimations?.().find((a) => (a as CSSAnimation).animationName === 'glowFadeIn') ?? null
    );
    const startedAt = performance.now();
    const elapsed = (i: number) => {
      const t = clocks[i]?.currentTime;
      return typeof t === 'number' ? t : performance.now() - startedAt;
    };

    let rafId = 0;
    let lastFrame = 0;
    let running = false;

    const tick = (frameTime: number) => {
      rafId = requestAnimationFrame(tick);
      if (frameTime - lastFrame < FRAME_MS) return;
      lastFrame = frameTime;

      for (let i = 0; i < wrappers.length; i++) {
        const overlay = overlays[i];
        if (!overlay || hovering[i]) continue;
        const local = (((elapsed(i) - delays[i]) % cycleDuration) + cycleDuration) % cycleDuration;
        if (local > sweepDuration) continue;
        const x = Math.round((local / sweepDuration) * 1000) / 10;
        if (x === lastX[i]) continue;
        lastX[i] = x;
        overlay.style.setProperty('--mouse-x', `${x}%`);
        overlay.style.setProperty('--mouse-y', '50%');
      }
    };

    const start = () => {
      if (running) return;
      running = true;
      lastFrame = 0;
      rafId = requestAnimationFrame(tick);
    };
    const stop = () => {
      running = false;
      cancelAnimationFrame(rafId);
    };

    // The loop, and the CSS cascade with it, only runs while the grid is on
    // screen. The old version ran seven rAF loops for the life of the page.
    const observer = new IntersectionObserver((entries) => {
      const visible = entries[entries.length - 1].isIntersecting;
      grid.classList.toggle('is-offscreen', !visible);
      if (visible) start(); else stop();
    });
    observer.observe(grid);

    experienceRafCancellers.push(() => {
      stop();
      observer.disconnect();
    });
  });

  // Hero section particle interaction
  onPageReady(() => {
    const heroSection = document.getElementById('hero-section');
    if (!heroSection || !document.querySelector('.experience-title')) return;

    // The only listener for these events is the particle viewer, which does
    // not start where heavy 3D is skipped, so there is nothing to relay to.
    if (shouldSkipHeavy3D()) return;

    // Reuses the same abort controller/timeout slot as the cards handler above
    // (both gate on the same '.experience-title' guard, so it's always fresh here).
    const signal = experienceAbort!.signal;
    let touchStartY = 0;
    let touchStartX = 0;
    let isScrolling = false;
    const SCROLL_THRESHOLD = 10;

    heroSection.addEventListener('mousemove', (e) => {
      const rect = heroSection.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width;
      const y = (e.clientY - rect.top) / rect.height;

      document.dispatchEvent(new CustomEvent('experienceMouseMove', {
        detail: { x, y, clientX: e.clientX, clientY: e.clientY }
      }));

      if (experienceMouseTimeout) clearTimeout(experienceMouseTimeout);
      experienceMouseTimeout = window.setTimeout(() => {
        document.dispatchEvent(new CustomEvent('experienceMouseInactive'));
      }, 800);
    }, { signal });

    heroSection.addEventListener('mouseleave', () => {
      document.dispatchEvent(new CustomEvent('experienceMouseLeave'));
    }, { signal });

    heroSection.addEventListener('touchstart', (e) => {
      if (e.touches.length > 0) {
        const touch = e.touches[0];
        touchStartX = touch.clientX;
        touchStartY = touch.clientY;
        isScrolling = false;
      }
    }, { signal, passive: true });

    heroSection.addEventListener('touchmove', (e) => {
      if (e.touches.length > 0) {
        const touch = e.touches[0];
        const deltaY = Math.abs(touch.clientY - touchStartY);
        const deltaX = Math.abs(touch.clientX - touchStartX);

        if (deltaY > SCROLL_THRESHOLD && deltaY > deltaX) {
          isScrolling = true;
        }

        if (!isScrolling) {
          const rect = heroSection.getBoundingClientRect();
          const x = (touch.clientX - rect.left) / rect.width;
          const y = (touch.clientY - rect.top) / rect.height;

          document.dispatchEvent(new CustomEvent('experienceMouseMove', {
            detail: { x, y, clientX: touch.clientX, clientY: touch.clientY }
          }));
        }
      }
    }, { signal, passive: true });

    heroSection.addEventListener('touchend', () => {
      isScrolling = false;
      document.dispatchEvent(new CustomEvent('experienceMouseLeave'));
    }, { signal });
  });
</script>
