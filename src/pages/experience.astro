---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Navbar from "../layouts/Navigation.astro";
import Footer from "../layouts/Footer.astro";
import ArtParticleViewer from "../components/ArtParticleViewer.astro";
import CompanyMark from "../components/CompanyMark.astro";
import { companyMark } from "../data/companyMarks";

const allExperiences = await getCollection("experience");

// The roles that lead the page, in this order, whatever their start dates.
const PINNED = ["octapulse", "pioneer fund"];
const pinRank = (company: string) => {
  const i = PINNED.indexOf(company.toLowerCase());
  return i === -1 ? PINNED.length : i;
};

// Sort experiences: pinned roles first, then current positions (empty endDate),
// then by start date (most recent first)
const sortedExperiences = allExperiences.sort((a, b) => {
  const pinned = pinRank(a.data.company) - pinRank(b.data.company);
  if (pinned !== 0) return pinned;

  const aIsCurrent = !a.data.endDate || a.data.endDate === "";
  const bIsCurrent = !b.data.endDate || b.data.endDate === "";

  // Current positions come first
  if (aIsCurrent && !bIsCurrent) return -1;
  if (!aIsCurrent && bIsCurrent) return 1;

  // Within the same group (both current or both ended), sort by start date descending
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});

// Static at build time. Nothing on this page reads request-time state, so it is
// served straight from the edge instead of invoking a function per request.
export const prerender = true;
---

<Layout title="Experience" description="Engineering roles and internships across Tesla, ASML, NVIDIA, Toyota and my own company.">
  <div class="min-h-screen flex flex-col bg-secondary">
    <div class="flex-grow">
      <Navbar>
        <!-- HERO SECTION WITH PARTICLE EFFECT -->
        <div class="hero-section relative min-h-screen bg-secondary flex items-center justify-center overflow-hidden" id="hero-section">
          <!-- Particle background -->
          <ArtParticleViewer mouseRadius={6.0} />

          <!-- Dark overlay -->
          <div class="hero-overlay absolute inset-0 bg-black/70 pointer-events-none"></div>

          <!-- Hero content -->
          <div class="hero-content relative z-[10] w-full px-4 sm:px-6 lg:px-8 pointer-events-none transition-opacity duration-300">
            <div class="max-w-7xl mx-auto">
              <h1 class="experience-title font-mono font-black tracking-tighter leading-none select-none" transition:name="page-title" transition:animate="fade">
                <span class="char char-1">E</span><span class="char char-2">X</span><span class="char char-3">P</span><span class="char char-4">E</span><span class="char char-5">R</span><span class="char char-6">I</span><span class="char char-7">E</span><span class="char char-8">N</span><span class="char char-9">C</span><span class="char char-10">E</span>
              </h1>
              <p class="hero-subtitle font-mono text-primary/50 text-sm sm:text-base tracking-[0.3em] uppercase mt-6">
                // CAREER TIMELINE
              </p>
              <p class="hero-description text-primary/60 max-w-xl mt-4">
                From NVIDIA to Tesla to founding startups — a journey through engineering
              </p>
            </div>
          </div>

          <!-- Scroll indicator -->
          <div class="scroll-indicator absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 animate-bounce z-20 pointer-events-none">
            <span class="text-primary/40 text-xs font-mono tracking-wider">SCROLL</span>
            <svg class="w-5 h-5 text-primary/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
            </svg>
          </div>
        </div>

        <div class="relative overflow-hidden">
          <!-- Tech grid overlay -->
          <div class="absolute inset-0 tech-grid opacity-10 z-0 pointer-events-none"></div>

          <div class="relative z-10 sm:px-20 px-6 py-12">
            <!-- CAREER JOURNEY TIMELINE -->
            <div class="journey-section mb-16 opacity-0">
              <div class="flex items-center gap-4 mb-8">
                <p class="font-mono text-xs tracking-[0.3em] text-primary/30 uppercase">
                  Career Journey
                </p>
                <div class="h-px flex-1 bg-gradient-to-r from-primary/20 to-transparent"></div>
              </div>

              <!-- Timeline Container -->
              <div class="career-timeline-wrapper relative">
                <!-- Journey Cards Grid -->
                <div class="journey-cards-grid">
                  <!-- OctaPulse - Current + YC -->
                  <div class="journey-card-wrapper" data-haptic="light" data-cursor-label="Explore" style="animation-delay: 1s;" data-company="octapulse" data-slug="octapulse-cto">
                    <div class="journey-card group">
                      <div class="journey-corner journey-corner-tl"></div>
                      <div class="journey-corner journey-corner-tr"></div>
                      <div class="journey-corner journey-corner-bl"></div>
                      <div class="journey-corner journey-corner-br"></div>
                      <div class="journey-gradient-border orange-gradient"></div>
                      <div class="journey-grid-overlay"></div>
                      <div class="journey-glow-overlay orange-glow"></div>
                      <div class="journey-card-content">
                        <div class="journey-badges-container">
                          <div class="journey-badge white-badge">CURRENT</div>
                          <div class="journey-badge yc-badge">YC</div>
                        </div>
                        <h3 class="journey-company"><CompanyMark company="OctaPulse" /><span>OctaPulse</span></h3>
                        <p class="journey-year">2025</p>
                        <p class="journey-role">Co-founder</p>
                      </div>
                    </div>
                  </div>

                  <!-- Pioneer Fund - Current -->
                  <div class="journey-card-wrapper" data-haptic="light" data-cursor-label="Explore" style="animation-delay: 1.05s;" data-company="pioneer fund" data-slug="pioneer-fund-venture-partner">
                    <div class="journey-card group">
                      <div class="journey-corner journey-corner-tl"></div>
                      <div class="journey-corner journey-corner-tr"></div>
                      <div class="journey-corner journey-corner-bl"></div>
                      <div class="journey-corner journey-corner-br"></div>
                      <div class="journey-gradient-border orange-gradient"></div>
                      <div class="journey-grid-overlay"></div>
                      <div class="journey-glow-overlay orange-glow"></div>
                      <div class="journey-card-content">
                        <div class="journey-badge white-badge">CURRENT</div>
                        <h3 class="journey-company"><CompanyMark company="Pioneer Fund" /><span>Pioneer</span></h3>
                        <p class="journey-year">2026</p>
                        <p class="journey-role">Venture Partner</p>
                      </div>
                    </div>
                  </div>

                  <!-- Quaternion Studios -->
                  <div class="journey-card-wrapper" data-haptic="light" data-cursor-label="Explore" style="animation-delay: 1.1s;" data-company="quaternion studios" data-slug="quaternion-studios">
                    <div class="journey-card group">
                      <div class="journey-corner journey-corner-tl"></div>
                      <div class="journey-corner journey-corner-tr"></div>
                      <div class="journey-corner journey-corner-bl"></div>
                      <div class="journey-corner journey-corner-br"></div>
                      <div class="journey-gradient-border cyan-soft-gradient"></div>
                      <div class="journey-grid-overlay"></div>
                      <div class="journey-glow-overlay cyan-soft-glow"></div>
                      <div class="journey-card-content">
                        <h3 class="journey-company"><CompanyMark company="Quaternion Studios" /><span>Quaternion</span></h3>
                        <p class="journey-year">2025</p>
                        <p class="journey-role">Founder</p>
                      </div>
                    </div>
                  </div>

                  <!-- ASML -->
                  <div class="journey-card-wrapper" data-haptic="light" data-cursor-label="Explore" style="animation-delay: 1.2s;" data-company="asml" data-slug="asml-robotics-intern">
                    <div class="journey-card group">
                      <div class="journey-corner journey-corner-tl"></div>
                      <div class="journey-corner journey-corner-tr"></div>
                      <div class="journey-corner journey-corner-bl"></div>
                      <div class="journey-corner journey-corner-br"></div>
                      <div class="journey-gradient-border cyan-gradient"></div>
                      <div class="journey-grid-overlay"></div>
                      <div class="journey-glow-overlay cyan-glow"></div>
                      <div class="journey-card-content">
                        <h3 class="journey-company"><CompanyMark company="ASML" /><span class="sr-only">ASML</span></h3>
                        <p class="journey-year">2025</p>
                        <p class="journey-role">Robotics Eng</p>
                      </div>
                    </div>
                  </div>

                  <!-- Toyota -->
                  <div class="journey-card-wrapper" data-haptic="light" data-cursor-label="Explore" style="animation-delay: 1.3s;" data-company="toyota" data-slug="toyota">
                    <div class="journey-card group">
                      <div class="journey-corner journey-corner-tl"></div>
                      <div class="journey-corner journey-corner-tr"></div>
                      <div class="journey-corner journey-corner-bl"></div>
                      <div class="journey-corner journey-corner-br"></div>
                      <div class="journey-gradient-border red-soft-gradient"></div>
                      <div class="journey-grid-overlay"></div>
                      <div class="journey-glow-overlay red-soft-glow"></div>
                      <div class="journey-card-content">
                        <h3 class="journey-company"><CompanyMark company="Toyota" /><span>Toyota</span></h3>
                        <p class="journey-year">2024</p>
                        <p class="journey-role">Software Eng</p>
                      </div>
                    </div>
                  </div>

                  <!-- Tesla 2023 -->
                  <div class="journey-card-wrapper" data-haptic="light" data-cursor-label="Explore" style="animation-delay: 1.4s;" data-company="tesla" data-slug="tesla-software-intern-2023">
                    <div class="journey-card group">
                      <div class="journey-corner journey-corner-tl"></div>
                      <div class="journey-corner journey-corner-tr"></div>
                      <div class="journey-corner journey-corner-bl"></div>
                      <div class="journey-corner journey-corner-br"></div>
                      <div class="journey-gradient-border red-gradient"></div>
                      <div class="journey-grid-overlay"></div>
                      <div class="journey-glow-overlay red-glow"></div>
                      <div class="journey-card-content">
                        <h3 class="journey-company"><CompanyMark company="Tesla" /><span>Tesla</span></h3>
                        <p class="journey-year">2023</p>
                        <p class="journey-role">Software Eng</p>
                      </div>
                    </div>
                  </div>

                  <!-- Tesla 2022 -->
                  <div class="journey-card-wrapper" data-haptic="light" data-cursor-label="Explore" style="animation-delay: 1.5s;" data-company="tesla" data-slug="tesla-software-intern-2022">
                    <div class="journey-card group">
                      <div class="journey-corner journey-corner-tl"></div>
                      <div class="journey-corner journey-corner-tr"></div>
                      <div class="journey-corner journey-corner-bl"></div>
                      <div class="journey-corner journey-corner-br"></div>
                      <div class="journey-gradient-border red-gradient"></div>
                      <div class="journey-grid-overlay"></div>
                      <div class="journey-glow-overlay red-glow"></div>
                      <div class="journey-card-content">
                        <h3 class="journey-company"><CompanyMark company="Tesla" /><span>Tesla</span></h3>
                        <p class="journey-year">2022</p>
                        <p class="journey-role">Software Eng</p>
                      </div>
                    </div>
                  </div>

                  <!-- NVIDIA -->
                  <div class="journey-card-wrapper" data-haptic="light" data-cursor-label="Explore" style="animation-delay: 1.6s;" data-company="nvidia" data-slug="nvidia-cad-intern">
                    <div class="journey-card group">
                      <!-- Corner accents -->
                      <div class="journey-corner journey-corner-tl"></div>
                      <div class="journey-corner journey-corner-tr"></div>
                      <div class="journey-corner journey-corner-bl"></div>
                      <div class="journey-corner journey-corner-br"></div>

                      <!-- Gradient border -->
                      <div class="journey-gradient-border green-gradient"></div>

                      <!-- Grid overlay -->
                      <div class="journey-grid-overlay"></div>

                      <!-- Glow effect -->
                      <div class="journey-glow-overlay green-glow"></div>

                      <!-- Content -->
                      <div class="journey-card-content">
                        <h3 class="journey-company"><CompanyMark company="NVIDIA" /><span>NVIDIA</span></h3>
                        <p class="journey-year">2021</p>
                        <p class="journey-role">CAD Engineering</p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- 3D ILLUMINATED TIMELINE -->
            <div id="experience-timeline" class="relative min-h-screen">
              <!-- Cards Container -->
              <div class="cards-container relative z-10 w-full space-y-8 pb-20">
                {sortedExperiences.map((experience, index) => {
                  const companyFirstLetter = experience.data.company.toLowerCase().charAt(0);
                  const borderClass =
                    companyFirstLetter === "t"
                      ? "border-red-300/50"
                      : companyFirstLetter === "n"
                        ? "border-green-300/50"
                        : companyFirstLetter === "a"
                          ? "border-cyan-300/50"
                          : "border-primary/20";

                  const colorClass =
                    companyFirstLetter === "t"
                      ? "text-red-300/80"
                      : companyFirstLetter === "n"
                        ? "text-green-300/80"
                        : companyFirstLetter === "a"
                          ? "text-cyan-300/80"
                          : "text-primary/80";

                  return (
                    <div
                      class="experience-card group" data-haptic="light" data-cursor-label="Read"
                      data-index={index}
                      data-company={experience.data.company.toLowerCase()}
                      data-slug={experience.slug}
                      style={`animation-delay: ${1.2 + index * 0.1}s;`}
                    >
                      <!-- Corner accent marks -->
                      <div class="card-corner-accent card-corner-tl"></div>
                      <div class="card-corner-accent card-corner-tr"></div>
                      <div class="card-corner-accent card-corner-bl"></div>
                      <div class="card-corner-accent card-corner-br"></div>

                      <!-- Animated gradient border -->
                      <div class="card-gradient-border"></div>

                      <!-- Grid overlay -->
                      <div class="card-grid-overlay"></div>

                      <!-- Glow overlay that follows mouse (warm colored) -->
                      <div class="glow-overlay-warm"></div>

                      <!-- Clean Minimalist Card -->
                      <a href={`/experience/${experience.slug}`} class="card-link block relative group">
                        <!-- The card content -->
                        <div class="card-content relative p-8 sm:p-12 overflow-hidden transition-all duration-500">
                          <!-- Subtle accent line -->
                          <div class={`accent-bar absolute left-0 top-0 w-1 h-0 ${borderClass} transition-all duration-500 group-hover:h-full`}></div>

                          <!-- Illumination glow effect -->
                          <div class="card-glow absolute inset-0 opacity-0 transition-opacity duration-500 pointer-events-none" style="background: radial-gradient(circle 400px at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(255, 255, 255, 0.03), transparent);"></div>

                          <div class="relative z-10">
                            <!-- Header -->
                            <div class="card-header flex items-start justify-between gap-6 mb-8">
                              <div class="flex-1">
                                <h2 class="font-mono text-3xl sm:text-4xl text-white/95 font-bold tracking-tight leading-tight mb-3 group-hover:text-white transition-colors duration-300">
                                  {experience.data.title}
                                </h2>
                                <p class="text-primary/40 font-mono text-xs tracking-[0.2em] uppercase">
                                  {experience.data.date}
                                </p>
                              </div>
                              <div class="flex items-center gap-2">
                                <span class={`company-badge inline-flex items-center gap-2 font-mono text-sm px-4 py-2 rounded border ${borderClass} ${colorClass} whitespace-nowrap`}>
                                  <CompanyMark company={experience.data.company} />
                                  <span class:list={[companyMark(experience.data.company)?.wordmark && "sr-only"]}>
                                    {experience.data.company}
                                  </span>
                                </span>
                                {experience.data.company.toLowerCase() === "octapulse" && (
                                  <span class="yc-company-badge font-mono text-xs px-2 py-1 rounded border border-[rgba(255,102,0,0.5)] text-[rgb(255,102,0)] bg-[rgba(255,102,0,0.15)] whitespace-nowrap font-bold">
                                    YC
                                  </span>
                                )}
                              </div>
                            </div>

                            <!-- Description -->
                            <p class="text-primary/70 mb-8 text-base leading-relaxed max-w-3xl group-hover:text-primary/90 transition-colors duration-300">
                              {experience.data.description}
                            </p>

                            <!-- Tags -->
                            <div class="flex flex-wrap gap-2 mb-8">
                              {experience.data.tags.map((tag: string) => (
                                <span class="text-xs px-3 py-1.5 rounded bg-primary/5 text-primary/50 border border-primary/10 font-mono group-hover:bg-primary/10 group-hover:text-primary/70 group-hover:border-primary/20 transition-all duration-300">
                                  {tag}
                                </span>
                              ))}
                            </div>

                            <!-- Call to action -->
                            <div class="text-primary/30 font-mono text-sm flex items-center gap-2 group-hover:text-primary/70 transition-all duration-300">
                              <span>View details</span>
                              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                              </svg>
                            </div>
                          </div>
                        </div>
                      </a>
                    </div>
                  );
                })}
              </div>
            </div>
          </div>
        </div>
      </Navbar>
    </div>
    <Footer />
  </div>
</Layout>

<style>
  /* HERO SECTION */
  .hero-section {
    position: relative;
  }

  .hero-overlay {
    z-index: 5;
  }

  .hero-subtitle {
    opacity: 0;
    transform: translateY(30px);
    color: rgba(255, 255, 255, 0.85);
    text-shadow:
      0 2px 8px rgba(0, 0, 0, 0.95),
      0 4px 20px rgba(0, 0, 0, 0.85);
  }

  .hero-description {
    opacity: 0;
    transform: translateY(30px);
    color: rgba(255, 255, 255, 0.9);
    text-shadow:
      0 2px 8px rgba(0, 0, 0, 0.95),
      0 4px 20px rgba(0, 0, 0, 0.85);
  }

  /* Tech grid background */
  .tech-grid {
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 100px 100px;
    /* Static on purpose. The old 60s background-position drift moved the grid
       1.7px per second, which nobody can see, but background-position is not
       compositor-animatable in WebKit, so the page-tall element under every
       card was repainted on the main thread every frame. */
  }

  /* BOLD EXPERIENCE TITLE */
  .experience-title {
    font-size: clamp(2.5rem, 11vw, 16rem);
    line-height: 0.85;
    letter-spacing: -0.06em;
    color: #ffffff;
    text-transform: uppercase;
    font-weight: 900;
    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.3);
    white-space: nowrap;
    text-shadow:
      0 3px 25px rgba(0, 0, 0, 0.9),
      0 6px 45px rgba(0, 0, 0, 0.7);
  }

  /* Character animations - driven by GSAP */
  .experience-title .char {
    display: inline-block;
  }

  /* The hidden intro state is skipped on client-side navigations: the header
     carries transition:name="page-title" and is snapshotted for the morph
     before the intro animation runs, so it has to already be visible. A full
     page load still gets the staggered character reveal. */
  html:not(.spa-nav) .experience-title .char {
    opacity: 0;
    transform: translateY(100px) scale(0.8);
  }

  /* Accent line - initial state for GSAP */
  .accent-line {
    height: 3px;
    width: 0;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.8), transparent);
  }

  /* Journey Cards Timeline */
  .career-timeline-wrapper {
    position: relative;
    padding: 1rem 0;
  }

  /* Journey Cards Grid - Horizontal on Desktop, Vertical on Mobile */
  .journey-cards-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: relative;
  }

  @media (min-width: 1024px) {
    .journey-cards-grid {
      flex-direction: row;
      gap: 0.75rem;
      justify-content: space-between;
      align-items: center;
    }
  }

  /* Journey Card Wrapper - initial state for GSAP batch reveal */
  .journey-card-wrapper {
    opacity: 0;
    transform: translateY(30px);
    position: relative;
    z-index: 1;
    flex: 1;
    min-width: 0;
    cursor: pointer;
  }

  @media (min-width: 1024px) {
    .journey-card-wrapper {
      flex: 0 1 auto;
      width: calc((100% - 4.5rem) / 7);
    }
  }

  /* Journey Card */
  .journey-card {
    position: relative;
    overflow: hidden;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .journey-card:hover {
    transform: translateY(-4px);
  }

  @media (min-width: 1024px) {
    .journey-card:hover {
      transform: translateY(-8px);
    }
  }

  /* Pause all animations on hover - ensure user interaction takes priority */
  .journey-card-wrapper:hover .journey-card,
  .journey-card-wrapper:hover .journey-corner,
  .journey-card-wrapper:hover .journey-gradient-border,
  .journey-card-wrapper:hover .journey-grid-overlay,
  .journey-card-wrapper:hover .journey-glow-overlay {
    animation-play-state: paused !important;
  }

  /* Ensure manual hover takes priority */
  .journey-card-wrapper:hover .journey-card {
    transform: translateY(-4px) !important;
  }

  @media (min-width: 1024px) {
    .journey-card-wrapper:hover .journey-card {
      transform: translateY(-8px) !important;
    }
  }

  /* Journey Card Content. No backdrop-filter: 40% black over a #000 page reads
     the same with or without a blur, but on iOS every blurred card is
     re-sampled at 3x DPR on each composited frame, and this page never idles. */
  .journey-card-content {
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.05);
    padding: 1rem;
    position: relative;
    z-index: 10;
    transition: all 0.4s ease;
  }

  @media (min-width: 1024px) {
    .journey-card-content {
      padding: 1.25rem 0.875rem;
    }
  }

  /* Only the seventh card brightens on hover. The other six used to carry
     the cardContentBrighten keyframes on this element, and an animation
     declaration outranks a hover rule in the cascade, so hover never changed
     their colours; now that the cycle paints a pseudo-element the hover rule
     would suddenly reach all seven and stack on top of it. Keeping the old
     reach keeps desktop identical. */
  .journey-card-wrapper:last-child .journey-card:hover .journey-card-content {
    background: rgba(0, 0, 0, 0.5);
    border-color: rgba(255, 255, 255, 0.15);
  }

  /* The cascading auto-hover cycle only runs where a hover exists to imitate.
     On touch devices (and narrow windows) the cards are static: there is no
     pointer to pause the cycle, and 60+ infinite animations kept the phone's
     compositor and main thread awake for the whole visit. */
  @media (hover: hover) and (min-width: 1024px) {
    /* Cascading hover-like animation for each card. Each wrapper's offset in
       the 15s cycle is --journey-delay, set by the script to index * 15s / n,
       so the cascade spaces itself evenly over however many cards there are.
       It used to be seven hard-coded nth-child delays 2s apart, which left
       the eighth card (NVIDIA) out of the cycle entirely. */

    /* The script adds .is-offscreen while the grid is out of view. The corner
       keyframes animate width and height, which is layout on every frame, so
       the cascade should not run for cards nobody can see. */
    .journey-cards-grid.is-offscreen *,
    .journey-cards-grid.is-offscreen *::before {
      animation-play-state: paused !important;
    }

    /* Auto hover effect - lift the card (longer duration, smooth transitions) */
    .journey-card-wrapper .journey-card {
      animation: autoHoverEffect 15s ease-in-out infinite;
      animation-delay: var(--journey-delay, 0s);
    }

    @keyframes autoHoverEffect {
      0%, 100% {
        transform: translateY(0);
      }
      5% {
        transform: translateY(-8px);
      }
      15% {
        transform: translateY(-8px);
      }
      20% {
        transform: translateY(0);
      }
    }

    /* Corner accent animation. Width/height still animate here (scale() would
       also thicken the 1.5px border and needs a per-corner transform-origin);
       the drop-shadow filter keyframe is gone because filter animations
       rasterise the corner every frame for a 6px glow. */
    .journey-card-wrapper .journey-corner {
      animation: cornerExpand 15s ease-in-out infinite;
      animation-delay: var(--journey-delay, 0s);
    }

    @keyframes cornerExpand {
      0%, 100% {
        width: 10px;
        height: 10px;
        border-color: rgba(255, 255, 255, 0.3);
        filter: none;
      }
      5% {
        width: 14px;
        height: 14px;
        border-color: rgba(255, 255, 255, 0.6);
        filter: drop-shadow(0 0 6px rgba(255, 255, 255, 0.4));
      }
      15% {
        width: 14px;
        height: 14px;
        border-color: rgba(255, 255, 255, 0.6);
        filter: drop-shadow(0 0 6px rgba(255, 255, 255, 0.4));
      }
      20% {
        width: 10px;
        height: 10px;
        border-color: rgba(255, 255, 255, 0.3);
        filter: none;
      }
    }

    /* Gradient border animation */
    .journey-card-wrapper .journey-gradient-border {
      animation: borderIntensify 15s ease-in-out infinite;
      animation-delay: var(--journey-delay, 0s);
    }

    @keyframes borderIntensify {
      0%, 100% {
        opacity: 0.5;
      }
      5% {
        opacity: 1;
        animation-duration: 2s;
      }
      15% {
        opacity: 1;
        animation-duration: 2s;
      }
      20% {
        opacity: 0.5;
      }
    }

    /* Grid overlay animation */
    .journey-card-wrapper .journey-grid-overlay {
      animation: gridFadeIn 15s ease-in-out infinite;
      animation-delay: var(--journey-delay, 0s);
    }

    @keyframes gridFadeIn {
      0%, 100% {
        opacity: 0;
      }
      5% {
        opacity: 1;
      }
      15% {
        opacity: 1;
      }
      20% {
        opacity: 0;
      }
    }

    /* Glow overlay animation */

    /* Sweeping glow animation - the sweep position is written by the RAF loop
       in the script below; this only fades the overlay in and out */
    .journey-card-wrapper .journey-glow-overlay {
      animation: glowFadeIn 15s ease-in-out infinite;
      animation-delay: var(--journey-delay, 0s);
    }

    @keyframes glowFadeIn {
      0%, 100% {
        opacity: 0;
      }
      5% {
        opacity: 1;
      }
      15% {
        opacity: 1;
      }
      20% {
        opacity: 0;
      }
    }

    /* Enhanced brightness during the cycle. Painted by a pseudo-element whose
       opacity is animated instead of keyframing background/border-color on
       the content box: opacity runs on the compositor, colour changes repaint
       the card and its text every frame. Layered over the resting colours the
       overlay lands on the same rgba(0,0,0,0.5) / rgba(255,255,255,0.15) the
       old keyframes reached. It is deliberately not in the hover pause list
       and the hover colour rule above is limited to card 7: the old keyframes
       kept cycling under the pointer and blocked hover on cards 1-6, so this
       is the same picture. z-index -1 keeps it under the card text. */
    .journey-card-content::before {
      content: '';
      position: absolute;
      inset: -1px;
      background: rgba(0, 0, 0, 0.1667);
      border: 1px solid rgba(255, 255, 255, 0.105);
      opacity: 0;
      pointer-events: none;
      z-index: -1;
    }

    .journey-card-wrapper:not(:last-child) .journey-card-content::before {
      animation: cardContentBrighten 15s ease-in-out infinite;
      animation-delay: var(--journey-delay, 0s);
    }

    @keyframes cardContentBrighten {
      0%, 100% {
        opacity: 0;
      }
      5% {
        opacity: 1;
      }
      15% {
        opacity: 1;
      }
      20% {
        opacity: 0;
      }
    }
  }

