---
import Navbar from "../layouts/Navigation.astro";
import Footer from "../layouts/Footer.astro";
import Layout from "../layouts/Layout.astro";
import ArtParticleViewer from "../components/ArtParticleViewer.astro";

const artworks = [
  {
    src: "/images/art/demon-masks-illustration.jpeg",
    title: "Inner Demons",
    description: "Digital illustration exploring duality and hidden personas"
  },
  {
    src: "/images/art/antelope-canyon-painting.jpg",
    title: "Antelope Canyon",
    description: "Painterly interpretation of the iconic slot canyon's warm embrace"
  },
  {
    src: "/images/art/pooh-tigger-butterfly.jpg",
    title: "Hundred Acre Moment",
    description: "Hand-drawn tribute to childhood classics"
  },
  {
    src: "/images/art/pooh-tigger-dreaming.jpg",
    title: "Sweet Dreams",
    description: "Winnie and Tigger in a peaceful daydream"
  }
];
---

<Layout title="Art - Rohan Singh" description="A collection of my creative work, illustrations, and visual explorations">
  <div class="min-h-screen flex flex-col bg-secondary">
    <div class="flex-grow">
      <Navbar>
        <!-- HERO SECTION WITH PARTICLE EFFECT -->
        <div class="hero-section relative min-h-screen bg-secondary flex items-center justify-center overflow-hidden" id="hero-section">
          <!-- Particle background -->
          <ArtParticleViewer />

          <!-- Dark overlay -->
          <div class="hero-overlay absolute inset-0 bg-black/70 pointer-events-none"></div>

          <!-- Hero content -->
          <div class="hero-content relative z-[10] w-full px-4 sm:px-6 lg:px-8 pointer-events-none transition-opacity duration-300">
            <div class="max-w-7xl mx-auto">
              <h1 class="hero-title font-mono font-black tracking-tighter leading-none select-none" transition:name="page-title" transition:animate="fade">
                <span class="char char-1">A</span><span class="char char-2">R</span><span class="char char-3">T</span>
              </h1>
              <p class="hero-subtitle font-mono text-primary/50 text-sm sm:text-base tracking-[0.3em] uppercase mt-6">
                // CREATIVE CORNER
              </p>
              <p class="hero-description text-primary/60 max-w-xl mt-4">
                Hand-drawn illustrations, digital explorations, and visual experiments
              </p>
            </div>
          </div>

          <!-- Scroll indicator -->
          <div class="scroll-indicator absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 animate-bounce z-20 pointer-events-none">
            <span class="text-primary/40 text-xs font-mono tracking-wider">SCROLL</span>
            <svg class="w-5 h-5 text-primary/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
            </svg>
          </div>
        </div>

        <div class="relative overflow-hidden">
          <!-- Tech grid overlay for texture -->
          <div class="absolute inset-0 tech-grid opacity-10 z-0 pointer-events-none"></div>

          <!-- Main Content -->
          <div class="relative z-10 sm:px-20 px-6 py-12">
            <!-- Gallery header -->
            <div class="header-section mb-16">
              <h2 class="section-title font-mono font-bold text-2xl sm:text-3xl text-primary/90 mb-4">
                Gallery
              </h2>
              <div class="accent-line"></div>
            </div>

            <!-- Gallery Section -->
            <div class="gallery-section mb-20">
              <h2 class="section-label font-mono text-sm tracking-[0.3em] uppercase text-primary/50 mb-8">
                // GALLERY
              </h2>

              <div class="gallery-grid">
                {artworks.map((artwork, index) => (
                  <div class="artwork-card group">
                    <!-- Corner accents -->
                    <div class="card-corner card-corner-tl"></div>
                    <div class="card-corner card-corner-tr"></div>
                    <div class="card-corner card-corner-bl"></div>
                    <div class="card-corner card-corner-br"></div>

                    <div class="artwork-image-container">
                      <img
                        src={artwork.src}
                        alt={artwork.title}
                        class="artwork-image"
                        loading="lazy"
                      />
                    </div>
                    <div class="artwork-info">
                      <h3 class="artwork-title">{artwork.title}</h3>
                      <p class="artwork-description">{artwork.description}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <!-- More Coming Soon Section -->
            <div class="coming-soon-section mb-20">
              <div class="coming-soon-banner">
                <div class="banner-content">
                  <div class="banner-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                    </svg>
                  </div>
                  <div class="banner-text">
                    <h3 class="font-mono text-lg text-primary/80 mb-2">More artwork on the way</h3>
                    <p class="text-primary/50 text-sm">This gallery is just getting started. Check back soon for new pieces including photography, generative art, and more experiments.</p>
                  </div>
                </div>

                <!-- Placeholder grid -->
                <div class="placeholder-grid">
                  <div class="placeholder-card"></div>
                  <div class="placeholder-card"></div>
                  <div class="placeholder-card"></div>
                  <div class="placeholder-card hidden sm:block"></div>
                </div>
              </div>
            </div>

          </div>
        </div>
      </Navbar>
    </div>
    <Footer />
  </div>
</Layout>

<style>
  /* ===== HERO SECTION ===== */
  .hero-section {
    position: relative;
    /* Removed fixed height and background black to match others */
  }

  .hero-overlay {
    transition: opacity 0.3s ease;
    z-index: 5;
  }

  .hero-content {
    /* Removed pointer-events: none; here as it's handled in the HTML class */
  }

  /* Hero title - large dramatic text */
  .hero-title {
    font-size: clamp(6rem, 25vw, 20rem);
    line-height: 0.85;
    letter-spacing: -0.08em;
    color: #ffffff;
    text-transform: uppercase;
    text-shadow:
      0 3px 25px rgba(0, 0, 0, 0.9),
      0 6px 45px rgba(0, 0, 0, 0.7),
      0 0 100px rgba(255, 255, 255, 0.1);
  }

  /* Individual character animations */
  .hero-title .char {
    display: inline-block;
    opacity: 0;
    transform: translateY(100px) scale(0.8);
  }

  .hero-subtitle {
    opacity: 0;
    transform: translateY(30px);
    color: rgba(255, 255, 255, 0.85);
    text-shadow:
      0 2px 8px rgba(0, 0, 0, 0.95),
      0 4px 20px rgba(0, 0, 0, 0.85);
  }

  .hero-description {
    opacity: 0;
    transform: translateY(30px);
    color: rgba(255, 255, 255, 0.9);
    text-shadow:
      0 2px 8px rgba(0, 0, 0, 0.95),
      0 4px 20px rgba(0, 0, 0, 0.85);
  }

  .scroll-indicator {
    opacity: 0;
  }

  /* ===== GALLERY SECTION ===== */
  /* Tech grid background */
  .tech-grid {
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 100px 100px;
    animation: gridPan 60s linear infinite;
  }

  @keyframes gridPan {
    0% { background-position: 0 0; }
    100% { background-position: 100px 100px; }
  }

  /* Section title */
  .section-title {
    opacity: 0;
    transform: translateY(30px);
  }

  /* Accent line */
  .accent-line {
    height: 2px;
    width: 0;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.6), transparent);
  }

  /* Gallery Section */
  .gallery-section {
    opacity: 0;
    transform: translateY(30px);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 2rem;
  }

  @media (min-width: 640px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Artwork Card */
  .artwork-card {
    position: relative;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    overflow: hidden;
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .artwork-card:hover {
    transform: translateY(-8px);
    border-color: rgba(255, 255, 255, 0.3);
    box-shadow:
      0 20px 40px rgba(0, 0, 0, 0.4),
      0 0 60px rgba(255, 255, 255, 0.05);
  }

  /* Corner accents */
  .card-corner {
    position: absolute;
    width: 20px;
    height: 20px;
    border: 2px solid rgba(255, 255, 255, 0.2);
    z-index: 20;
    pointer-events: none;
    transition: all 0.3s ease;
  }

  .card-corner-tl {
    top: -1px;
    left: -1px;
    border-right: none;
    border-bottom: none;
    border-radius: 12px 0 0 0;
  }

  .card-corner-tr {
    top: -1px;
    right: -1px;
    border-left: none;
    border-bottom: none;
    border-radius: 0 12px 0 0;
  }

  .card-corner-bl {
    bottom: -1px;
    left: -1px;
    border-right: none;
    border-top: none;
    border-radius: 0 0 0 12px;
  }

  .card-corner-br {
    bottom: -1px;
    right: -1px;
    border-left: none;
    border-top: none;
    border-radius: 0 0 12px 0;
  }

  .artwork-card:hover .card-corner {
    width: 30px;
    height: 30px;
    border-color: rgba(255, 255, 255, 0.5);
  }

  /* Artwork Image */
  .artwork-image-container {
    position: relative;
    aspect-ratio: 4/3;
    overflow: hidden;
  }

  .artwork-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .artwork-card:hover .artwork-image {
    transform: scale(1.05);
  }

  /* Artwork Info */
  .artwork-info {
    padding: 1.5rem;
  }

  .artwork-title {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 1.25rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 0.5rem;
  }

  .artwork-description {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.5);
    line-height: 1.5;
  }

  /* Coming Soon Section */
  .coming-soon-section {
    opacity: 0;
    transform: translateY(30px);
  }

  .coming-soon-banner {
    border: 1px dashed rgba(255, 255, 255, 0.2);
    border-radius: 16px;
    padding: 2rem;
    background: rgba(255, 255, 255, 0.02);
  }

  .banner-content {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .banner-icon {
    flex-shrink: 0;
    width: 3rem;
    height: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 12px;
    color: rgba(255, 255, 255, 0.4);
    animation: pulse-subtle 3s ease-in-out infinite;
  }

  @keyframes pulse-subtle {
    0%, 100% {
      opacity: 0.6;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.05);
    }
  }

  .placeholder-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .placeholder-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .placeholder-card {
    aspect-ratio: 1;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.03) 0%, rgba(255, 255, 255, 0.01) 100%);
    border: 1px dashed rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    position: relative;
    overflow: hidden;
  }

  .placeholder-card::after {
    content: '+';
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    color: rgba(255, 255, 255, 0.1);
    font-family: 'IBM Plex Mono', monospace;
  }

  /* RESPONSIVE */
  @media (max-width: 1024px) {
    .hero-title {
      font-size: clamp(3.5rem, 16vw, 14rem);
    }
  }

  @media (max-width: 768px) {
    .scroll-indicator {
      display: none !important;
    }

    .hero-title {
      font-size: clamp(3rem, 18vw, 12rem);
    }

    .banner-content {
      flex-direction: column;
      text-align: center;
      align-items: center;
    }
  }

  @media (max-width: 640px) {
    .hero-title {
      font-size: clamp(2.5rem, 20vw, 10rem);
    }
  }
</style>

<script>
  import { animateLineExpand, batchScrollReveal, scrollReveal, createPageIntroTimeline } from '../scripts/animations';
  import { initKineticText } from '../scripts/kinetic-text';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  let kineticCleanup: (() => void) | null = null;

  document.addEventListener('astro:page-load', () => {
    if (!document.querySelector('.artwork-card')) return;

    if (kineticCleanup) { kineticCleanup(); kineticCleanup = null; }

    const tl = createPageIntroTimeline();
    const chars = document.querySelectorAll('.hero-title .char');
    if (chars.length) {
      gsap.set(chars, { opacity: 0, y: 100, scale: 0.8 });
      tl.to(chars, { opacity: 1, y: 0, scale: 1, duration: 1, stagger: 0.05, ease: 'expo.out' }, 0);
    }
    tl.add(() => animateLineExpand('.accent-line'), 0.3);
    tl.to('.hero-subtitle', { opacity: 1, y: 0, duration: 1, ease: 'expo.out' }, 0.5);
    tl.to('.hero-description', { opacity: 1, y: 0, duration: 1, ease: 'expo.out' }, 0.7);
    tl.to('.scroll-indicator', { opacity: 1, duration: 1, ease: 'expo.out' }, 1.0);

    // Hero scroll-split effect
    const heroSection = document.getElementById('hero-section');
    const heroOverlay = document.querySelector('.hero-overlay') as HTMLElement;
    const allChars = Array.from(document.querySelectorAll('.hero-title .char'));
    const halfLen = Math.ceil(allChars.length / 2);
    const leftChars = allChars.slice(0, halfLen);
    const rightChars = allChars.slice(halfLen);

    if (leftChars.length && rightChars.length && heroSection && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const splitTl = gsap.timeline({
        scrollTrigger: {
          trigger: heroSection,
          start: 'top top',
          end: 'bottom top',
          scrub: true,
        },
      });
      splitTl.fromTo(leftChars, { x: 0, opacity: 1 }, { x: '-30vw', opacity: 0, ease: 'none' }, 0);
      splitTl.fromTo(rightChars, { x: 0, opacity: 1 }, { x: '30vw', opacity: 0, ease: 'none' }, 0);
      splitTl.fromTo('.hero-subtitle', { opacity: 1 }, { opacity: 0, ease: 'none' }, 0);
      splitTl.fromTo('.hero-description', { opacity: 1 }, { opacity: 0, ease: 'none', duration: 0.5 }, 0);
      splitTl.fromTo('.scroll-indicator', { opacity: 1 }, { opacity: 0, ease: 'none', duration: 0.3 }, 0);
      if (heroOverlay) {
        splitTl.fromTo(heroOverlay, { opacity: 0.7 }, { opacity: 0.2, ease: 'none' }, 0);
      }
    }

    // Continuous glow pulse on hero chars
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      tl.call(() => {
        const glowChars = document.querySelectorAll('.hero-title .char');
        if (glowChars.length) {
          gsap.to(glowChars, {
            textShadow: '0 0 40px rgba(255, 255, 255, 0.3), 0 0 80px rgba(255, 255, 255, 0.1)',
            duration: 2, stagger: 0.15, yoyo: true, repeat: -1, ease: 'sine.inOut',
          });
        }
      });
    }

    scrollReveal('.section-title');
    scrollReveal('.gallery-section');
    batchScrollReveal('.artwork-card');
    scrollReveal('.coming-soon-section');

    kineticCleanup = initKineticText('.hero-title');
  });

  document.addEventListener('astro:page-load', () => {
    if (!document.querySelector('.artwork-card')) return;

    // ===== HERO SECTION PARTICLE DISTORTION =====
    const heroSection = document.getElementById('hero-section');
    let mouseTimeout: number | null = null;
    let touchStartY = 0;
    let touchStartX = 0;
    let isScrolling = false;
    const SCROLL_THRESHOLD = 10;

    if (heroSection) {
      heroSection.addEventListener('mousemove', (e) => {
        const rect = heroSection.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width;
        const y = (e.clientY - rect.top) / rect.height;
        document.dispatchEvent(new CustomEvent('artMouseMove', {
          detail: { x, y, clientX: e.clientX, clientY: e.clientY }
        }));
        if (mouseTimeout) clearTimeout(mouseTimeout);
        mouseTimeout = window.setTimeout(() => {
          document.dispatchEvent(new CustomEvent('artMouseInactive'));
        }, 800);
      });

      heroSection.addEventListener('mouseleave', () => {
        document.dispatchEvent(new CustomEvent('artMouseLeave'));
      });

      heroSection.addEventListener('touchstart', (e) => {
        if (e.touches.length > 0) {
          const touch = e.touches[0];
          touchStartX = touch.clientX;
          touchStartY = touch.clientY;
          isScrolling = false;
        }
      }, { passive: true });

      heroSection.addEventListener('touchmove', (e) => {
        if (e.touches.length > 0) {
          const touch = e.touches[0];
          const deltaY = Math.abs(touch.clientY - touchStartY);
          const deltaX = Math.abs(touch.clientX - touchStartX);
          if (deltaY > SCROLL_THRESHOLD && deltaY > deltaX) {
            isScrolling = true;
          }
          if (!isScrolling) {
            const rect = heroSection.getBoundingClientRect();
            const x = (touch.clientX - rect.left) / rect.width;
            const y = (touch.clientY - rect.top) / rect.height;
            document.dispatchEvent(new CustomEvent('artMouseMove', {
              detail: { x, y, clientX: touch.clientX, clientY: touch.clientY }
            }));
          }
        }
      }, { passive: true });

      heroSection.addEventListener('touchend', () => {
        isScrolling = false;
        document.dispatchEvent(new CustomEvent('artMouseLeave'));
      });
    }
  });
</script>
