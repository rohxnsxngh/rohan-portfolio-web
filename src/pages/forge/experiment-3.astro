---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../layouts/Navigation.astro";
import Footer from "../../layouts/Footer.astro";

// Static at build time. Nothing on this page reads request-time state, so it is
// served straight from the edge instead of invoking a function per request.
export const prerender = true;
---

<Layout title="Advanced Shaders - The Forge" description="Custom materials and effects experiment">
  <Navbar>
    <div class="min-h-screen bg-secondary">
      <!-- Header -->
      <div class="pt-16 pb-8 px-4 sm:px-6 lg:px-8">
        <div class="max-w-7xl mx-auto">
          <!-- Below md the button row may drop under the title; from md up both
               rows are nowrap, which is the layout this page always had there
               (the title block shrinks and wraps, the buttons stay on the right). -->
          <div class="flex flex-wrap md:flex-nowrap items-center justify-between gap-y-4 mb-8">
            <div>
              <a href="/forge" class="inline-flex items-center text-primary/60 hover:text-primary transition-colors font-mono text-sm mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
                Back to Forge
              </a>
              <h1 class="text-3xl sm:text-4xl font-mono text-primary mb-2">Advanced Shaders</h1>
              <p class="text-primary/70 font-mono">Custom materials and effects</p>
            </div>
            <div class="flex flex-wrap md:flex-nowrap items-center gap-4">
              <button id="play-pause" class="px-4 py-2 border border-primary/20 text-primary/80 hover:bg-primary/10 transition-colors font-mono text-sm">
                Pause
              </button>
              <button id="reset-camera" class="px-4 py-2 border border-primary/20 text-primary/80 hover:bg-primary/10 transition-colors font-mono text-sm">
                Reset View
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- ThreeJS Container -->
      <div class="px-4 sm:px-6 lg:px-8">
        <div class="max-w-7xl mx-auto">
          <div id="threejs-container" data-experiment="3" class="w-full h-96 border border-primary/20 rounded-lg overflow-hidden bg-black/50">
            <div class="loading-container">
              <div class="loading-spinner"></div>
              <p class="text-primary/60 font-mono text-sm mt-4">Loading shader experiment...</p>
            </div>
          </div>
          
          <!-- Controls Info -->
          <div class="mt-6 p-4 border border-primary/10 rounded-lg bg-primary/5">
            <h3 class="text-lg font-mono text-primary mb-2">Shader Effects</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm font-mono text-primary/70">
              <div>
                <p><strong>Mouse:</strong> Rotate camera around the scene</p>
                <p><strong>Scroll:</strong> Zoom in/out</p>
              </div>
              <div>
                <p><strong>Space:</strong> Toggle animation</p>
                <p><strong>R:</strong> Reset camera position</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Navbar>
  <Footer />
</Layout>

<script>
  import { whenSized } from '../../scripts/whenSized';
  let cancelPendingSize: (() => void) | null = null;
  import { onPageReady } from '../../scripts/pageReady';
  import { isCoarsePointer } from '../../scripts/heavy3d';
  import type * as ThreeNS from "three";
  import type { OrbitControls } from "three/examples/jsm/controls/OrbitControls.js";

  // Loaded with import() at module scope, ungated; experiment-1.astro has the
  // reasoning, this page follows it.
  const heavy = Promise.all([
    import("three"),
    import("three/examples/jsm/controls/OrbitControls.js"),
  ]);
  let THREE: typeof ThreeNS;
  // Bumped by every init and dispose. An init that awaited the import checks
  // its token afterwards so a navigation away (or a second init) while the
  // chunk was in flight does not build a scene into a swapped-out container.
  let initToken = 0;

  // Scene variables
  let scene: ThreeNS.Scene;
  let camera: ThreeNS.PerspectiveCamera;
  let renderer: ThreeNS.WebGLRenderer;
  let cube: ThreeNS.Mesh;
  let controls: OrbitControls;
  let _animationId: number;
  let isAnimating = true;
  let time = 0;
  let eventAbort: AbortController | null = null;
  let contextLost = false;

  // Custom shader material
  const vertexShader = `
    varying vec2 vUv;
    varying vec3 vPosition;
    varying vec3 vNormal;
    
    void main() {
      vUv = uv;
      vPosition = position;
      vNormal = normal;
      gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
    }
  `;

  const fragmentShader = `
    uniform float time;
    uniform vec3 color1;
    uniform vec3 color2;
    uniform vec3 color3;
    
    varying vec2 vUv;
    varying vec3 vPosition;
    varying vec3 vNormal;
    
    void main() {
      // Create animated gradient based on UV coordinates and time
      vec2 uv = vUv;
      
      // Add some noise and distortion
      float noise = sin(uv.x * 10.0 + time) * sin(uv.y * 10.0 + time) * 0.1;
      uv += noise;
      
      // Create gradient
      vec3 color = mix(color1, color2, uv.x);
      color = mix(color, color3, uv.y);
      
      // Add some metallic effect
      float fresnel = 1.0 - dot(vNormal, vec3(0.0, 0.0, 1.0));
      color += fresnel * 0.3;
      
      // Add some pulsing effect
      float pulse = sin(time * 2.0) * 0.1 + 0.9;
      color *= pulse;
      
      gl_FragColor = vec4(color, 1.0);
    }
  `;

  function disposeThreeJS() {
    // Drop any pending wait-for-size so it cannot fire against a
    // container that has already been swapped away.
    cancelPendingSize?.();
    cancelPendingSize = null;
    initToken++;
    cancelAnimationFrame(_animationId);
    eventAbort?.abort();
    eventAbort = null;
    controls?.dispose();
    if (cube) {
      cube.geometry?.dispose();
      (cube.material as ThreeNS.Material)?.dispose();
    }
    if (renderer) {
      renderer.dispose();
      if (renderer.getContext()) {
        renderer.forceContextLoss();
      }
      renderer.domElement?.parentNode?.removeChild(renderer.domElement);
    }
  }

  // Initialize ThreeJS scene
  async function initThreeJS() {
    const container = document.getElementById('threejs-container');
    if (!container) return;
    // Under View Transitions this module outlives its page: the document is
    // never reloaded, so the astro:page-load listener registered below keeps
    // firing on every later navigation. All three experiments use the same
    // #threejs-container id, so without this check visiting experiment-1 and
    // then experiment-2 built both scenes into experiment-2's container, each
    // wiping the other's canvas and leaving an orphaned WebGL context and rAF
    // loop behind. Only the page that owns the container may build into it.
    if (container.dataset.experiment !== '3') return;

    // A zero-sized container yields a NaN camera aspect and a 0x0 drawing
    // buffer, which the stylesheet then stretches over the hero as a flat
    // panel. Wait for a real size instead of building against nothing.
    if (!container.clientWidth || !container.clientHeight) {
      cancelPendingSize?.();
      cancelPendingSize = whenSized(container, () => initThreeJS());
      return;
    }

    const token = ++initToken;
    const mods = await heavy;
    if (token !== initToken) return;
    [THREE] = mods;
    const { OrbitControls } = mods[1];

    disposeThreeJS();
    contextLost = false;
    eventAbort = new AbortController();

    // Clear loading content
    container.innerHTML = '';

    // Same low-power test as experiment-1: 1x pixel ratio, no MSAA and no
    // shadow pass on touch devices. Desktop values are untouched.
    const lowPower = isCoarsePointer() || window.matchMedia('(max-width: 767px)').matches;

    // Scene setup
    scene = new THREE.Scene();
    scene.background = new THREE.Color(0x000000);

    // Camera setup
    camera = new THREE.PerspectiveCamera(75, container.clientWidth / container.clientHeight, 0.1, 1000);
    camera.position.set(3, 3, 3);

    // Renderer setup
    renderer = new THREE.WebGLRenderer({ antialias: !lowPower });
    renderer.setSize(container.clientWidth, container.clientHeight);
    renderer.setPixelRatio(lowPower ? 1 : Math.min(window.devicePixelRatio, 2));
    // The only lit surface is a ShaderMaterial that ignores lights entirely,
    // so the shadow pass never shows; on a phone it is switched off.
    renderer.shadowMap.enabled = !lowPower;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;

    container.appendChild(renderer.domElement);

    renderer.domElement.addEventListener('webglcontextlost', (e) => {
      e.preventDefault();
      contextLost = true;
      cancelAnimationFrame(_animationId);
    }, { signal: eventAbort.signal });
    renderer.domElement.addEventListener('webglcontextrestored', () => {
      contextLost = false;
      initThreeJS();
    }, { signal: eventAbort.signal });

    // Create cube with custom shader
    const geometry = new THREE.BoxGeometry(1, 1, 1);
    const material = new THREE.ShaderMaterial({
      vertexShader,
      fragmentShader,
      uniforms: {
        time: { value: 0 },
        color1: { value: new THREE.Color(0xff6b6b) },
        color2: { value: new THREE.Color(0x4ecdc4) },
        color3: { value: new THREE.Color(0x45b7d1) }
      }
    });
    
    cube = new THREE.Mesh(geometry, material);
    cube.castShadow = true;
    cube.receiveShadow = true;
    scene.add(cube);

    // Add wireframe cube for extra visual interest
    const wireframeGeometry = new THREE.BoxGeometry(1.1, 1.1, 1.1);
    const wireframeMaterial = new THREE.MeshBasicMaterial({ 
      color: 0xffffff, 
      wireframe: true,
      transparent: true,
      opacity: 0.3
    });
    const wireframeCube = new THREE.Mesh(wireframeGeometry, wireframeMaterial);
    scene.add(wireframeCube);

    // Lighting setup
    const ambientLight = new THREE.AmbientLight(0x404040, 0.3);
    scene.add(ambientLight);

    const directionalLight = new THREE.DirectionalLight(0xffffff, 0.8);
    directionalLight.position.set(5, 5, 5);
    directionalLight.castShadow = true;
    scene.add(directionalLight);

    // Add some colored lights
    const light1 = new THREE.PointLight(0xff6b6b, 0.5, 10);
    light1.position.set(2, 2, 2);
    scene.add(light1);

    const light2 = new THREE.PointLight(0x4ecdc4, 0.5, 10);
    light2.position.set(-2, -2, 2);
    scene.add(light2);

    // Controls setup
    controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.05;
    controls.enableZoom = true;
    controls.enablePan = false;
    // OrbitControls sets touch-action: none, which swallows every touch on the
    // canvas and traps a phone user who is trying to scroll past it. pan-y
    // hands vertical drags back to the page; horizontal ones still orbit.
    // Mouse input is unaffected. Matches experiment-2.
    renderer.domElement.style.touchAction = 'pan-y';

    // Start animation loop
    animate();

    // Event listeners
    setupEventListeners();
  }

  // Animation loop
  function animate() {
    if (contextLost) return;
    _animationId = requestAnimationFrame(animate);

    time += 0.016; // ~60fps

    if (isAnimating && cube) {
      cube.rotation.x += 0.005;
      cube.rotation.y += 0.01;
      
      // Update shader time uniform
      if (cube.material instanceof THREE.ShaderMaterial) {
        cube.material.uniforms.time.value = time;
      }
    }

    if (controls) {
      controls.update();
    }

    if (renderer && scene && camera) {
      renderer.render(scene, camera);
    }
  }

  // Setup event listeners
  function setupEventListeners() {
    const signal = eventAbort!.signal;

    // Play/Pause button
    const playPauseBtn = document.getElementById('play-pause');
    if (playPauseBtn) {
      playPauseBtn.addEventListener('click', () => {
        isAnimating = !isAnimating;
        playPauseBtn.textContent = isAnimating ? 'Pause' : 'Play';
      }, { signal });
    }

    // Reset camera button
    const resetBtn = document.getElementById('reset-camera');
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (camera && controls) {
          camera.position.set(3, 3, 3);
          controls.target.set(0, 0, 0);
          controls.update();
        }
      }, { signal });
    }

    // Keyboard controls
    document.addEventListener('keydown', (event) => {
      switch(event.code) {
        case 'Space':
          event.preventDefault();
          isAnimating = !isAnimating;
          if (playPauseBtn) {
            playPauseBtn.textContent = isAnimating ? 'Pause' : 'Play';
          }
          break;
        case 'KeyR':
          if (camera && controls) {
            camera.position.set(3, 3, 3);
            controls.target.set(0, 0, 0);
            controls.update();
          }
          break;
      }
    }, { signal });

    // Window resize
    window.addEventListener('resize', () => {
      const container = document.getElementById('threejs-container');
      if (container && camera && renderer) {
        camera.aspect = container.clientWidth / container.clientHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(container.clientWidth, container.clientHeight);
      }
    }, { signal });
  }

  // Initialize on page load (supports View Transitions); dispose on navigation away.
  onPageReady(initThreeJS);
  document.addEventListener('astro:before-swap', disposeThreeJS);
</script>

<style>
  .loading-container {
    @apply flex flex-col items-center justify-center h-full;
  }

  .loading-spinner {
    @apply w-8 h-8 border-2 border-primary/20 border-t-primary rounded-full animate-spin;
  }

  #threejs-container {
    position: relative;
  }

  #threejs-container canvas {
    display: block;
  }
</style>
