---
// Dev-only gallery of every diagram kind, at /dev/diagrams.
//
// A dynamic route rather than dev/diagrams.astro on purpose: outside dev,
// getStaticPaths returns nothing, so the build emits no page at all. A static
// route would still be listed by the sitemap integration (it reads every
// static route, not the files written) and would need a 404 Response that a
// prerendered page cannot send.
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Diagram from '../../components/Diagram.astro';
import { DIAGRAMS } from '../../data/diagrams';

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { gallery: 'diagrams' } }] : [];
}

export const prerender = true;

const timeline = (await getCollection('experience')).map((e) => ({
  c: e.data.company, r: e.data.title, s: e.data.date, e: e.data.endDate || null, slug: e.slug,
}));
const entries = [
  ...Object.entries(DIAGRAMS).filter(([k], i, all) => all.findIndex(([, v]) => v[0].kind === DIAGRAMS[k][0].kind) === i),
  ['experience (listing)', [{ kind: 'career-timeline', label: 'Career timeline', caption: 'Career timeline.', aspect: 3.6, aspectSm: 1.1, data: timeline }]],
] as [string, typeof DIAGRAMS[string]][];
---

<Layout title="Diagrams (dev)">
  <main class="bg-black min-h-screen px-6 sm:px-20 py-16">
    <h1 class="font-mono text-sm tracking-[0.3em] uppercase text-white/50 mb-8">// DIAGRAM GALLERY (DEV ONLY)</h1>
    {entries.map(([key, specs]) => (
      <section class="mb-24" id={specs[0].kind}>
        <p class="font-mono text-xs text-white/40">{key}</p>
        {specs.map((d, i) => <Diagram {...d} index={i + 1} />)}
      </section>
    ))}
  </main>
</Layout>
