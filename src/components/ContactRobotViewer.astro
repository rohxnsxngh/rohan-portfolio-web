---
// ContactRobotViewer.astro - Walking robot background for contact page
interface Props {
  width?: string;
  height?: string;
  className?: string;
}

const {
  width = "100%",
  height = "100%",
  className = "",
} = Astro.props;
---

<div
  class={`contact-robot-viewer-container ${className}`}
  style={`--width: ${width}; --height: ${height};`}
>
  <div id="contact-robot-container" class="model-display-container">
    <div class="loading-container">
      <progress id="contact-progress-bar" value="0" max="100"></progress>
    </div>
  </div>
  <!-- Tech grid overlay for texture -->
  <div class="grid-overlay"></div>
</div>

<script>
  import { onPageReady } from '../scripts/pageReady';
  import { createRobotLightRig, ROBOT_EXPOSURE } from '../scripts/robotLightRig';
  import { bindOnce } from '../scripts/bindOnce';
  import * as THREE from "three";
  import { GLTFLoader } from "three/examples/jsm/loaders/GLTFLoader.js";
  import { DRACOLoader } from "three/examples/jsm/loaders/DRACOLoader.js";
  import { OrbitControls } from "three/examples/jsm/controls/OrbitControls.js";
  import { EffectComposer } from "three/examples/jsm/postprocessing/EffectComposer.js";
  import { RenderPass } from "three/examples/jsm/postprocessing/RenderPass.js";
  import { ShaderPass } from "three/examples/jsm/postprocessing/ShaderPass.js";

  // DOM elements — re-queried in init() to survive View Transition DOM swaps
  let container: Element | null = null;
  let visibilityObserver: IntersectionObserver | null = null;
  let modelContainer: HTMLElement | null = null;
  let progressBar: HTMLElement | null = null;
  let loadingContainer: Element | null | undefined = null;

  // Get container dimensions
  const getContainerSize = () => {
    if (!container) {
      return { width: 0, height: 0, aspectRatio: 1 };
    }
    const rect = container.getBoundingClientRect();
    return {
      width: rect.width,
      height: rect.height,
      aspectRatio: rect.width / rect.height || 1,
    };
  };

  let width = 0;
  let height = 0;
  let aspectRatio = 1;
  const backgroundColor = "#000000";

  // Variables
  let _robot: THREE.Group;
  let _mixerRobot: THREE.AnimationMixer;
  let controls: OrbitControls;
  let camera: THREE.PerspectiveCamera;
  let renderer: THREE.WebGLRenderer;
  let scene: THREE.Scene;
  let clock = new THREE.Clock();
  let animatedLights: any;
  // Exposure-scaled base intensity of the rig's spotlight, captured at
  // creation so the animation loop can pulse around it.
  let spotlightBase = 0;
  let magentaBase = 0;
  let mousePointLight: THREE.PointLight | null = null;
  let hemisphereLight: THREE.HemisphereLight | null = null;
  let raycaster: THREE.Raycaster | null = null;
  let mouseVector: THREE.Vector2 | null = null;
  let lightPosition: THREE.Vector3 = new THREE.Vector3();
  let composer: EffectComposer;

  // Custom Sobel Shader with alpha preservation - matches homepage implementation
  const SobelAlphaShader = {
    uniforms: {
      'tDiffuse': { value: null },
      'resolution': { value: new THREE.Vector2() }
    },
    vertexShader: `
      varying vec2 vUv;
      void main() {
        vUv = uv;
        gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
      }
    `,
    fragmentShader: `
      uniform sampler2D tDiffuse;
      uniform vec2 resolution;
      varying vec2 vUv;

      void main() {
        vec2 texel = vec2(1.0 / resolution.x, 1.0 / resolution.y);

        // Sample original for alpha
        vec4 original = texture2D(tDiffuse, vUv);

        // If fully transparent, discard (keep background visible)
        if (original.a < 0.01) {
          discard;
        }

        // Sobel kernels
        float Gx00 = texture2D(tDiffuse, vUv + texel * vec2(-1, 1)).r;
        float Gx01 = texture2D(tDiffuse, vUv + texel * vec2(-1, 0)).r * 2.0;
        float Gx02 = texture2D(tDiffuse, vUv + texel * vec2(-1, -1)).r;
        float Gx10 = texture2D(tDiffuse, vUv + texel * vec2(1, 1)).r;
        float Gx11 = texture2D(tDiffuse, vUv + texel * vec2(1, 0)).r * 2.0;
        float Gx12 = texture2D(tDiffuse, vUv + texel * vec2(1, -1)).r;

        float Gy00 = texture2D(tDiffuse, vUv + texel * vec2(-1, 1)).r;
        float Gy01 = texture2D(tDiffuse, vUv + texel * vec2(0, 1)).r * 2.0;
        float Gy02 = texture2D(tDiffuse, vUv + texel * vec2(1, 1)).r;
        float Gy10 = texture2D(tDiffuse, vUv + texel * vec2(-1, -1)).r;
        float Gy11 = texture2D(tDiffuse, vUv + texel * vec2(0, -1)).r * 2.0;
        float Gy12 = texture2D(tDiffuse, vUv + texel * vec2(1, -1)).r;

        float Gx = Gx00 - Gx02 + Gx10 - Gx12 + Gx01 - Gx11;
        float Gy = Gy00 - Gy10 + Gy02 - Gy12 + Gy01 - Gy11;

        float G = sqrt(Gx * Gx + Gy * Gy);

        // Amplify edges for stronger vertex visibility
        G = clamp(G * 2.5, 0.0, 1.0);

        // Blend Sobel edges with original color, preserve original alpha
        vec3 edgeColor = vec3(G);
        vec3 blendedColor = mix(original.rgb, original.rgb + edgeColor * 0.8, 0.75);

        gl_FragColor = vec4(blendedColor, original.a);
      }
    `
  };

  // Throttle for mouse raycasting (~30fps = 33ms)
  let lastRaycastTime = 0;
  const RAYCAST_THROTTLE_MS = 33;
  let pendingMousePosition: { x: number; y: number } | null = null;

  // Initialize scene
  function initScene() {
    scene = new THREE.Scene();
    // Transparent background for layering with particles
    scene.background = null;

    camera = new THREE.PerspectiveCamera(75, aspectRatio, 0.1, 1000);

    // Disable antialiasing on large viewports for performance
    const isLargeViewport = width > 1920 || height > 1080;

    renderer = new THREE.WebGLRenderer({
      antialias: !isLargeViewport,
      powerPreference: "high-performance",
      precision: "mediump",
      alpha: true, // Enable alpha for transparent background
    });

    renderer.setClearColor(0x000000, 0); // Transparent clear
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.BasicShadowMap;

    if (modelContainer) {
      const existingCanvas = modelContainer.querySelector("canvas");
      if (existingCanvas) {
        modelContainer.removeChild(existingCanvas);
      }
      modelContainer.appendChild(renderer.domElement);
    }

    // Camera position - pulled back significantly for full robot view
    camera.position.set(0, 4, 35);

    // Add OrbitControls with limitations
    controls = new OrbitControls(camera, renderer.domElement);
    controls.target = new THREE.Vector3(0, 1.5, 0);

    // Allow full horizontal rotation
    controls.enableRotate = true;
    controls.minAzimuthAngle = -Infinity;
    controls.maxAzimuthAngle = Infinity;

    // Restrict vertical rotation
    controls.minPolarAngle = Math.PI / 2 - 0.5; // ~29 degrees up
    controls.maxPolarAngle = Math.PI / 2 + 0.4; // ~23 degrees down

    // Disable panning
    controls.enablePan = false;

    // Disable zoom to allow page scrolling
    controls.enableZoom = false;

    // Limit zoom - adjusted for new camera distance (kept for reference if re-enabled)
    controls.minDistance = 25.0;
    controls.maxDistance = 50.0;

    // Add damping for smoother controls
    controls.enableDamping = true;
    controls.dampingFactor = 0.05;

    // ===== DRAMATIC LIGHTING SETUP FOR METALLIC MATERIAL =====

    // Ambient light - slightly higher for metallic reflections
    // Shared lighting rig — see src/scripts/robotLightRig.ts. This viewer
    // frames the model further out than the others, so the rig positions are
    // scaled to match rather than re-tuned by hand.
    const { spotlight, cyanAccent, magentaAccent } = createRobotLightRig(scene, {
      exposure: ROBOT_EXPOSURE.contact,
      scale: 1.6,
    });
    spotlightBase = spotlight?.intensity ?? 0;
    magentaBase = magentaAccent.intensity;

    mousePointLight = new THREE.PointLight(0xff8800, 0, 100, 0.8);
    mousePointLight.position.set(0, 5, 20);
    scene.add(mousePointLight);

    // Hemisphere light for ambient distribution
    hemisphereLight = new THREE.HemisphereLight(0xffaa44, 0x442200, 0);
    scene.add(hemisphereLight);

    // ===== GRADIENT LIGHTING (YELLOW -> ORANGE -> RED) =====
    // Yellow light - top position
    const yellowLight = new THREE.PointLight(0xffee00, 0, 80, 1.0);
    yellowLight.position.set(0, 10, 20);
    scene.add(yellowLight);

    // Red light - bottom position
    const redLight = new THREE.PointLight(0xff2200, 0, 80, 1.0);
    redLight.position.set(0, 0, 20);
    scene.add(redLight);

    // Initialize raycaster
    raycaster = new THREE.Raycaster();
    mouseVector = new THREE.Vector2();

    // Store lights for animation
    animatedLights = {
      spotlight,
      cyanAccent,
      magentaAccent,
      mousePointLight,
      yellowLight,
      redLight
    };

    // ===== POST-PROCESSING SETUP =====
    // Create render target with alpha channel for proper transparency
    const renderTarget = new THREE.WebGLRenderTarget(
      width * Math.min(window.devicePixelRatio, 2),
      height * Math.min(window.devicePixelRatio, 2),
      {
        format: THREE.RGBAFormat,
        type: THREE.UnsignedByteType,
      }
    );

    composer = new EffectComposer(renderer, renderTarget);

    const renderPass = new RenderPass(scene, camera);
    renderPass.clearAlpha = 0;
    composer.addPass(renderPass);

    const sobelPass = new ShaderPass(SobelAlphaShader);
    sobelPass.uniforms['resolution'].value.x = width * Math.min(window.devicePixelRatio, 2);
    sobelPass.uniforms['resolution'].value.y = height * Math.min(window.devicePixelRatio, 2);
    composer.addPass(sobelPass);
  }

  let _disposing = false;

  // Handle window resize
  function handleResize() {
    if (_disposing) return;

    const {
      width: newWidth,
      height: newHeight,
      aspectRatio: newAspectRatio,
    } = getContainerSize();

    // Guard against zero dimensions (happens during View Transitions)
    if (!newWidth || !newHeight) return;

    width = newWidth;
    height = newHeight;
    aspectRatio = newAspectRatio;

    camera.aspect = aspectRatio;
    camera.updateProjectionMatrix();

    const pixelRatio = Math.min(window.devicePixelRatio, 2);

    renderer.setSize(width, height);
    renderer.setPixelRatio(pixelRatio);

    // Update composer and Sobel pass resolution
    composer.setSize(width, height);
    const sobelPass = composer.passes[1] as ShaderPass;
    if (sobelPass && sobelPass.uniforms['resolution']) {
      sobelPass.uniforms['resolution'].value.x = width * pixelRatio;
      sobelPass.uniforms['resolution'].value.y = height * pixelRatio;
    }

    composer.render();
  }

  let currentCleanup: (() => void) | null = null;
  let eventAbort: AbortController | null = null;
  let dracoLoader: DRACOLoader | null = null;
  let loadedGeometries: THREE.BufferGeometry[] = [];
  let loadedMaterials: THREE.Material[] = [];

  // Initialize everything
  function init() {
    if (currentCleanup) { currentCleanup(); currentCleanup = null; }
    // Abort previous document-level event listeners to prevent accumulation
    eventAbort?.abort();
    eventAbort = new AbortController();

    // Re-query DOM elements (fresh references after View Transition swap)
    container = document.querySelector(".contact-robot-viewer-container");
    modelContainer = document.getElementById("contact-robot-container");
    progressBar = document.getElementById("contact-progress-bar");
    loadingContainer = modelContainer?.querySelector(".loading-container");

    if (!container || !modelContainer) return;


    ({ width, height, aspectRatio } = getContainerSize());
    if (!width || !height) return;

    _disposing = false;
    clock = new THREE.Clock();

    initScene();

    // Loading manager
    const manager = new THREE.LoadingManager();

    manager.onProgress = (_url, loaded, total) => {
      if (progressBar instanceof HTMLProgressElement) {
        progressBar.value = (loaded / total) * 100;
      }
    };

    manager.onLoad = () => {
      if (loadingContainer instanceof HTMLElement) {
        loadingContainer.style.display = "none";
      }
    };

    // Configure Draco loader
    dracoLoader = new DRACOLoader();
    dracoLoader.setDecoderPath('https://www.gstatic.com/draco/versioned/decoders/1.5.7/');
    dracoLoader.preload();

    // Load walking robot model
    const loader = new GLTFLoader(manager);
    loader.setDRACOLoader(dracoLoader);
    loadedGeometries = [];
    loadedMaterials = [];
    loader.load(
      "/models/walking_robot.glb",
      async (glb) => {
        if (_disposing) return;
        _robot = glb.scene;

        // Create material with customized properties (matching other robot viewers)
        const newMaterial = new THREE.MeshPhongMaterial({
          color: new THREE.Color("#000000"),
          emissive: new THREE.Color("#000000"),
          specular: new THREE.Color("#ffffff"),
          shininess: 15,
          flatShading: true,
        });
        loadedMaterials.push(newMaterial);

        // Apply material to all meshes in the model
        _robot.traverse((o) => {
          if (o instanceof THREE.Mesh) {
            loadedGeometries.push(o.geometry);
            o.material = newMaterial;
            o.castShadow = true;
            o.receiveShadow = true;
          }
        });

        // Position and scale the robot - adjusted for new camera distance
        _robot.position.set(0, 0, 0);
        _robot.scale.set(1.5, 1.5, 1.5);

        scene.add(_robot);

        // Set up animation
        _mixerRobot = new THREE.AnimationMixer(_robot);
        _mixerRobot.timeScale = 1.0; // Normal walking speed

        if (glb.animations.length > 0) {
          const action = _mixerRobot.clipAction(glb.animations[0]);
          action.play();
        }
      },
      undefined,
      (error) => {
        console.error("Error loading walking robot model:", error);
      }
    );

    // Animation loop
    let _animationId: number;
    let _loopRunning = false;
    function animate() {
      if (_disposing) return;
      if (!_loopRunning) return;
      _animationId = requestAnimationFrame(animate);

      const delta = clock.getDelta();
      const elapsed = clock.getElapsedTime();

      if (_mixerRobot) {
        _mixerRobot.update(delta);
      }

      // Subtle constant rotation of the robot
      if (_robot) {
        _robot.rotation.y += 0.002;
      }

      // Animate lights for subtle dramatic effect
      if (animatedLights) {
        // Subtle pulse spotlight intensity
        // Pulse around the rig's own exposure-scaled intensity rather than a
        // hardcoded value, so the per-page exposure actually reaches this light.
        if (animatedLights.spotlight) {
          animatedLights.spotlight.intensity =
            spotlightBase * (1 + Math.sin(elapsed * 0.8) * 0.33);
        }

        // Slowly rotate cyan accent (larger orbit for bigger scene)
        const cyanAngle = elapsed * 0.2;
        animatedLights.cyanAccent.position.x = Math.cos(cyanAngle) * 6;
        animatedLights.cyanAccent.position.z = Math.sin(cyanAngle) * 6;

        // Subtle pulse magenta accent
        // Pulse around the rig's exposure-scaled value, like the spotlight —
        // a hardcoded intensity here would silently override the per-page
        // exposure and reintroduce the drift the shared rig removed.
        animatedLights.magentaAccent.intensity =
          magentaBase * (1 + Math.sin(elapsed * 1.2) * 0.4);
      }

      if (controls) {
        controls.update();
      }

      // Process pending mouse position
      if (pendingMousePosition) {
        performRaycastUpdate(pendingMousePosition.x, pendingMousePosition.y);
        pendingMousePosition = null;
        lastRaycastTime = performance.now();
      }

      composer.render();
    }

    // Only render while the canvas is actually on screen. These heroes sit
    // above long pages, so without this the scene kept running a full
    // composer pass every frame — model, lights and a Sobel post-process —
    // the entire time the reader was scrolled past it.
    function startLoop() {
      if (_loopRunning || _disposing) return;
      _loopRunning = true;
      // Discard the time accumulated while paused, otherwise the first frame
      // back gets a delta of however long the viewer was off screen and the
      // animation jumps.
      clock.getDelta();
      _animationId = requestAnimationFrame(animate);
    }

    function stopLoop() {
      _loopRunning = false;
      if (_animationId) cancelAnimationFrame(_animationId);
    }

    // rootMargin gives the loop a head start so the model is already moving
    // by the time it scrolls into view.
    visibilityObserver = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) startLoop();
        else stopLoop();
      },
      { rootMargin: '200px' }
    );
    if (container) visibilityObserver.observe(container);
    startLoop();

    // Add resize listener
    window.addEventListener("resize", handleResize);

    const resizeObserver = new ResizeObserver(() => {
      handleResize();
    });

    if (container) {
      resizeObserver.observe(container);
    }

    // Store cleanup function (called on navigation or re-init)
    currentCleanup = () => {
      _disposing = true;
      cancelAnimationFrame(_animationId);
      visibilityObserver?.disconnect();
      visibilityObserver = null;
      resizeObserver.disconnect();
      window.removeEventListener('resize', handleResize);
      loadedGeometries.forEach((g) => g.dispose());
      loadedMaterials.forEach((m) => m.dispose());
      loadedGeometries = [];
      loadedMaterials = [];
      dracoLoader?.dispose();
      dracoLoader = null;
      composer?.dispose();
      renderer.dispose();
      if (renderer.getContext()) {
        renderer.forceContextLoss();
      }
      renderer.domElement?.parentNode?.removeChild(renderer.domElement);
      controls?.dispose();
    };

    // ===== RAYCASTING FOR MOUSE-REACTIVE LIGHTING =====
    function performRaycastUpdate(x: number, y: number) {
      if (!mousePointLight || !hemisphereLight || !raycaster || !mouseVector || !camera || !_robot || !animatedLights) return;

      mouseVector.x = (x * 2) - 1;
      mouseVector.y = -(y * 2) + 1;

      raycaster.setFromCamera(mouseVector, camera);

      const intersects = raycaster.intersectObject(_robot, true);

      let distance = 25.0;
      let intensityMultiplier = 1.0;
      const robotCenter = new THREE.Vector3(0, 2.0, 0);

      if (intersects.length > 0) {
        const intersectPoint = intersects[0].point;
        const distanceToIntersect = camera.position.distanceTo(intersectPoint);

        distance = distanceToIntersect * 0.3;

        const distanceFromCenter = intersectPoint.distanceTo(robotCenter);

        if (distanceFromCenter < 0.8) {
          intensityMultiplier = 2.0;
        } else if (distanceFromCenter < 1.2) {
          intensityMultiplier = 1.0 + (1.0 - (distanceFromCenter - 0.8) / 0.4);
        }
      }

      const targetPosition = new THREE.Vector3();
      targetPosition.copy(raycaster.ray.direction);
      targetPosition.multiplyScalar(distance);
      targetPosition.add(raycaster.ray.origin);

      lightPosition.lerp(targetPosition, 0.25);
      mousePointLight.position.copy(lightPosition);

      // Update gradient light positions to follow mouse (offset vertically)
      if (animatedLights.yellowLight) {
        animatedLights.yellowLight.position.x = lightPosition.x;
        animatedLights.yellowLight.position.y = lightPosition.y + 1.2;
        animatedLights.yellowLight.position.z = lightPosition.z;
      }
      if (animatedLights.redLight) {
        animatedLights.redLight.position.x = lightPosition.x;
        animatedLights.redLight.position.y = lightPosition.y - 1.0;
        animatedLights.redLight.position.z = lightPosition.z;
      }

      // Higher base intensity for larger scene distance
      const baseIntensity = 9.0;
      const targetIntensity = baseIntensity * intensityMultiplier;

      if (mousePointLight.intensity < targetIntensity) {
        mousePointLight.intensity += 1.2;
      }

      if (hemisphereLight.intensity < 0.9) {
        hemisphereLight.intensity += 0.06;
      }

      // Update gradient lights intensity
      const gradientTargetIntensity = 7.2 * intensityMultiplier;
      if (animatedLights.yellowLight && animatedLights.yellowLight.intensity < gradientTargetIntensity) {
        animatedLights.yellowLight.intensity += 0.9;
      }
      if (animatedLights.redLight && animatedLights.redLight.intensity < gradientTargetIntensity) {
        animatedLights.redLight.intensity += 0.9;
      }
    }

    // Listen for contact page mouse events
    // Scoped to eventAbort's signal so listeners don't accumulate across navigations.
    const { signal } = eventAbort!;
    document.addEventListener('contactRobotMouseMove', (e: any) => {
      if (e.detail && mousePointLight && hemisphereLight && raycaster && mouseVector && camera && _robot) {
        const { x, y } = e.detail;
        const now = performance.now();

        if (now - lastRaycastTime < RAYCAST_THROTTLE_MS) {
          pendingMousePosition = { x, y };
          return;
        }

        lastRaycastTime = now;
        pendingMousePosition = null;
        performRaycastUpdate(x, y);
      }
    }, { signal });

    // Fade out on inactivity
    document.addEventListener('contactRobotMouseInactive', () => {
      if (mousePointLight && hemisphereLight && animatedLights) {
        const fadeOut = () => {
          if (mousePointLight && hemisphereLight && animatedLights) {
            const stillFading = mousePointLight.intensity > 0.06 || hemisphereLight.intensity > 0.006 ||
              (animatedLights.yellowLight && animatedLights.yellowLight.intensity > 0.06) ||
              (animatedLights.redLight && animatedLights.redLight.intensity > 0.06);

            if (stillFading) {
              mousePointLight.intensity *= 0.92;
              hemisphereLight.intensity *= 0.92;
              if (animatedLights.yellowLight) animatedLights.yellowLight.intensity *= 0.92;
              if (animatedLights.redLight) animatedLights.redLight.intensity *= 0.92;
              requestAnimationFrame(fadeOut);
            } else {
              mousePointLight.intensity = 0;
              hemisphereLight.intensity = 0;
              if (animatedLights.yellowLight) animatedLights.yellowLight.intensity = 0;
              if (animatedLights.redLight) animatedLights.redLight.intensity = 0;
            }
          }
        };
        fadeOut();
      }
    }, { signal });

    // Fade out on mouse leave
    document.addEventListener('contactRobotMouseLeave', () => {
      if (mousePointLight && hemisphereLight && animatedLights) {
        const fadeOut = () => {
          if (mousePointLight && hemisphereLight && animatedLights) {
            const stillFading = mousePointLight.intensity > 0.03 || hemisphereLight.intensity > 0.006 ||
              (animatedLights.yellowLight && animatedLights.yellowLight.intensity > 0.03) ||
              (animatedLights.redLight && animatedLights.redLight.intensity > 0.03);

            if (stillFading) {
              mousePointLight.intensity *= 0.88;
              hemisphereLight.intensity *= 0.88;
              if (animatedLights.yellowLight) animatedLights.yellowLight.intensity *= 0.88;
              if (animatedLights.redLight) animatedLights.redLight.intensity *= 0.88;
              requestAnimationFrame(fadeOut);
            } else {
              mousePointLight.intensity = 0;
              hemisphereLight.intensity = 0;
              if (animatedLights.yellowLight) animatedLights.yellowLight.intensity = 0;
              if (animatedLights.redLight) animatedLights.redLight.intensity = 0;
            }
          }
        };
        fadeOut();
      }
    }, { signal });

    // Reset on mouse enter
    document.addEventListener('contactRobotMouseEnter', () => {
      if (mousePointLight && hemisphereLight && animatedLights) {
        mousePointLight.intensity = 0;
        hemisphereLight.intensity = 0;
        if (animatedLights.yellowLight) animatedLights.yellowLight.intensity = 0;
        if (animatedLights.redLight) animatedLights.redLight.intensity = 0;
      }
    }, { signal });
  }

  // Initialize on page load (supports View Transitions)
  // Guarded: this component's script is inlined into the bundle of every page
  // that uses it, so it re-executes on navigation and would otherwise stack up
  // an extra init() — and an extra WebGL context — per route visited.
  bindOnce('contact-robot-viewer', () => {
    onPageReady(init);
    document.addEventListener("astro:before-swap", () => {
      eventAbort?.abort();
      eventAbort = null;
      if (currentCleanup) { currentCleanup(); currentCleanup = null; }
    });
  });
</script>

<style>
  .contact-robot-viewer-container {
    display: flex;
    height: var(--height, 100%);
    width: var(--width, 100%);
    position: relative;
  }

  #contact-robot-container {
    width: 100%;
    height: 100%;
    position: relative;
  }

  #contact-robot-container canvas {
    width: 100% !important;
    height: 100% !important;
    display: block;
  }

  .model-display-container {
    overflow: hidden;
    background: transparent;
    z-index: 10;
    width: 100%;
    height: 100%;
  }

  .loading-container {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    text-align: center;
    z-index: 20;
  }

  #contact-progress-bar {
    width: 80%;
    height: 8px;
    border-radius: 4px;
