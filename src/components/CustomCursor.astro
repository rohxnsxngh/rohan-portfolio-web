---
// Custom Cursor Component with Pixelated Hieroglyphic Trail Effect
---

<div id="custom-cursor">
  <div id="cursor-dot"></div>
  <div id="cursor-outline"></div>
  <canvas id="cursor-canvas"></canvas>
  <div id="cursor-label"></div>
</div>

<!-- All cursor styles are global. Astro scopes selectors to a data-astro-cid attribute,
     but `transition:persist` moves this element across pages where the cid may transiently
     not match the freshly-injected style block — that race is what causes the cursor to
     disappear and the system cursor to return. IDs are unique to this component, so
     scoping was unnecessary anyway. -->
<style is:global>
  #custom-cursor {
    pointer-events: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 9999;
  }

  /* Anchored at the viewport origin and positioned by the script through the
     individual `translate` property, which composites. */
  #cursor-dot,
  #cursor-outline,
  #cursor-label {
    top: 0;
    left: 0;
  }

  #cursor-dot {
    position: fixed;
    width: 4px;
    height: 4px;
    background-color: #FFFFFF;
    transform: translate(-50%, -50%);
    z-index: 10001;
    transition: width 0.2s ease, height 0.2s ease;
    mix-blend-mode: difference;
    opacity: 0;
    visibility: hidden;
  }

  #cursor-outline {
    position: fixed;
    width: 28px;
    height: 28px;
    border: 1px solid rgba(255, 255, 255, 0.4);
    transform: translate(-50%, -50%) rotate(45deg);
    z-index: 10000;
    transition: width 0.3s ease, height 0.3s ease, border-color 0.3s ease, transform 0.3s ease, opacity 0.3s ease, border-width 0.3s ease;
    mix-blend-mode: difference;
    opacity: 0;
    visibility: hidden;
  }

  /* Show cursor elements once mouse has moved */
  #cursor-dot.cursor-initialized,
  #cursor-outline.cursor-initialized {
    opacity: 1;
    visibility: visible;
  }

  #cursor-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 9999;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }

  #cursor-label {
    position: fixed;
    transform: translate(-50%, calc(-50% + 30px));
    z-index: 10002;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 9px;
    font-weight: 600;
    color: #ffffff;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 3px 8px;
    background: rgba(0, 0, 0, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.2);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s ease;
    white-space: nowrap;
  }

  #cursor-label.visible {
    opacity: 1;
  }

  /* Hover/click states — body classes are toggled by the script, and now match
     because the rule isn't scoped to CustomCursor's cid. */
  body.cursor-hover #cursor-outline {
    width: 64px;
    height: 64px;
    border-color: rgba(255, 255, 255, 0.9);
    border-width: 2px;
    transform: translate(-50%, -50%) rotate(45deg) scale(1.15);
    opacity: 0.5;
    box-shadow: 0 0 20px rgba(255, 255, 255, 0.3);
  }

  body.cursor-hover #cursor-dot {
    width: 6px;
    height: 6px;
    opacity: 0.8;
  }

  body.cursor-click #cursor-outline {
    width: 20px;
    height: 20px;
    border-width: 2px;
    transform: translate(-50%, -50%) rotate(45deg) scale(0.9);
  }

  body.cursor-click #cursor-dot {
    width: 8px;
    height: 8px;
  }

  /* Press-target state — hovering over [data-cursor-press] elements
     (currently the 3D model viewers). Distinct from cursor-hover: filled
     center hints "click and hold to play". */
  body.cursor-press #cursor-outline {
    width: 56px;
    height: 56px;
    border-color: rgba(255, 255, 255, 1);
    border-width: 2px;
    background: rgba(255, 255, 255, 0.06);
    transform: translate(-50%, -50%) rotate(45deg) scale(1.1);
    opacity: 0.85;
    box-shadow: 0 0 20px rgba(255, 255, 255, 0.25);
  }

  body.cursor-press #cursor-dot {
    width: 6px;
    height: 6px;
    opacity: 1;
  }

  /* Hide system cursor globally on desktop */
  @media (hover: hover) and (pointer: fine) {
    *,
    *::before,
    *::after,
    body,
    body *,
    a,
    a *,
    button,
    button *,
    [role="button"],
    input,
    textarea,
    select,
    *:hover,
    *:active,
    *:focus,
    *:link,
    *:visited {
      cursor: none !important;
    }
  }

  /* Restore cursor on mobile */
  @media (hover: none) and (pointer: coarse) {
    #custom-cursor {
      display: none !important;
    }

    body,
    body *,
    body *:hover,
    body *:active,
    body *:focus {
      cursor: auto !important;
    }
  }
</style>

<script>
  // Check if device is mobile
  const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent)
    || (window.matchMedia && window.matchMedia('(hover: none) and (pointer: coarse)').matches);

  // This component sits in the layout, so Astro inlines its script into every
  // page's hoisted bundle. Navigating to a route whose bundle has not run yet
  // re-executes it — which used to start another rAF trail loop and another
  // full set of document listeners drawing into the same canvas, once per
  // route visited. The cursor element itself is transition:persist'ed, so the
  // first initialisation stays valid; later copies must stand down.
  const alreadyBound = !!(window as any).__cursorBound;
  (window as any).__cursorBound = true;

  if (alreadyBound) {
    // Already initialised by an earlier page bundle — nothing to do.
  } else if (isMobile) {
    const customCursor = document.getElementById('custom-cursor');
    if (customCursor) {
      customCursor.style.display = 'none';
    }
  } else {
    // Cursor state
    let mouseX = 0;
    let mouseY = 0;
    let cursorX = 0;
    let cursorY = 0;
    let outlineX = 0;
    let outlineY = 0;
    let isInitialized = false;

    // Refs are MUTABLE — view transitions can swap the cursor element, in which
    // case the references below need to be re-pointed at the fresh DOM nodes.
    let dot = document.getElementById('cursor-dot');
    let outline = document.getElementById('cursor-outline');
    let canvas = document.getElementById('cursor-canvas') as HTMLCanvasElement | null;
    let ctx = canvas?.getContext('2d') ?? null;
    let cursorLabel = document.getElementById('cursor-label');

  // Pixelated block system
  interface PixelBlock {
    x: number;
    y: number;
    size: number;
    life: number;
    maxLife: number;
    type: 'solid' | 'hollow' | 'dot';
  }

  const pixelBlocks: PixelBlock[] = [];
  let lastPixelTime = 0;
  let velocity = { x: 0, y: 0 };
  let lastMouseX = 0;
  let lastMouseY = 0;

  // Setup canvas. The backing store is sized in device pixels and the context
  // scaled back to CSS pixels, otherwise the trail is upsampled and blurry on
  // a retina screen. Capped at 2: the blocks are 4-6px squares and a 3x store
  // only costs fill rate.
  let dpr = 1;
  function resizeCanvas() {
    if (!canvas || !ctx) return;
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = Math.round(window.innerWidth * dpr);
    canvas.height = Math.round(window.innerHeight * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  resizeCanvas();
  window.addEventListener('resize', resizeCanvas);

  // Add pixelated block
  function addPixelBlock(x: number, y: number) {
    const types: Array<'solid' | 'hollow' | 'dot'> = ['solid', 'hollow', 'dot'];
    pixelBlocks.push({
      x: x + (Math.random() - 0.5) * 20,
      y: y + (Math.random() - 0.5) * 20,
      size: 4 + Math.floor(Math.random() * 2) * 2, // Pixelated sizes: 4, 6
      life: 1,
      maxLife: 1,
      type: types[Math.floor(Math.random() * types.length)]
    });

    // Limit blocks
    if (pixelBlocks.length > 25) {
      pixelBlocks.shift();
    }
    wake();
  }

  // Positions go through the individual `translate` property rather than
  // left/top. left/top is layout, so writing it every frame invalidated layout
  // for the whole fixed layer; `translate` is composited, and it stacks in
  // front of each element's own `transform` (the -50% centring, the 45deg
  // rotation and its hover scale) without touching it or its transition.
  function place(el: HTMLElement | null, x: number, y: number) {
    if (el) el.style.translate = `${x}px ${y}px`;
  }

  // Mouse movement
  document.addEventListener('mousemove', (e) => {
    mouseX = e.clientX;
    mouseY = e.clientY;

    // On first mouse move, initialize cursor position immediately (no animation from 0,0)
    if (!isInitialized) {
      isInitialized = true;
      cursorX = mouseX;
      cursorY = mouseY;
      outlineX = mouseX;
      outlineY = mouseY;
      lastMouseX = mouseX;
      lastMouseY = mouseY;

      place(dot, cursorX, cursorY);
      place(outline, outlineX, outlineY);
      place(cursorLabel, outlineX, outlineY);

      // Show cursor elements now that we have the correct position
      if (dot) dot.classList.add('cursor-initialized');
      if (outline) outline.classList.add('cursor-initialized');
      return;
    }

    // Calculate velocity
    velocity.x = mouseX - lastMouseX;
    velocity.y = mouseY - lastMouseY;
    lastMouseX = mouseX;
    lastMouseY = mouseY;

    const speed = Math.sqrt(velocity.x ** 2 + velocity.y ** 2);
    const now = Date.now();

    // Add pixel blocks
    if (speed > 2 && now - lastPixelTime > 50) {
      addPixelBlock(mouseX, mouseY);
      lastPixelTime = now;
    }

    // On fast movement, spawn more pixel blocks
    if (speed > 20) {
      for (let i = 0; i < 2; i++) {
        addPixelBlock(mouseX, mouseY);
      }
    }

    wake();
  });

  // Interactive elements
  const interactiveElements = 'a, button, [role="button"], input, textarea, select, .cursor-hover';

  document.addEventListener('mouseover', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest(interactiveElements)) {
      document.body.classList.add('cursor-hover');
    }
    // Cursor label on data-cursor-label elements
    const labelTarget = target.closest('[data-cursor-label]') as HTMLElement | null;
    if (labelTarget && cursorLabel) {
      cursorLabel.textContent = labelTarget.getAttribute('data-cursor-label') || '';
      cursorLabel.classList.add('visible');
    }
    // Press-target state for 3D model viewers
    if (target.closest('[data-cursor-press]')) {
      document.body.classList.add('cursor-press');
    }
  });

  document.addEventListener('mouseout', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest(interactiveElements)) {
      document.body.classList.remove('cursor-hover');
    }
    if (target.closest('[data-cursor-label]') && cursorLabel) {
      cursorLabel.classList.remove('visible');
    }
    if (target.closest('[data-cursor-press]')) {
      document.body.classList.remove('cursor-press');
    }
  });

  document.addEventListener('mousedown', () => {
    document.body.classList.add('cursor-click');

    // Add pixel blocks burst
    for (let i = 0; i < 6; i++) {
      setTimeout(() => addPixelBlock(mouseX, mouseY), i * 15);
    }
  });

  document.addEventListener('mouseup', () => {
    document.body.classList.remove('cursor-click');
  });

  // Easing rates, per second. The old per-frame factors (0.15 for the dot,
  // 0.1 for the outline) were tuned at 60 Hz and ran twice as fast on a 120 Hz
  // display; these are the same feel expressed against elapsed time, so
  // 1 - exp(-rate * dt) reproduces 0.15 and 0.1 at exactly 60 fps.
  const DOT_RATE = 9.75;
  const OUTLINE_RATE = 6.3;
  // Block life drained per second (0.025 a frame at 60 fps).
  const LIFE_RATE = 1.5;
  // Below this the followers are visually on the pointer.
  const SETTLE_PX = 0.1;

  let rafId = 0;
  let lastTime = 0;
  // Whether the previous frame left anything on the canvas, so an idle frame
  // does not clear an already empty store.
  let canvasDirty = false;

  // The loop sleeps once the dot and outline have caught the pointer and the
  // trail has faded. A still mouse used to keep a full-viewport clearRect and
  // three style writes running every frame for the life of the tab.
  function wake() {
    if (rafId || !isInitialized) return;
    lastTime = performance.now();
    rafId = requestAnimationFrame(animate);
  }

  function animate(now: number) {
    // Clamped so a frame after a long stall (a tab switch, a GC pause) eases
    // rather than teleports.
    const dt = Math.min(Math.max((now - lastTime) / 1000, 0), 0.1);
    lastTime = now;

    const kDot = 1 - Math.exp(-DOT_RATE * dt);
    const kOutline = 1 - Math.exp(-OUTLINE_RATE * dt);

    cursorX += (mouseX - cursorX) * kDot;
    cursorY += (mouseY - cursorY) * kDot;
    outlineX += (mouseX - outlineX) * kOutline;
    outlineY += (mouseY - outlineY) * kOutline;

    const settled =
      Math.abs(mouseX - cursorX) < SETTLE_PX && Math.abs(mouseY - cursorY) < SETTLE_PX &&
      Math.abs(mouseX - outlineX) < SETTLE_PX && Math.abs(mouseY - outlineY) < SETTLE_PX;

    if (settled) {
      cursorX = outlineX = mouseX;
      cursorY = outlineY = mouseY;
    }

    place(dot, cursorX, cursorY);
    place(outline, outlineX, outlineY);
    place(cursorLabel, outlineX, outlineY);

    // Draw canvas effects (pixelated blocks)
    // Capture into a const so TS can narrow inside the loop (ctx is `let`).
    const ctx2d = ctx;
    if (ctx2d && canvas) {
      if (canvasDirty) {
        ctx2d.clearRect(0, 0, window.innerWidth, window.innerHeight);
        canvasDirty = false;
      }

      ctx2d.fillStyle = '#FFFFFF';
      ctx2d.strokeStyle = '#FFFFFF';
      ctx2d.lineWidth = 1;

      // Backwards, so removing a dead block does not skip the one after it.
      for (let index = pixelBlocks.length - 1; index >= 0; index--) {
        const block = pixelBlocks[index];
        block.life -= LIFE_RATE * dt;

        if (block.life <= 0) {
          pixelBlocks.splice(index, 1);
          continue;
        }

        ctx2d.globalAlpha = block.life * 0.35;
        canvasDirty = true;

        const bx = Math.floor(block.x / block.size) * block.size;
        const by = Math.floor(block.y / block.size) * block.size;

        // Draw different block types
        if (block.type === 'solid') {
          ctx2d.fillRect(bx, by, block.size, block.size);
        } else if (block.type === 'hollow') {
          // A 1px stroke is centred on the path, so on whole coordinates it
          // straddles two pixel rows and renders as a soft 2px grey line. The
          // half-pixel offset puts it on one row.
          ctx2d.strokeRect(bx + 0.5, by + 0.5, block.size - 1, block.size - 1);
        } else if (block.type === 'dot') {
          ctx2d.fillRect(bx + block.size / 2 - 1, by + block.size / 2 - 1, 2, 2);
        }
      }

      ctx2d.globalAlpha = 1;
    } else {
      pixelBlocks.length = 0;
    }

    if (settled && pixelBlocks.length === 0 && !canvasDirty) {
      rafId = 0;
      return;
    }

    rafId = requestAnimationFrame(animate);
  }

  // Handle page visibility
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      pixelBlocks.length = 0;
    }
  });

  // After a view-transition swap, re-point refs at whatever cursor element is now
  // in the live DOM (persist may have moved the original, or — if the auto persist
  // key drifted — Astro may have rendered a fresh one). Re-apply the visible-state
  // class and inline positions so the cursor doesn't pop back to opacity:0.
  document.addEventListener('astro:after-swap', () => {
    dot = document.getElementById('cursor-dot');
    outline = document.getElementById('cursor-outline');
    canvas = document.getElementById('cursor-canvas') as HTMLCanvasElement | null;
    ctx = canvas?.getContext('2d') ?? null;
    cursorLabel = document.getElementById('cursor-label');

    resizeCanvas();
    canvasDirty = false;

    if (isInitialized) {
      if (dot) dot.classList.add('cursor-initialized');
      if (outline) outline.classList.add('cursor-initialized');
      place(dot, cursorX, cursorY);
      place(outline, outlineX, outlineY);
      place(cursorLabel, outlineX, outlineY);
    }

    // Body classes don't survive body replacement — clear stuck states.
    document.body.classList.remove('cursor-hover', 'cursor-click', 'cursor-press');

    // A card carrying [data-cursor-label] can be removed from the DOM by a
    // click-triggered navigation before its mouseout fires, leaving the label
    // (and the previous page's text) stuck visible on the persisted cursor root.
    cursorLabel?.classList.remove('visible');
    wake();
  });

  // Cursor will be shown on first mouse move via cursor-initialized class
  }
</script>
