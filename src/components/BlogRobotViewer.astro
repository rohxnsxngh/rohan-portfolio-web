---
// BlogRobotViewer.astro - Keyboard viewer for blog page with smooth transition
interface Props {
  width?: string;
  height?: string;
  className?: string;
}

const {
  width = "100%",
  height = "100%",
  className = "",
} = Astro.props;
---

<div
  class={`blog-robot-viewer-container group ${className}`}
  style={`--width: ${width}; --height: ${height};`}
>
  <!-- Grid overlay for texture -->
  <div class="grid-overlay"></div>

  <div id="blog-robot-container" class="robot-display" data-cursor-press>
    <div class="loading-container">
      <progress id="blog-progress-bar" value="0" max="100"></progress>
    </div>
  </div>
</div>

<script>
  import * as THREE from "three";
  import { GLTFLoader } from "three/examples/jsm/loaders/GLTFLoader.js";
  import { DRACOLoader } from "three/examples/jsm/loaders/DRACOLoader.js";
  import { OrbitControls } from "three/examples/jsm/controls/OrbitControls.js";
  import { EffectComposer } from "three/examples/jsm/postprocessing/EffectComposer.js";
  import { RenderPass } from "three/examples/jsm/postprocessing/RenderPass.js";
  import { ShaderPass } from "three/examples/jsm/postprocessing/ShaderPass.js";

  // DOM elements — re-queried in init() to survive View Transition DOM swaps
  let container: Element | null = null;
  let modelContainer: HTMLElement | null = null;
  let progressBar: HTMLElement | null = null;
  let loadingContainer: Element | null = null;

  const getContainerSize = () => {
    if (!container) return { width: 0, height: 0, aspectRatio: 1 };
    const rect = container.getBoundingClientRect();
    return {
      width: rect.width,
      height: rect.height,
      aspectRatio: rect.width / rect.height || 1,
    };
  };

  let width = 0;
  let height = 0;
  let aspectRatio = 1;

  let keyboard: THREE.Group;
  let mixer: THREE.AnimationMixer;
  // Hold-to-play state: mixer delta is scaled by playFactor (0 paused → 1 full).
  let playFactor = 0;
  let targetPlay = 0;
  const holdReleaseHandlers: { evt: string; fn: (e: Event) => void; target: EventTarget }[] = [];
  let animationAction: THREE.AnimationAction | null = null;
  let controls: OrbitControls;
  let camera: THREE.PerspectiveCamera;
  let renderer: THREE.WebGLRenderer;
  let scene: THREE.Scene;
  let clock = new THREE.Clock();
  let animatedLights: any;

  // Post-processing
  let composer: EffectComposer;
  let sobelPass: ShaderPass;

  // Mouse lighting system
  let mousePointLight: THREE.PointLight | null = null;
  let hemisphereLight: THREE.HemisphereLight | null = null;
  let raycaster: THREE.Raycaster | null = null;
  let mouseVector: THREE.Vector2 | null = null;
  let lightPosition: THREE.Vector3 = new THREE.Vector3();
  let isMouseOver = false;

  // Throttle for mouse raycasting (~30fps = 33ms)
  let lastRaycastTime = 0;
  const RAYCAST_THROTTLE_MS = 33;
  let pendingMousePosition: { x: number; y: number } | null = null;

  function initScene() {
    scene = new THREE.Scene();
    // Transparent background to allow particle effect to show through
    scene.background = null;

    camera = new THREE.PerspectiveCamera(45, aspectRatio, 0.1, 1000);

    // Disable antialiasing on large viewports (>1080p) for performance
    const isLargeViewport = width > 1920 || height > 1080;

    renderer = new THREE.WebGLRenderer({
      antialias: !isLargeViewport, // Disable AA on large screens
      powerPreference: "high-performance",
      precision: "mediump", // Medium precision is sufficient and faster
      alpha: true, // Enable transparency
    });

    // Set clear color to transparent
    renderer.setClearColor(0x000000, 0);

    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.BasicShadowMap; // Faster than PCFSoftShadowMap

    if (modelContainer) {
      const existingCanvas = modelContainer.querySelector("canvas");
      if (existingCanvas) modelContainer.removeChild(existingCanvas);
      modelContainer.appendChild(renderer.domElement);
    }

    // Camera positioned to view keyboard from above-front angle
    camera.position.set(0, 3, 5);
    camera.lookAt(0, 0, 0);

    // OrbitControls for user interaction - very limited rotation for keyboard
    controls = new OrbitControls(camera, renderer.domElement);
    controls.target = new THREE.Vector3(0, 0, 0);
    controls.enableRotate = true;

    // Restrict horizontal rotation to ±25 degrees
    controls.minAzimuthAngle = -Math.PI / 7.2; // -25 degrees
    controls.maxAzimuthAngle = Math.PI / 7.2;  // +25 degrees

    // Restrict vertical rotation to ±10 degrees (viewing from above)
    controls.minPolarAngle = Math.PI / 3 - 0.17; // About 10 degrees up
    controls.maxPolarAngle = Math.PI / 3 + 0.17; // About 10 degrees down

    // Disable panning and zooming for minimal interaction
    controls.enablePan = false;
    controls.enableZoom = false;

    controls.enableDamping = true;
    controls.dampingFactor = 0.08;

    // Balanced lighting - visible base with mouse enhancement
    const ambientLight = new THREE.AmbientLight(0x404040, 0.18);
    scene.add(ambientLight);

    const mainLight = new THREE.DirectionalLight(0xffffff, 0.48);
    mainLight.position.set(3, 5, 4);
    mainLight.castShadow = true;
    scene.add(mainLight);

    const fillLight = new THREE.DirectionalLight(0x8899ff, 0.24);
    fillLight.position.set(-3, 2, 2);
    scene.add(fillLight);

    const rimLight = new THREE.DirectionalLight(0xffffff, 0.3);
    rimLight.position.set(0, 3, -5);
    scene.add(rimLight);

    // Subtle colored accent lights
    const cyanAccent = new THREE.PointLight(0x00ffff, 0.36, 10);
    cyanAccent.position.set(-2, 1, 3);
    scene.add(cyanAccent);

    const magentaAccent = new THREE.PointLight(0xff00ff, 0.3, 10);
    magentaAccent.position.set(2, 0.5, -2);
    scene.add(magentaAccent);

    // GRADIENT LIGHTING: Yellow (top) -> Orange (center) -> Red (bottom)
    const yellowLight = new THREE.PointLight(0xffee00, 0, 25, 1.2);
    yellowLight.position.set(0, 6, 5);
    scene.add(yellowLight);

    mousePointLight = new THREE.PointLight(0xff8800, 0, 30, 1.0);
    mousePointLight.position.set(0, 5, 5);
    scene.add(mousePointLight);

    const redLight = new THREE.PointLight(0xff2200, 0, 25, 1.2);
    redLight.position.set(0, 4, 5);
    scene.add(redLight);

    hemisphereLight = new THREE.HemisphereLight(0xffcc44, 0x661100, 0);
    scene.add(hemisphereLight);

    // Initialize raycaster for mouse-to-3D mapping
    raycaster = new THREE.Raycaster();
    mouseVector = new THREE.Vector2();

    // Store lights for animation
    animatedLights = {
      yellowLight,
      redLight
    };

    // Set up Sobel post-processing with alpha preservation
    const renderTarget = new THREE.WebGLRenderTarget(
      width * window.devicePixelRatio,
      height * window.devicePixelRatio,
      { format: THREE.RGBAFormat, type: THREE.UnsignedByteType }
    );

    composer = new EffectComposer(renderer, renderTarget);

    const renderPass = new RenderPass(scene, camera);
    renderPass.clearAlpha = 0;
    composer.addPass(renderPass);

    // Custom Sobel shader that preserves alpha
    const SobelAlphaShader = {
      uniforms: {
        'tDiffuse': { value: null },
        'resolution': { value: new THREE.Vector2() }
      },
      vertexShader: `
        varying vec2 vUv;
        void main() {
          vUv = uv;
          gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
        }
      `,
      fragmentShader: `
        uniform sampler2D tDiffuse;
        uniform vec2 resolution;
        varying vec2 vUv;

        void main() {
          vec2 texel = vec2(1.0 / resolution.x, 1.0 / resolution.y);
          vec4 original = texture2D(tDiffuse, vUv);

          if (original.a < 0.01) {
            discard;
          }

          float Gx00 = texture2D(tDiffuse, vUv + texel * vec2(-1, 1)).r;
          float Gx01 = texture2D(tDiffuse, vUv + texel * vec2(-1, 0)).r * 2.0;
          float Gx02 = texture2D(tDiffuse, vUv + texel * vec2(-1, -1)).r;
          float Gx10 = texture2D(tDiffuse, vUv + texel * vec2(1, 1)).r;
          float Gx11 = texture2D(tDiffuse, vUv + texel * vec2(1, 0)).r * 2.0;
          float Gx12 = texture2D(tDiffuse, vUv + texel * vec2(1, -1)).r;

          float Gy00 = texture2D(tDiffuse, vUv + texel * vec2(-1, 1)).r;
          float Gy01 = texture2D(tDiffuse, vUv + texel * vec2(0, 1)).r * 2.0;
          float Gy02 = texture2D(tDiffuse, vUv + texel * vec2(1, 1)).r;
          float Gy10 = texture2D(tDiffuse, vUv + texel * vec2(-1, -1)).r;
          float Gy11 = texture2D(tDiffuse, vUv + texel * vec2(0, -1)).r * 2.0;
          float Gy12 = texture2D(tDiffuse, vUv + texel * vec2(1, -1)).r;

          float Gx = Gx00 - Gx02 + Gx10 - Gx12 + Gx01 - Gx11;
          float Gy = Gy00 - Gy10 + Gy02 - Gy12 + Gy01 - Gy11;

          float G = sqrt(Gx * Gx + Gy * Gy);
          G = clamp(G * 2.5, 0.0, 1.0);

          vec3 edgeColor = vec3(G);
          vec3 blendedColor = mix(original.rgb, original.rgb + edgeColor * 0.8, 0.75);

          gl_FragColor = vec4(blendedColor, original.a);
        }
      `
    };

    sobelPass = new ShaderPass(SobelAlphaShader);
    sobelPass.uniforms['resolution'].value.x = width * window.devicePixelRatio;
    sobelPass.uniforms['resolution'].value.y = height * window.devicePixelRatio;
    composer.addPass(sobelPass);
  }

  let _disposing = false;

  function handleResize() {
    if (_disposing) return;
    const { width: newWidth, height: newHeight, aspectRatio: newAspectRatio } = getContainerSize();
    // Guard against zero dimensions (happens during View Transitions)
    if (!newWidth || !newHeight) return;
    width = newWidth;
    height = newHeight;
    aspectRatio = newAspectRatio;
    camera.aspect = aspectRatio;
    camera.updateProjectionMatrix();
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    // Update composer and Sobel resolution
    if (composer) {
      composer.setSize(width, height);
    }
    if (sobelPass) {
      sobelPass.uniforms['resolution'].value.x = width * window.devicePixelRatio;
      sobelPass.uniforms['resolution'].value.y = height * window.devicePixelRatio;
    }

    // Render with post-processing
    if (composer) {
      composer.render();
    } else {
      renderer.render(scene, camera);
    }
  }

  let currentCleanup: (() => void) | null = null;
  let eventAbort: AbortController | null = null;

  function init() {
    if (currentCleanup) { currentCleanup(); currentCleanup = null; }

    eventAbort?.abort();
    eventAbort = new AbortController();

    // Re-query DOM elements (fresh references after View Transition swap)
    container = document.querySelector(".blog-robot-viewer-container");
    modelContainer = document.getElementById("blog-robot-container");
    progressBar = document.getElementById("blog-progress-bar");
    loadingContainer = document.querySelector(".blog-robot-viewer-container .loading-container");

    if (!container || !modelContainer) return;

    // ===== HOLD-TO-PLAY =====
    const onPointerDown = () => { targetPlay = 1; };
    const onPointerRelease = () => { targetPlay = 0; };
    const onVisibilityChange = () => { if (document.hidden) targetPlay = 0; };
    modelContainer.addEventListener('pointerdown', onPointerDown);
    window.addEventListener('pointerup', onPointerRelease);
    window.addEventListener('pointercancel', onPointerRelease);
    document.addEventListener('visibilitychange', onVisibilityChange);
    holdReleaseHandlers.length = 0;
    holdReleaseHandlers.push(
      { evt: 'pointerdown', fn: onPointerDown, target: modelContainer },
      { evt: 'pointerup', fn: onPointerRelease, target: window },
      { evt: 'pointercancel', fn: onPointerRelease, target: window },
      { evt: 'visibilitychange', fn: onVisibilityChange, target: document },
    );

    ({ width, height, aspectRatio } = getContainerSize());
    if (!width || !height) return;

    _disposing = false;
    clock = new THREE.Clock();

    initScene();

    const manager = new THREE.LoadingManager();
    manager.onProgress = (_url, loaded, total) => {
      if (progressBar instanceof HTMLProgressElement) {
        progressBar.value = (loaded / total) * 100;
      }
    };

    if (loadingContainer instanceof HTMLElement) {
      loadingContainer.style.display = "none";
    }

    // Configure Draco loader for compressed models
    const dracoLoader = new DRACOLoader();
    dracoLoader.setDecoderPath('https://www.gstatic.com/draco/versioned/decoders/1.5.7/');
    dracoLoader.preload();

    // Load the keyboard model with Draco support
    const loader = new GLTFLoader(manager);
    loader.setDRACOLoader(dracoLoader);
    loader.load(
      "/models/keyboard_draco.glb", // Draco-compressed model
      (glb) => {
        keyboard = glb.scene;

        // Dark material for keyboard
        const keyboardMaterial = new THREE.MeshPhongMaterial({
          color: new THREE.Color("#2a2a2a"),
          emissive: new THREE.Color("#080808"),
          specular: new THREE.Color("#ffffff"),
          shininess: 25,
          flatShading: false,
        });

        keyboard.traverse((o) => {
          if (o instanceof THREE.Mesh) {
            o.material = keyboardMaterial;
            o.castShadow = true;
            o.receiveShadow = true;
          }
        });

        // Calculate bounding box to center and scale properly
        const box = new THREE.Box3().setFromObject(keyboard);
        const center = box.getCenter(new THREE.Vector3());
        const size = box.getSize(new THREE.Vector3());

        // Center the keyboard
        keyboard.position.set(-center.x, -center.y, -center.z);

        // Auto-scale to fit in view (like home page method)
        const maxDim = Math.max(size.x, size.y, size.z);
        const desiredSize = 3; // Fit in 3 units
        const scale = desiredSize / maxDim;
        keyboard.scale.set(scale, scale, scale);

        // Add a slight tilt for dynamic presentation
        keyboard.rotation.x = -0.2; // Tilt forward to show keys better
        keyboard.rotation.y = 0.15; // Slight angle for depth

        scene.add(keyboard);

        // Setup animation - loop continuously at 4x speed
        if (glb.animations && glb.animations.length > 0) {
          mixer = new THREE.AnimationMixer(keyboard);
          const clip = glb.animations[0];

          // Speed up animation by 4x
          mixer.timeScale = 4.0;

          animationAction = mixer.clipAction(clip);

          // Loop animation continuously
          animationAction.setLoop(THREE.LoopRepeat, Infinity);
          animationAction.play();

          // Trigger transition after first loop completes
          const firstLoopDuration = clip.duration / 4.0; // Adjusted for timeScale
          setTimeout(() => {
            document.dispatchEvent(new CustomEvent('blogRobotAnimationComplete'));
          }, firstLoopDuration * 1000); // Convert to milliseconds
        } else {
          // If no animation, dispatch event immediately after a short delay
          setTimeout(() => {
            document.dispatchEvent(new CustomEvent('blogRobotAnimationComplete'));
          }, 2000);
        }
      },
      undefined, // Progress callback not needed
      () => {
        // Error loading model - dispatch event anyway to not block UI
        document.dispatchEvent(new CustomEvent('blogRobotAnimationComplete'));
      }
    );

    let _animationId: number;
    function animate() {
      if (_disposing) return;
      _animationId = requestAnimationFrame(animate);

      const delta = clock.getDelta();

      playFactor += (targetPlay - playFactor) * 0.15;
      if (playFactor < 0.0005) playFactor = 0;
      if (mixer) {
        mixer.update(delta * playFactor);
      }

      if (controls) {
        controls.update();
      }

      // Process any pending mouse position (from throttled updates)
      if (pendingMousePosition && isMouseOver) {
        updateLighting(pendingMousePosition.x, pendingMousePosition.y, true);
      }

      // Render with Sobel post-processing
      if (composer) {
        composer.render();
      } else {
        renderer.render(scene, camera);
      }
    }

    animate();

    window.addEventListener("resize", handleResize);
    const resizeObserver = new ResizeObserver(() => handleResize());
    if (container) resizeObserver.observe(container);

    // Store cleanup function (called on navigation or re-init)
    currentCleanup = () => {
      _disposing = true;
      cancelAnimationFrame(_animationId);
      resizeObserver.disconnect();
      window.removeEventListener('resize', handleResize);
      for (const h of holdReleaseHandlers) {
        h.target.removeEventListener(h.evt, h.fn as EventListener);
      }
      holdReleaseHandlers.length = 0;
      targetPlay = 0;
      playFactor = 0;
      renderer.dispose();
      if (renderer.getContext()) {
        renderer.forceContextLoss();
      }
      renderer.domElement?.parentNode?.removeChild(renderer.domElement);
      controls?.dispose();
    };

    // Helper function to update lighting based on position (with throttling)
    function updateLighting(clientX: number, clientY: number, forceUpdate = false) {
      if (!mouseVector || !raycaster || !camera || !keyboard || !mousePointLight || !hemisphereLight || !modelContainer) return;

      const now = performance.now();

      // Throttle raycasting to ~30fps for performance
      if (!forceUpdate && now - lastRaycastTime < RAYCAST_THROTTLE_MS) {
        pendingMousePosition = { x: clientX, y: clientY };
        return;
      }

      lastRaycastTime = now;
      pendingMousePosition = null;

      const rect = modelContainer.getBoundingClientRect();
      const x = ((clientX - rect.left) / rect.width) * 2 - 1;
      const y = -((clientY - rect.top) / rect.height) * 2 + 1;

      mouseVector.x = x;
      mouseVector.y = y;

      raycaster.setFromCamera(mouseVector, camera);
      const intersects = raycaster.intersectObject(keyboard, true);

      let distance = 3.5;
      let intensityMultiplier = 1.0;
      const keyboardCenter = new THREE.Vector3(0, 0, 0);

      if (intersects.length > 0) {
        const intersectPoint = intersects[0].point;
        const distanceToIntersect = camera.position.distanceTo(intersectPoint);
        distance = distanceToIntersect * 0.4;

        const distanceFromCenter = intersectPoint.distanceTo(keyboardCenter);
        if (distanceFromCenter < 0.6) {
          intensityMultiplier = 2.0;
        } else if (distanceFromCenter < 1.0) {
          intensityMultiplier = 1.0 + (1.0 - (distanceFromCenter - 0.6) / 0.4);
        }
      }

      const targetPosition = new THREE.Vector3();
      targetPosition.copy(raycaster.ray.direction);
      targetPosition.multiplyScalar(distance);
      targetPosition.add(raycaster.ray.origin);

      lightPosition.lerp(targetPosition, 0.25);
      mousePointLight.position.copy(lightPosition);

      // Position yellow light above and red light below for gradient effect
      if (animatedLights.yellowLight) {
        animatedLights.yellowLight.position.copy(lightPosition);
        animatedLights.yellowLight.position.y += 1.2;
      }
      if (animatedLights.redLight) {
        animatedLights.redLight.position.copy(lightPosition);
        animatedLights.redLight.position.y -= 1.0;
      }

      // Increase light visibility
      const baseIntensity = 6.0;
      const targetIntensity = baseIntensity * intensityMultiplier;

      if (mousePointLight.intensity < targetIntensity) {
        mousePointLight.intensity += 0.3;
      }

      // Increase gradient lights
      if (animatedLights.yellowLight && animatedLights.yellowLight.intensity < targetIntensity * 0.7) {
        animatedLights.yellowLight.intensity += 0.24;
      }
      if (animatedLights.redLight && animatedLights.redLight.intensity < targetIntensity * 0.8) {
        animatedLights.redLight.intensity += 0.3;
      }

      if (hemisphereLight.intensity < 0.3) {
        hemisphereLight.intensity += 0.024;
      }
    }

    // Mouse event handlers for lighting system
    if (modelContainer && mouseVector && raycaster) {
      modelContainer.addEventListener('mouseenter', () => {
        isMouseOver = true;
        if (mousePointLight && hemisphereLight) {
          mousePointLight.intensity = 0;
          hemisphereLight.intensity = 0;
          if (animatedLights.yellowLight) animatedLights.yellowLight.intensity = 0;
          if (animatedLights.redLight) animatedLights.redLight.intensity = 0;
        }
      });

      modelContainer.addEventListener('mouseleave', () => {
        isMouseOver = false;
        fadeOutLights();
      });

      modelContainer.addEventListener('mousemove', (event) => {
        if (!isMouseOver) return;
        updateLighting(event.clientX, event.clientY);
      });

      // Touch event handlers for mobile support
      modelContainer.addEventListener('touchstart', (event) => {
        isMouseOver = true;
        if (mousePointLight && hemisphereLight) {
          mousePointLight.intensity = 0;
          hemisphereLight.intensity = 0;
          if (animatedLights.yellowLight) animatedLights.yellowLight.intensity = 0;
          if (animatedLights.redLight) animatedLights.redLight.intensity = 0;
        }
        if (event.touches.length > 0) {
          event.preventDefault();
          updateLighting(event.touches[0].clientX, event.touches[0].clientY);
        }
      });

      modelContainer.addEventListener('touchmove', (event) => {
        if (event.touches.length > 0) {
          event.preventDefault();
          updateLighting(event.touches[0].clientX, event.touches[0].clientY);
        }
      });

      modelContainer.addEventListener('touchend', () => {
        isMouseOver = false;
        fadeOutLights();
      });
    }

    // Fade out lights when mouse is inactive
    let mouseTimeout: number | null = null;
    if (modelContainer) {
      modelContainer.addEventListener('mousemove', () => {
        if (mouseTimeout) clearTimeout(mouseTimeout);
        mouseTimeout = window.setTimeout(() => {
          if (isMouseOver) {
            fadeOutLights();
          }
        }, 2000);
      });
    }

    // ===== LISTEN FOR PAGE-LEVEL EVENTS (for hero section integration) =====
    // This allows the model to respond to mouse events from the hero overlay
    document.addEventListener('blogKeyboardMouseMove', (e: any) => {
      if (e.detail && mousePointLight && hemisphereLight && raycaster && mouseVector && camera && keyboard) {
        const { clientX, clientY } = e.detail;
        updateLighting(clientX, clientY);
      }
    });

    document.addEventListener('blogKeyboardMouseInactive', () => {
      fadeOutLights();
    });

    document.addEventListener('blogKeyboardMouseLeave', () => {
      isMouseOver = false;
      fadeOutLights();
    });

    document.addEventListener('blogKeyboardMouseEnter', () => {
      isMouseOver = true;
      if (mousePointLight && hemisphereLight) {
        mousePointLight.intensity = 0;
        hemisphereLight.intensity = 0;
        if (animatedLights.yellowLight) animatedLights.yellowLight.intensity = 0;
        if (animatedLights.redLight) animatedLights.redLight.intensity = 0;
      }
    });
  }

  function fadeOutLights() {
    if (!mousePointLight || !hemisphereLight) return;

    const fadeOut = () => {
      if (mousePointLight && hemisphereLight) {
        const hasIntensity = mousePointLight.intensity > 0.06 || hemisphereLight.intensity > 0.006;
        if (hasIntensity) {
          mousePointLight.intensity *= 0.9;
          hemisphereLight.intensity *= 0.9;
          if (animatedLights.yellowLight) animatedLights.yellowLight.intensity *= 0.9;
          if (animatedLights.redLight) animatedLights.redLight.intensity *= 0.9;
          requestAnimationFrame(fadeOut);
        } else {
          mousePointLight.intensity = 0;
          hemisphereLight.intensity = 0;
          if (animatedLights.yellowLight) animatedLights.yellowLight.intensity = 0;
          if (animatedLights.redLight) animatedLights.redLight.intensity = 0;
        }
      }
    };
    fadeOut();
  }

  // Listen for skip animation event (when user has already seen it)
  // The animation will still run but we don't need to wait for it
  document.addEventListener('skipBlogRobotAnimation', () => {
    // Page will immediately show the contained state
  });

  // Initialize on page load (supports View Transitions)
  document.addEventListener("astro:page-load", init);
  document.addEventListener("astro:before-swap", () => {
    if (currentCleanup) { currentCleanup(); currentCleanup = null; }
  });
</script>

<style>
  .blog-robot-viewer-container {
    display: flex;
    height: var(--height, 100%);
    width: var(--width, 100%);
    position: relative;
  }

  /* Grid overlay - subtle tech grid texture */
  .grid-overlay {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 50px 50px;
    pointer-events: none;
    z-index: 11;
    opacity: 0.5;
  }

  #blog-robot-container {
    width: 100%;
    height: 100%;
    position: relative;
  }

  #blog-robot-container canvas {
    width: 100% !important;
    height: 100% !important;
    display: block;
  }

  /* Seamless container - no borders, blends with page */
  .robot-display {
    overflow: hidden;
    background: transparent;
