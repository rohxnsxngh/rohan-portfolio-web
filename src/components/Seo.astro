---
import { existsSync } from "node:fs";
import path from "node:path";
import siteData from "../data/siteData.json";
import jsonLDGenerator, { toAbsoluteUrl } from "../js/jsonLD";

const {
  title,
  description,
  url = Astro.url,
  image,
  frontmatter,
  robots,
} = Astro.props;

const jsonLD = jsonLDGenerator({
  type: frontmatter ? "post" : "website",
  post: frontmatter,
  url,
  site: Astro.site,
});

// Every route has a 1200x630 card rendered by `npm run og` into public/og/,
// named the way ogSlugForPath() in scripts/generate-og-images.mjs names it. The
// card wins over a page's own photo, which was never cut for a 1.91:1 preview.
// Every page is prerendered, so this file check runs once at build time.
const trimmedPath = Astro.url.pathname.replace(/^\/+|\/+$/g, "");
const ogCard = `/og/${trimmedPath === "" ? "home" : trimmedPath.replace(/\//g, "-")}.png`;
const hasOgCard = existsSync(path.join(process.cwd(), "public", ogCard));

// A page may hand in either a bare path ("/og/blog-foo.png") or an object with
// its own alt text and intrinsic size, so templates do not have to know which
// shape the rest of this file wants.
const pageImage = hasOgCard
  ? { src: ogCard, alt: title }
  : typeof image === "string" ? { src: image } : image;
const imageSrc = String(pageImage?.src || siteData.image.src);

// Link-preview crawlers (Facebook, X/Twitter, LinkedIn, Slack, iMessage)
// require absolute image URLs per the OG/Twitter Card spec: a site-relative
// path silently fails to fetch and shows no preview thumbnail.
const absoluteImage = toAbsoluteUrl(imageSrc, Astro.site);

// og:image:type was hardcoded to image/jpeg, which is wrong for the generated
// PNG cards under /og/. Crawlers that trust the declared type over sniffing
// (LinkedIn is the usual one) drop the image instead of rendering it.
const MIME_BY_EXTENSION: Record<string, string> = {
  avif: "image/avif",
  gif: "image/gif",
  jpeg: "image/jpeg",
  jpg: "image/jpeg",
  png: "image/png",
  svg: "image/svg+xml",
  webp: "image/webp",
};
const extension = imageSrc.split(/[?#]/)[0].split(".").pop()?.toLowerCase();
const imageType = MIME_BY_EXTENSION[extension ?? ""];

// A declared size that does not match the file is worse than no size at all:
// the crawler lays out a box of the wrong shape and the preview crops. The
// height here was fixed at 600 while the default card has always been 630. Only
// the cards we control the dimensions of get a declared size, and any other
// image has to supply its own or go undeclared and be measured by the crawler.
const isKnownCardSize =
  imageSrc === siteData.image.src || imageSrc.startsWith("/og/");
const imageWidth = pageImage?.width ?? (isKnownCardSize ? siteData.image.width : undefined);
const imageHeight = pageImage?.height ?? (isKnownCardSize ? siteData.image.height : undefined);
const imageAlt = pageImage?.alt || siteData.image.alt;
---

<!-- SEO -->
<link rel="canonical" href={url} />

<!-- Open Graph -->
<meta property="og:site_name" content={siteData.title} />
<meta property="og:type" content={frontmatter ? "article" : "website"} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
{
  absoluteImage && (
    <>
      <meta property="og:image" content={absoluteImage} />
      <meta property="og:image:url" content={absoluteImage} />
      <meta property="og:image:secure_url" content={absoluteImage} />
      {imageType && <meta property="og:image:type" content={imageType} />}
      {imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
      {imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
      <meta property="og:image:alt" content={imageAlt} />
    </>
  )
}

<!-- Twitter -->
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:card" content="summary_large_image" />
{absoluteImage && <meta name="twitter:image" content={absoluteImage} />}
<meta name="twitter:image:alt" content={imageAlt || title} />
{Astro.site && <meta name="twitter:domain" content={Astro.site.host} />}

{robots && <meta name="robots" content="noindex, nofollow" />}

<!-- JSON LD -->
<Fragment set:html={jsonLD} />
