---
// RobotModelViewer.astro with enhanced styles for expanded view
// Props for customization
interface Props {
  width?: string; // Container width as CSS value (can use % or other units)
  height?: string; // Container height as CSS value (can use % or other units)
  modelPath?: string; // Path to the 3D model
  backgroundColor?: string; // Background color for the scene
  robotColor?: string; // Color of the robot
  robotEmissive?: string; // Emissive color of the robot
  robotSpecular?: string; // Specular color of the robot
  className?: string; // Additional CSS classes
}

// Default values for props
const {
  width = "100%",
  height = "100%",
  // modelPath = "models/robot_playground.glb",
  // backgroundColor = "#000000",
  // robotColor = "#000000",
  // robotEmissive = "#000000",
  // robotSpecular = "#ffffff",
  className = "",
} = Astro.props;
---

<div
  class={`robot-model-viewer-container group ${className}`}
  style={`--width: ${width}; --height: ${height};`}
>
  <div id="robot-animation-container" class="model-display-container" data-cursor-press data-cursor-label="HOLD TO PLAY">
    <div class="loading-container">
      <progress id="progress-bar" value="0" max="100"></progress>
    </div>
  </div>
</div>

<!-- Use client:only to ensure this script runs only in the browser -->
<script>
  import { onPageReady } from '../scripts/pageReady';
  import { createRobotLightRig, ROBOT_EXPOSURE } from '../scripts/robotLightRig';
  import { bindOnce } from '../scripts/bindOnce';
  // Import Three.js properly using ES modules
  import * as THREE from "three";
  import { GLTFLoader } from "three/examples/jsm/loaders/GLTFLoader.js";
  import { DRACOLoader } from "three/examples/jsm/loaders/DRACOLoader.js";
  import { OrbitControls } from "three/examples/jsm/controls/OrbitControls.js";
  import { EffectComposer } from "three/examples/jsm/postprocessing/EffectComposer.js";
  import { RenderPass } from "three/examples/jsm/postprocessing/RenderPass.js";
  import { ShaderPass } from "three/examples/jsm/postprocessing/ShaderPass.js";

  // DOM elements — re-queried in init() to survive View Transition DOM swaps
  let container: Element | null = null;
  let modelContainer: HTMLElement | null = null;
  let progressBar: HTMLElement | null = null;
  let loadingContainer: Element | null = null;

  // Get container dimensions
  const getContainerSize = () => {
    if (!container) {
      return { width: 0, height: 0, aspectRatio: 1 };
    }
    const rect = container.getBoundingClientRect();
    return {
      width: rect.width,
      height: rect.height,
      aspectRatio: rect.width / rect.height || 1,
    };
  };

  let width = 0;
  let height = 0;
  let aspectRatio = 1;
  const backgroundColor = "#000000";
  const robotColor = "#000000";
  const robotEmissive = "#000000";
  const robotSpecular = "#ffffff";

  // Variables
  let _robot: THREE.Group;
  let _mixerRobot: THREE.AnimationMixer;
  // Hold-to-play state: animation only advances while user is pressing on
  // the container. `playFactor` lerps toward `targetPlay` each frame so
  // the play/pause transition is smooth instead of a hard cut.
  let playFactor = 0;
  let targetPlay = 0;
  const holdReleaseHandlers: { evt: string; fn: (e: Event) => void; target: EventTarget }[] = [];
  let controls: OrbitControls;
  let camera: THREE.PerspectiveCamera;
  let renderer: THREE.WebGLRenderer;
  let scene: THREE.Scene;
  let clock = new THREE.Clock();
  let animatedLights: any;
  // Exposure-scaled base intensity of the rig's spotlight, captured at
  // creation so the animation loop can pulse around it.
  let spotlightBase = 0;
  let magentaBase = 0;
  let mousePointLight: THREE.PointLight | null = null;
  let hemisphereLight: THREE.HemisphereLight | null = null;
  let raycaster: THREE.Raycaster | null = null;
  let mouseVector: THREE.Vector2 | null = null;
  let lightPosition: THREE.Vector3 = new THREE.Vector3();

  // Post-processing
  let composer: EffectComposer;
  let sobelPass: ShaderPass;

  // Throttle for mouse raycasting (~30fps = 33ms)
  let lastRaycastTime = 0;
  const RAYCAST_THROTTLE_MS = 33;
  let pendingMousePosition: { x: number; y: number } | null = null;

  // Initialize scene
  function initScene() {
    // Simple scene setup
    scene = new THREE.Scene();
    // Transparent background to allow particle effect to show through
    scene.background = null;

    camera = new THREE.PerspectiveCamera(75, aspectRatio, 0.1, 1000);

    // Disable antialiasing on large viewports (>1080p) for performance
    const isLargeViewport = width > 1920 || height > 1080;

    renderer = new THREE.WebGLRenderer({
      antialias: !isLargeViewport, // Disable AA on large screens
      powerPreference: "high-performance",
      precision: "mediump", // Medium precision is sufficient and faster
      alpha: true, // Enable transparency
    });

    // Set clear color to transparent
    renderer.setClearColor(0x000000, 0);

    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.BasicShadowMap; // Faster than PCFSoftShadowMap

    if (modelContainer) {
      // Remove any existing canvas
      const existingCanvas = modelContainer.querySelector("canvas");
      if (existingCanvas) {
        modelContainer.removeChild(existingCanvas);
      }
      modelContainer.appendChild(renderer.domElement);
    }

    // Camera position
    camera.position.set(0, 0.5, 4.5);

    // Add OrbitControls with specific limitations
    controls = new OrbitControls(camera, renderer.domElement);

    // Set initial position
    controls.target = new THREE.Vector3(0, 0, 0);

    // Allow full rotation horizontally (around y-axis)
    controls.enableRotate = true;
    controls.minAzimuthAngle = -Infinity;
    controls.maxAzimuthAngle = Infinity;

    // Restrict vertical rotation (around x-axis)
    controls.minPolarAngle = Math.PI / 2 - 0.3; // About 17 degrees up
    controls.maxPolarAngle = Math.PI / 2 + 0.3; // About 17 degrees down

    // Disable panning
    controls.enablePan = false;

    // Optional: Limit zoom if needed
    controls.minDistance = 3.0;
    controls.maxDistance = 6.0;

    // Add damping for smoother controls
    controls.enableDamping = true;
    controls.dampingFactor = 0.05;

    // Shared lighting rig — one definition for every robot viewer, scaled by a
    // single per-page exposure. The home hero is deliberately the darkest of
    // the four: the robot sits behind the hero copy under a heavy scrim.
    const { spotlight, cyanAccent, magentaAccent } = createRobotLightRig(scene, {
      exposure: ROBOT_EXPOSURE.home,
    });
    spotlightBase = spotlight?.intensity ?? 0;
    magentaBase = magentaAccent.intensity;

    // INVISIBLE LIGHTING SYSTEM - No visible geometry, just light
    // GRADIENT LIGHTING: Yellow (top) -> Orange (center) -> Red (bottom)

    // Yellow light - positioned higher, follows mouse with offset
    const yellowLight = new THREE.PointLight(0xffee00, 0, 25, 1.2);
    yellowLight.position.set(0, 6, 5);
    scene.add(yellowLight);

    // Orange light - center, main mouse follower
    mousePointLight = new THREE.PointLight(0xff8800, 0, 30, 1.0);
    mousePointLight.position.set(0, 5, 5);
    scene.add(mousePointLight);

    // Red light - positioned lower, follows mouse with offset
    const redLight = new THREE.PointLight(0xff2200, 0, 25, 1.2);
    redLight.position.set(0, 4, 5);
    scene.add(redLight);

    // Add hemisphere light for better ambient distribution (warm gradient)
    hemisphereLight = new THREE.HemisphereLight(0xffcc44, 0x661100, 0);
    scene.add(hemisphereLight);

    // Initialize raycaster for precise mouse-to-3D mapping
    raycaster = new THREE.Raycaster();
    mouseVector = new THREE.Vector2();

    // Store lights for animation
    animatedLights = {
      spotlight,
      cyanAccent,
      magentaAccent,
      mousePointLight,
      yellowLight,
      redLight
    };

    // Set up Sobel post-processing with alpha preservation
    // Create render target with alpha channel
    const renderTarget = new THREE.WebGLRenderTarget(
      width * window.devicePixelRatio,
      height * window.devicePixelRatio,
      {
        format: THREE.RGBAFormat,
        type: THREE.UnsignedByteType,
      }
    );

    composer = new EffectComposer(renderer, renderTarget);

    // Render pass - renders the scene with colors
    const renderPass = new RenderPass(scene, camera);
    renderPass.clearAlpha = 0; // Clear to transparent
    composer.addPass(renderPass);

    // Custom Sobel shader that preserves alpha from original render
    const SobelAlphaShader = {
      uniforms: {
        'tDiffuse': { value: null },
        'resolution': { value: new THREE.Vector2() }
      },
      vertexShader: `
        varying vec2 vUv;
        void main() {
          vUv = uv;
          gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
        }
      `,
      fragmentShader: `
        uniform sampler2D tDiffuse;
        uniform vec2 resolution;
        varying vec2 vUv;

        void main() {
          vec2 texel = vec2(1.0 / resolution.x, 1.0 / resolution.y);

          // Sample original for alpha
          vec4 original = texture2D(tDiffuse, vUv);

          // If fully transparent, discard (keep background visible)
          if (original.a < 0.01) {
            discard;
          }

          // Sobel kernels
          float Gx00 = texture2D(tDiffuse, vUv + texel * vec2(-1, 1)).r;
          float Gx01 = texture2D(tDiffuse, vUv + texel * vec2(-1, 0)).r * 2.0;
          float Gx02 = texture2D(tDiffuse, vUv + texel * vec2(-1, -1)).r;
          float Gx10 = texture2D(tDiffuse, vUv + texel * vec2(1, 1)).r;
          float Gx11 = texture2D(tDiffuse, vUv + texel * vec2(1, 0)).r * 2.0;
          float Gx12 = texture2D(tDiffuse, vUv + texel * vec2(1, -1)).r;

          float Gy00 = texture2D(tDiffuse, vUv + texel * vec2(-1, 1)).r;
          float Gy01 = texture2D(tDiffuse, vUv + texel * vec2(0, 1)).r * 2.0;
          float Gy02 = texture2D(tDiffuse, vUv + texel * vec2(1, 1)).r;
          float Gy10 = texture2D(tDiffuse, vUv + texel * vec2(-1, -1)).r;
          float Gy11 = texture2D(tDiffuse, vUv + texel * vec2(0, -1)).r * 2.0;
          float Gy12 = texture2D(tDiffuse, vUv + texel * vec2(1, -1)).r;

          float Gx = Gx00 - Gx02 + Gx10 - Gx12 + Gx01 - Gx11;
          float Gy = Gy00 - Gy10 + Gy02 - Gy12 + Gy01 - Gy11;

          float G = sqrt(Gx * Gx + Gy * Gy);

          // Amplify edges for stronger vertex visibility
          G = clamp(G * 2.5, 0.0, 1.0);

          // Blend Sobel edges with original color, preserve original alpha
          // Higher blend factor = more edge visibility
          vec3 edgeColor = vec3(G);
          vec3 blendedColor = mix(original.rgb, original.rgb + edgeColor * 0.8, 0.75);

          gl_FragColor = vec4(blendedColor, original.a);
        }
      `
    };

    sobelPass = new ShaderPass(SobelAlphaShader);
    sobelPass.uniforms['resolution'].value.x = width * window.devicePixelRatio;
    sobelPass.uniforms['resolution'].value.y = height * window.devicePixelRatio;
    composer.addPass(sobelPass);
  }

  let _disposing = false;

  // Handle window resize
  function handleResize() {
    if (_disposing) return;

    const {
      width: newWidth,
      height: newHeight,
      aspectRatio: newAspectRatio,
    } = getContainerSize();

    // Guard against zero dimensions (happens during View Transitions)
    if (!newWidth || !newHeight) return;

    // Update variables
    width = newWidth;
    height = newHeight;
    aspectRatio = newAspectRatio;

    // Update camera
    camera.aspect = aspectRatio;
    camera.updateProjectionMatrix();

    // Update renderer
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    // Update composer and Sobel resolution
    if (composer) {
      composer.setSize(width, height);
    }
    if (sobelPass) {
      sobelPass.uniforms['resolution'].value.x = width * window.devicePixelRatio;
      sobelPass.uniforms['resolution'].value.y = height * window.devicePixelRatio;
    }

    // Render scene with post-processing
    if (composer) {
      composer.render();
    } else {
      renderer.render(scene, camera);
    }
  }

  let currentCleanup: (() => void) | null = null;
  let eventAbort: AbortController | null = null;
  let dracoLoader: DRACOLoader | null = null;
  let loadedGeometries: THREE.BufferGeometry[] = [];
  let loadedMaterials: THREE.Material[] = [];

  // Initialize everything when DOM is loaded
  function init() {
    if (currentCleanup) { currentCleanup(); currentCleanup = null; }
    // Abort previous document-level event listeners to prevent accumulation
    eventAbort?.abort();
    eventAbort = new AbortController();

    // Re-query DOM elements (fresh references after View Transition swap)
    container = document.querySelector(".robot-model-viewer-container");
    modelContainer = document.getElementById("robot-animation-container");
    progressBar = document.getElementById("progress-bar");
    loadingContainer = document.querySelector("div.loading-container");

    // Skip init if this page doesn't have the robot viewer
    if (!container || !modelContainer) return;

    // ===== HOLD-TO-PLAY =====
    // pointerdown on the container starts playback; pointerup/cancel anywhere
    // (or tab going hidden) stops it. Listening on window for release means
    // dragging off the viewer still ends the hold cleanly.
    const onPointerDown = () => { targetPlay = 1; };
    const onPointerRelease = () => { targetPlay = 0; };
    const onVisibilityChange = () => { if (document.hidden) targetPlay = 0; };
    modelContainer.addEventListener('pointerdown', onPointerDown);
    window.addEventListener('pointerup', onPointerRelease);
    window.addEventListener('pointercancel', onPointerRelease);
    document.addEventListener('visibilitychange', onVisibilityChange);
    holdReleaseHandlers.length = 0;
    holdReleaseHandlers.push(
      { evt: 'pointerdown', fn: onPointerDown, target: modelContainer },
      { evt: 'pointerup', fn: onPointerRelease, target: window },
      { evt: 'pointercancel', fn: onPointerRelease, target: window },
      { evt: 'visibilitychange', fn: onVisibilityChange, target: document },
    );

    // Get fresh container dimensions
    ({ width, height, aspectRatio } = getContainerSize());
    if (!width || !height) return;

    _disposing = false;
    clock = new THREE.Clock();

    initScene();

    // Loading manager for tracking progress
    const manager = new THREE.LoadingManager();

    manager.onProgress = (_url, loaded, total) => {
      if (progressBar instanceof HTMLProgressElement) {
        progressBar.value = (loaded / total) * 100;
      }
    };

    if (loadingContainer instanceof HTMLElement) {
      loadingContainer.style.display = "none";
    }

    // Configure Draco loader for compressed models
    dracoLoader = new DRACOLoader();
    dracoLoader.setDecoderPath('https://www.gstatic.com/draco/versioned/decoders/1.5.7/');
    dracoLoader.preload();

    // Load robot model with Draco support
    const loader = new GLTFLoader(manager);
    loader.setDRACOLoader(dracoLoader);
    loadedGeometries = [];
    loadedMaterials = [];
    loader.load(
      "/models/robot_playground_draco.glb", // Draco-compressed model
      async (glb) => {
        if (_disposing) return;
        _robot = glb.scene;

        // Create material with customized properties
        const newMaterial = new THREE.MeshPhongMaterial({
          color: new THREE.Color(robotColor),
          emissive: new THREE.Color(robotEmissive),
          specular: new THREE.Color(robotSpecular),
          shininess: 15,
          flatShading: true,
        });
        loadedMaterials.push(newMaterial);

        // Apply material to all meshes in the model
        _robot.traverse((o) => {
          if (o instanceof THREE.Mesh) {
            loadedGeometries.push(o.geometry);
            o.material = newMaterial;
            o.castShadow = true;
            o.receiveShadow = true;
          }
        });

        // Position and scale the robot
        _robot.position.set(0, -0.4, 0);
        _robot.scale.set(1.5, 1.5, 1.5);

        scene.add(_robot);

        // Set up animation
        _mixerRobot = new THREE.AnimationMixer(_robot);
        _mixerRobot.timeScale = 1;

        if (glb.animations.length > 0) {
          _mixerRobot.clipAction(glb.animations[0]).play();
        }
      },
      undefined, // Progress callback not needed
      undefined // Error callback - model loading errors handled silently
    );

    // Animation loop
    let _animationId: number;
    function animate() {
      if (_disposing) return;
      _animationId = requestAnimationFrame(animate);

      // Update animation mixer — scaled by playFactor (0 paused, 1 full speed).
      // playFactor lerps toward targetPlay so press/release feel smooth.
      const delta = clock.getDelta();
      const elapsed = clock.getElapsedTime();

      playFactor += (targetPlay - playFactor) * 0.15;
      if (playFactor < 0.0005) playFactor = 0; // snap to clean 0 when paused
      if (_mixerRobot) {
        _mixerRobot.update(delta * playFactor);
      }

      // Animate lights for subtle dramatic effect (much dimmer)
      if (animatedLights) {
        // Subtle pulse spotlight intensity
        // Pulse around the rig's own exposure-scaled intensity rather than a
        // hardcoded value, so the per-page exposure actually reaches this light.
        if (animatedLights.spotlight) {
          animatedLights.spotlight.intensity =
            spotlightBase * (1 + Math.sin(elapsed * 0.8) * 0.33);
        }

        // Slowly rotate cyan accent
        const cyanAngle = elapsed * 0.3;
        animatedLights.cyanAccent.position.x = Math.cos(cyanAngle) * 3;
        animatedLights.cyanAccent.position.z = Math.sin(cyanAngle) * 3;

        // Subtle pulse magenta accent
        // Pulse around the rig's exposure-scaled value, like the spotlight —
        // a hardcoded intensity here would silently override the per-page
        // exposure and reintroduce the drift the shared rig removed.
        animatedLights.magentaAccent.intensity =
          magentaBase * (1 + Math.sin(elapsed * 1.2) * 0.4);
      }


      // Update controls
      if (controls) {
        controls.update();
      }

      // Process any pending mouse position (from throttled updates)
      if (pendingMousePosition) {
        performRaycastUpdate(pendingMousePosition.x, pendingMousePosition.y);
        pendingMousePosition = null;
        lastRaycastTime = performance.now();
      }

      // Render with Sobel post-processing
      if (composer) {
        composer.render();
      } else {
        renderer.render(scene, camera);
      }
    }

    animate();

    // Add resize event listener
    window.addEventListener("resize", handleResize);

    // Create a ResizeObserver to watch for container size changes
    const resizeObserver = new ResizeObserver(() => {
      handleResize();
    });

    // Start observing the container
    if (container) {
      resizeObserver.observe(container);
    }

    // Store cleanup function (called on navigation or re-init)
    currentCleanup = () => {
      _disposing = true;
      cancelAnimationFrame(_animationId);
      resizeObserver.disconnect();
      window.removeEventListener('resize', handleResize);
      // Drop hold-to-play listeners so they don't accumulate across navigations
      for (const h of holdReleaseHandlers) {
        h.target.removeEventListener(h.evt, h.fn as EventListener);
      }
      holdReleaseHandlers.length = 0;
      targetPlay = 0;
      playFactor = 0;
      loadedGeometries.forEach((g) => g.dispose());
      loadedMaterials.forEach((m) => m.dispose());
      loadedGeometries = [];
      loadedMaterials = [];
      dracoLoader?.dispose();
      dracoLoader = null;
      composer?.dispose();
      renderer.dispose();
      if (renderer.getContext()) {
        renderer.forceContextLoss();
      }
      renderer.domElement?.parentNode?.removeChild(renderer.domElement);
      controls?.dispose();
    };

    // ===== INVISIBLE LIGHTING SYSTEM WITH RAYCASTING (THROTTLED) =====
    // Helper function to perform raycasting update
    function performRaycastUpdate(x: number, y: number) {
      if (!mousePointLight || !hemisphereLight || !raycaster || !mouseVector || !camera || !_robot) return;

      // Convert to normalized device coordinates (-1 to +1)
      mouseVector.x = (x * 2) - 1;
      mouseVector.y = -(y * 2) + 1; // Inverted for WebGL

      // Update raycaster with mouse position
      raycaster.setFromCamera(mouseVector, camera);

      // Check if ray intersects with robot
      const intersects = raycaster.intersectObject(_robot, true);

      let distance = 4.5; // Default distance
      let intensityMultiplier = 1.0; // Normal intensity
      const robotCenter = new THREE.Vector3(0, -0.4, 0); // Robot's center position

      if (intersects.length > 0) {
        // Mouse is over robot - position light between camera and intersection point
        const intersectPoint = intersects[0].point;
        const distanceToIntersect = camera.position.distanceTo(intersectPoint);

        // Position light much further from robot (30% of the way from camera)
        distance = distanceToIntersect * 0.3;

        // Check distance from intersection point to robot center
        const distanceFromCenter = intersectPoint.distanceTo(robotCenter);

        // If within 0.6 units of center, boost intensity significantly
        if (distanceFromCenter < 0.6) {
          intensityMultiplier = 2.0; // Double intensity over center
        } else if (distanceFromCenter < 1.0) {
          // Gradual falloff from center
          intensityMultiplier = 1.0 + (1.0 - (distanceFromCenter - 0.6) / 0.4);
        }
      }

      // Position light at calculated distance along ray
      const targetPosition = new THREE.Vector3();
      targetPosition.copy(raycaster.ray.direction);
      targetPosition.multiplyScalar(distance);
      targetPosition.add(raycaster.ray.origin);

      // Smoothly interpolate light position
      lightPosition.lerp(targetPosition, 0.25);
      mousePointLight.position.copy(lightPosition);

      // Position yellow light above and red light below for gradient effect
      if (animatedLights.yellowLight) {
        animatedLights.yellowLight.position.copy(lightPosition);
        animatedLights.yellowLight.position.y += 1.2; // Above orange
      }
      if (animatedLights.redLight) {
        animatedLights.redLight.position.copy(lightPosition);
        animatedLights.redLight.position.y -= 1.0; // Below orange
      }

      // Determine target intensity based on center proximity
      const baseIntensity = 10.8;
      const targetIntensity = baseIntensity * intensityMultiplier;

      // Increase point light intensity - PRIMARY LIGHT SOURCE (orange)
      if (mousePointLight.intensity < targetIntensity) {
        mousePointLight.intensity += 0.48;
      }

      // Increase gradient lights (yellow slightly less, red slightly less)
      if (animatedLights.yellowLight && animatedLights.yellowLight.intensity < targetIntensity * 0.7) {
        animatedLights.yellowLight.intensity += 0.36;
      }
      if (animatedLights.redLight && animatedLights.redLight.intensity < targetIntensity * 0.8) {
        animatedLights.redLight.intensity += 0.42;
      }

      // Increase hemisphere light for better ambient distribution
      if (hemisphereLight.intensity < 0.48) {
        hemisphereLight.intensity += 0.03;
      }
    }

    // Listen for mouse movement events from Home.astro (with throttling)
    // Use AbortController signal so listeners are cleaned up on navigation
    const { signal } = eventAbort!;
    document.addEventListener('robotMouseMove', (e: any) => {
      if (e.detail && mousePointLight && hemisphereLight && raycaster && mouseVector && camera && _robot) {
        const { x, y } = e.detail; // Normalized 0-1 coordinates
        const now = performance.now();

        // Throttle raycasting to ~30fps for performance
        if (now - lastRaycastTime < RAYCAST_THROTTLE_MS) {
          pendingMousePosition = { x, y };
          return;
        }

        lastRaycastTime = now;
        pendingMousePosition = null;
        performRaycastUpdate(x, y);
      }
    }, { signal });

    // Slowly fade out light when mouse becomes inactive (slow for admiration)
    document.addEventListener('robotMouseInactive', () => {
      if (mousePointLight && hemisphereLight) {
        const fadeOut = () => {
          if (mousePointLight && hemisphereLight) {
            // Slower fade for psychology - let user admire
            const hasIntensity = mousePointLight.intensity > 0.06 || hemisphereLight.intensity > 0.006;
            if (hasIntensity) {
              mousePointLight.intensity *= 0.93;
              hemisphereLight.intensity *= 0.93;
              if (animatedLights.yellowLight) animatedLights.yellowLight.intensity *= 0.93;
              if (animatedLights.redLight) animatedLights.redLight.intensity *= 0.93;
              requestAnimationFrame(fadeOut);
            } else {
              mousePointLight.intensity = 0;
              hemisphereLight.intensity = 0;
              if (animatedLights.yellowLight) animatedLights.yellowLight.intensity = 0;
              if (animatedLights.redLight) animatedLights.redLight.intensity = 0;
            }
          }
        };
        fadeOut();
      }
    }, { signal });

    // Fade out when mouse leaves (slightly faster than inactive)
    document.addEventListener('robotMouseLeave', () => {
      if (mousePointLight && hemisphereLight) {
        const fadeOut = () => {
          if (mousePointLight && hemisphereLight) {
            const hasIntensity = mousePointLight.intensity > 0.03 || hemisphereLight.intensity > 0.006;
            if (hasIntensity) {
              mousePointLight.intensity *= 0.9;
              hemisphereLight.intensity *= 0.9;
              if (animatedLights.yellowLight) animatedLights.yellowLight.intensity *= 0.9;
              if (animatedLights.redLight) animatedLights.redLight.intensity *= 0.9;
              requestAnimationFrame(fadeOut);
            } else {
              mousePointLight.intensity = 0;
              hemisphereLight.intensity = 0;
              if (animatedLights.yellowLight) animatedLights.yellowLight.intensity = 0;
              if (animatedLights.redLight) animatedLights.redLight.intensity = 0;
            }
          }
        };
        fadeOut();
      }
    }, { signal });

    // Reset light when mouse enters
    document.addEventListener('robotMouseEnter', () => {
      if (mousePointLight && hemisphereLight) {
        mousePointLight.intensity = 0;
        hemisphereLight.intensity = 0;
        if (animatedLights.yellowLight) animatedLights.yellowLight.intensity = 0;
        if (animatedLights.redLight) animatedLights.redLight.intensity = 0;
      }
    }, { signal });
  }

  // Initialize on page load (supports View Transitions)
  // Guarded: this component's script is inlined into the bundle of every page
  // that uses it, so it re-executes on navigation and would otherwise stack up
  // an extra init() — and an extra WebGL context — per route visited.
  bindOnce('robot-model-viewer', () => {
    onPageReady(init);
    document.addEventListener("astro:before-swap", () => {
      eventAbort?.abort();
      eventAbort = null;
      if (currentCleanup) { currentCleanup(); currentCleanup = null; }
    });
  });
</script>

