---
// RobotModelViewer.astro with enhanced styles for expanded view
// Props for customization
interface Props {
  width?: string; // Container width as CSS value (can use % or other units)
  height?: string; // Container height as CSS value (can use % or other units)
  modelPath?: string; // Path to the 3D model
  backgroundColor?: string; // Background color for the scene
  robotColor?: string; // Color of the robot
  robotEmissive?: string; // Emissive color of the robot
  robotSpecular?: string; // Specular color of the robot
  className?: string; // Additional CSS classes
}

// Default values for props
const {
  width = "100%",
  height = "100%",
  // modelPath = "models/robot_playground.glb",
  // backgroundColor = "#000000",
  // robotColor = "#000000",
  // robotEmissive = "#000000",
  // robotSpecular = "#ffffff",
  className = "",
} = Astro.props;

// Only phones ever match a <source>; everyone else falls through to the 1x1
// transparent GIF and fetches nothing. Reduced-motion and data-saver visitors
// on a desktop keep the blank hero they always had: the poster is a portrait
// still, and stretched across a 16:9 hero it would be an upscaled crop of the
// robot's midsection sitting behind the copy.
const posterMedia = "(max-width: 767px)";
const blankGif = "data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7";
---

<div
  class={`robot-model-viewer-container group ${className}`}
  style={`--width: ${width}; --height: ${height};`}
>
  <div id="robot-animation-container" class="model-display-container">
    <!-- Still of the scene for devices that do not run it. Sits above the
         canvas and crossfades out once the live scene has drawn its first
         frame with the model in it (data-state="live"). -->
    <picture class="hero-poster" aria-hidden="true">
      <source
        type="image/avif"
        media={posterMedia}
        srcset="/models/posters/home-2x.avif 2x, /models/posters/home-3x.avif 3x"
      />
      <source
        type="image/webp"
        media={posterMedia}
        srcset="/models/posters/home-2x.webp 2x, /models/posters/home-3x.webp 3x"
      />
      <img
        src={blankGif}
        alt=""
        width="786"
        height="1704"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <div class="loading-container">
      <progress id="progress-bar" value="0" max="100"></progress>
    </div>
  </div>
  <!-- Phone opt-in. Only rendered visible in data-state="poster", and
       display:none on desktop so it never enters the tab order there. -->
  <button type="button" class="load-3d" data-haptic="light">
    View in 3D<small>about 1.5 MB</small>
  </button>
</div>

<!-- Use client:only to ensure this script runs only in the browser -->
<script>
  import { onPageReady } from '../scripts/pageReady';
  import { bindOnce } from '../scripts/bindOnce';
  import {
    adoptModules,
    heavy3DSkipReason,
    isCoarsePointer,
    prefetchThree,
    resolveThree,
    type ThreeCore,
    type ThreeLib,
    type ThreeModules,
  } from '../scripts/heavy3d';
  // Type-only imports cost nothing at runtime; the values come from resolveThree().
  import type {
    AnimationMixer,
    BufferGeometry,
    Clock,
    Group,
    HemisphereLight,
    Material,
    PerspectiveCamera,
    PointLight,
    Raycaster,
    Scene,
    Vector2,
    Vector3,
    WebGLRenderer,
  } from 'three';
  import type { DRACOLoader } from 'three/examples/jsm/loaders/DRACOLoader.js';
  import type { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';
  import type { EffectComposer } from 'three/examples/jsm/postprocessing/EffectComposer.js';
  import type { ShaderPass } from 'three/examples/jsm/postprocessing/ShaderPass.js';

  // three is fetched with import() through heavy3d.ts (the reasoning is
  // there). Prefetch runs at module top level, not inside init(), so a desktop
  // starts the fetch as soon as this script evaluates. That is still a little
  // later than the old static imports, which the browser discovered while
  // parsing the entry chunk; here it has to download and run this page's own
  // module graph first. Phones do not prefetch; tap-to-load resolves on demand.
  prefetchThree();

  // Populated from resolveThree() before any scene code runs.
  let THREE!: ThreeCore;
  let lib!: ThreeLib;

  // DOM elements — re-queried in init() to survive View Transition DOM swaps
  let container: Element | null = null;
  let visibilityObserver: IntersectionObserver | null = null;
  let modelContainer: HTMLElement | null = null;
  let progressBar: HTMLElement | null = null;
  let loadingContainer: Element | null = null;

  // "poster": still image, opt-in button (phones). "loading": modules and
  // model in flight. "live": first frame with the model drawn, poster fades.
  // "off": reduced motion or data saver, poster only, no button.
  type ViewerState = 'poster' | 'loading' | 'live' | 'off';
  function setState(state: ViewerState) {
    container?.setAttribute('data-state', state);
  }

  // Get container dimensions
  const getContainerSize = () => {
    if (!container) {
      return { width: 0, height: 0, aspectRatio: 1 };
    }
    const rect = container.getBoundingClientRect();
    return {
      width: rect.width,
      height: rect.height,
      aspectRatio: rect.width / rect.height || 1,
    };
  };

  let width = 0;
  let height = 0;
  let aspectRatio = 1;
  // One pixel ratio per init, shared by the renderer, the composer's render
  // target and the Sobel resolution uniform. They used to disagree (renderer
  // capped at 2, target and uniform at the raw devicePixelRatio), which on a
  // DPR-3 phone allocated a 9x-CSS-pixel target for one frame and then stepped
  // the Sobel kernel 2/3 of a texel. Touch devices cap lower: the scene is
  // dimmed behind a scrim, so the extra fill cost buys nothing visible.
  let pixelRatio = 1;
  const backgroundColor = "#000000";
  const robotColor = "#000000";
  const robotEmissive = "#000000";
  const robotSpecular = "#ffffff";

  // Variables. The model handles are nulled by the scene's cleanup so a re-run
  // on the same document (tap-to-load after context loss, or back-navigation
  // to this hero) starts without the previous scene's model.
  let _robot: Group | null = null;
  let _mixerRobot: AnimationMixer | null = null;
  let controls: OrbitControls;
  let camera: PerspectiveCamera;
  let renderer: WebGLRenderer;
  let scene: Scene;
  let clock!: Clock;
  let animatedLights: any;
  // Exposure-scaled base intensity of the rig's spotlight, captured at
  // creation so the animation loop can pulse around it.
  let spotlightBase = 0;
  let magentaBase = 0;
  let mousePointLight: PointLight | null = null;
  let hemisphereLight: HemisphereLight | null = null;
  let raycaster: Raycaster | null = null;
  let mouseVector: Vector2 | null = null;
  let lightPosition!: Vector3;

  // Post-processing
  let composer: EffectComposer;
  let sobelPass: ShaderPass;

  // Throttle for mouse raycasting (~30fps = 33ms)
  let lastRaycastTime = 0;
  const RAYCAST_THROTTLE_MS = 33;
  let pendingMousePosition: { x: number; y: number } | null = null;

  // Initialize scene
  function initScene(touch: boolean) {
    // Simple scene setup
    scene = new THREE.Scene();
    // Transparent background to allow particle effect to show through
    scene.background = null;

    camera = new THREE.PerspectiveCamera(75, aspectRatio, 0.1, 1000);

    // Disable antialiasing on large viewports (>1080p) for performance
    const isLargeViewport = width > 1920 || height > 1080;

    renderer = new THREE.WebGLRenderer({
      antialias: !isLargeViewport, // Disable AA on large screens
      powerPreference: "high-performance",
      precision: "mediump", // Medium precision is sufficient and faster
      alpha: true, // Enable transparency
    });

    // Set clear color to transparent
    renderer.setClearColor(0x000000, 0);

    renderer.setSize(width, height);
    renderer.setPixelRatio(pixelRatio);
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.BasicShadowMap; // Faster than PCFSoftShadowMap

    if (modelContainer) {
      // Remove any existing canvas
      const existingCanvas = modelContainer.querySelector("canvas");
      if (existingCanvas) {
        modelContainer.removeChild(existingCanvas);
      }
      modelContainer.appendChild(renderer.domElement);
    }

    // Camera position
    camera.position.set(0, 0.5, 4.5);

    // Add OrbitControls with specific limitations
    controls = new lib.OrbitControls(camera, renderer.domElement);

    if (touch) {
      // OrbitControls.connect() sets touch-action: none on the canvas, and this
      // canvas covers the whole hero. On a phone that means every vertical
      // drag is swallowed as a rotate and the page cannot be scrolled from the
      // top of the page at all. pan-y hands vertical swipes back to the
      // browser; horizontal drags still rotate. pinch-zoom has to be listed
      // too: pan-y on its own also removes the browser's pinch gesture, which
      // would make the hero the one region of the page that cannot be zoomed.
      // OrbitControls' own pinch-zoom is off for the same reason: two fingers
      // on the hero should zoom the page, not the model.
      renderer.domElement.style.touchAction = 'pan-y pinch-zoom';
      controls.enableZoom = false;
    }

    // Set initial position
    controls.target = new THREE.Vector3(0, 0, 0);

    // Allow full rotation horizontally (around y-axis)
    controls.enableRotate = true;
    controls.minAzimuthAngle = -Infinity;
    controls.maxAzimuthAngle = Infinity;

    // Restrict vertical rotation (around x-axis)
    controls.minPolarAngle = Math.PI / 2 - 0.3; // About 17 degrees up
    controls.maxPolarAngle = Math.PI / 2 + 0.3; // About 17 degrees down

    // Disable panning
    controls.enablePan = false;

    // Optional: Limit zoom if needed
    controls.minDistance = 3.0;
    controls.maxDistance = 6.0;

    // Add damping for smoother controls
    controls.enableDamping = true;
    controls.dampingFactor = 0.05;

    // Shared lighting rig — one definition for every robot viewer, scaled by a
    // single per-page exposure. The home hero is deliberately the darkest of
    // the four: the robot sits behind the hero copy under a heavy scrim.
    const { spotlight, cyanAccent, magentaAccent } = lib.createRobotLightRig(scene, {
      exposure: lib.ROBOT_EXPOSURE.home,
    });
    spotlightBase = spotlight?.intensity ?? 0;
    magentaBase = magentaAccent.intensity;

    // INVISIBLE LIGHTING SYSTEM - No visible geometry, just light
    // GRADIENT LIGHTING: Yellow (top) -> Orange (center) -> Red (bottom)

    // Yellow light - positioned higher, follows mouse with offset
    const yellowLight = new THREE.PointLight(0xffee00, 0, 25, 1.2);
    yellowLight.position.set(0, 6, 5);
    scene.add(yellowLight);

    // Orange light - center, main mouse follower
    mousePointLight = new THREE.PointLight(0xff8800, 0, 30, 1.0);
    mousePointLight.position.set(0, 5, 5);
    scene.add(mousePointLight);

    // Red light - positioned lower, follows mouse with offset
    const redLight = new THREE.PointLight(0xff2200, 0, 25, 1.2);
    redLight.position.set(0, 4, 5);
    scene.add(redLight);

    // Add hemisphere light for better ambient distribution (warm gradient)
    hemisphereLight = new THREE.HemisphereLight(0xffcc44, 0x661100, 0);
    scene.add(hemisphereLight);

    // Initialize raycaster for precise mouse-to-3D mapping
    raycaster = new THREE.Raycaster();
    mouseVector = new THREE.Vector2();
    lightPosition = new THREE.Vector3();

    // Store lights for animation
    animatedLights = {
      spotlight,
      cyanAccent,
      magentaAccent,
      mousePointLight,
      yellowLight,
      redLight
    };

    // Set up Sobel post-processing with alpha preservation
    // Create render target with alpha channel
    const renderTarget = new THREE.WebGLRenderTarget(
      width * pixelRatio,
      height * pixelRatio,
      {
        format: THREE.RGBAFormat,
        type: THREE.UnsignedByteType,
      }
    );

    composer = new lib.EffectComposer(renderer, renderTarget);

    // Render pass - renders the scene with colors
    const renderPass = new lib.RenderPass(scene, camera);
    renderPass.clearAlpha = 0; // Clear to transparent
    composer.addPass(renderPass);

    // Custom Sobel shader that preserves alpha from original render
    const SobelAlphaShader = {
      uniforms: {
        'tDiffuse': { value: null },
        'resolution': { value: new THREE.Vector2() }
      },
      vertexShader: `
        varying vec2 vUv;
        void main() {
          vUv = uv;
          gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
        }
      `,
      fragmentShader: `
        uniform sampler2D tDiffuse;
        uniform vec2 resolution;
        varying vec2 vUv;

        void main() {
          vec2 texel = vec2(1.0 / resolution.x, 1.0 / resolution.y);

          // Sample original for alpha
          vec4 original = texture2D(tDiffuse, vUv);

          // If fully transparent, discard (keep background visible)
          if (original.a < 0.01) {
            discard;
          }

          // Sobel kernels
          float Gx00 = texture2D(tDiffuse, vUv + texel * vec2(-1, 1)).r;
          float Gx01 = texture2D(tDiffuse, vUv + texel * vec2(-1, 0)).r * 2.0;
          float Gx02 = texture2D(tDiffuse, vUv + texel * vec2(-1, -1)).r;
          float Gx10 = texture2D(tDiffuse, vUv + texel * vec2(1, 1)).r;
          float Gx11 = texture2D(tDiffuse, vUv + texel * vec2(1, 0)).r * 2.0;
          float Gx12 = texture2D(tDiffuse, vUv + texel * vec2(1, -1)).r;

          float Gy00 = texture2D(tDiffuse, vUv + texel * vec2(-1, 1)).r;
          float Gy01 = texture2D(tDiffuse, vUv + texel * vec2(0, 1)).r * 2.0;
          float Gy02 = texture2D(tDiffuse, vUv + texel * vec2(1, 1)).r;
          float Gy10 = texture2D(tDiffuse, vUv + texel * vec2(-1, -1)).r;
          float Gy11 = texture2D(tDiffuse, vUv + texel * vec2(0, -1)).r * 2.0;
          float Gy12 = texture2D(tDiffuse, vUv + texel * vec2(1, -1)).r;

          float Gx = Gx00 - Gx02 + Gx10 - Gx12 + Gx01 - Gx11;
          float Gy = Gy00 - Gy10 + Gy02 - Gy12 + Gy01 - Gy11;

          float G = sqrt(Gx * Gx + Gy * Gy);

          // Amplify edges for stronger vertex visibility
          G = clamp(G * 2.5, 0.0, 1.0);

          // Blend Sobel edges with original color, preserve original alpha
          // Higher blend factor = more edge visibility
          vec3 edgeColor = vec3(G);
          vec3 blendedColor = mix(original.rgb, original.rgb + edgeColor * 0.8, 0.75);

          gl_FragColor = vec4(blendedColor, original.a);
        }
      `
    };

    sobelPass = new lib.ShaderPass(SobelAlphaShader);
    sobelPass.uniforms['resolution'].value.x = width * pixelRatio;
    sobelPass.uniforms['resolution'].value.y = height * pixelRatio;
    composer.addPass(sobelPass);
  }

  let _disposing = false;

  // Handle window resize
  function handleResize() {
    if (_disposing) return;

    const {
      width: newWidth,
      height: newHeight,
      aspectRatio: newAspectRatio,
    } = getContainerSize();

    // Guard against zero dimensions (happens during View Transitions)
    if (!newWidth || !newHeight) return;

    // Update variables
    width = newWidth;
    height = newHeight;
    aspectRatio = newAspectRatio;

    // Update camera
    camera.aspect = aspectRatio;
    camera.updateProjectionMatrix();

    // Update renderer
    renderer.setSize(width, height);
    renderer.setPixelRatio(pixelRatio);

    // Update composer and Sobel resolution
    if (composer) {
      composer.setSize(width, height);
    }
    if (sobelPass) {
      sobelPass.uniforms['resolution'].value.x = width * pixelRatio;
      sobelPass.uniforms['resolution'].value.y = height * pixelRatio;
    }

    // Render scene with post-processing
    if (composer) {
      composer.render();
    } else {
      renderer.render(scene, camera);
    }
  }

  let currentCleanup: (() => void) | null = null;
  let eventAbort: AbortController | null = null;
  let dracoLoader: DRACOLoader | null = null;
  let loadedGeometries: BufferGeometry[] = [];
  let loadedMaterials: Material[] = [];
  // Bumped by every init(); an async scene start that resolves after a
  // navigation compares against it and bails instead of building a scene
  // into a page that is gone.
  let initGeneration = 0;

  // Initialize everything when DOM is loaded
  function init() {
    if (currentCleanup) { currentCleanup(); currentCleanup = null; }
    // Abort previous document-level event listeners to prevent accumulation
    eventAbort?.abort();
    eventAbort = new AbortController();
    const gen = ++initGeneration;

    // Re-query DOM elements (fresh references after View Transition swap)
    container = document.querySelector(".robot-model-viewer-container");
    modelContainer = document.getElementById("robot-animation-container");
    progressBar = document.getElementById("progress-bar");
    loadingContainer = document.querySelector("div.loading-container");

    // Skip init if this page doesn't have the robot viewer
    if (!container || !modelContainer) return;

    // Phones, reduced-motion and data-saver visitors do not get the WebGL
    // hero by default; they get the poster. See src/scripts/heavy3d.ts.
    //
    // A phone skipped for width alone can opt in with the button, which pulls
    // the modules and the model only at that point. Reduced-motion and
    // data-saver are explicit requests, so those get no button.
    //
    // The loading indicator lives in the markup and is normally hidden once
    // the model arrives, so skipping has to hide it too or it sits there
    // spinning forever over a model that is never coming.
    const skipReason = heavy3DSkipReason();
    if (skipReason) {
      setState(skipReason === 'width' ? 'poster' : 'off');
      if (loadingContainer instanceof HTMLElement) loadingContainer.style.display = 'none';
      if (skipReason === 'width') {
        container.querySelector('button.load-3d')?.addEventListener('click', () => {
          if (container?.getAttribute('data-state') === 'loading') return;
          void startScene(gen, true, true);
        }, { signal: eventAbort.signal });
      }
      return;
    }

    setState('loading');
    void startScene(gen, isCoarsePointer(), false);
  }

  // Builds and runs the scene. `touch` is true on phones and tablets, where
  // the canvas must not capture scrolling and the pixel ratio is capped lower.
  // `canRetry` is true only on the tap-to-load path: it is the one case where
  // the poster and button exist to fall back to. `touch` is not enough for
  // that, since an iPad is a coarse pointer that passed the width gate, and
  // there the poster and button are display:none and no click handler was
  // bound, so a "poster" state would render nothing and offer no way back.
  async function startScene(gen: number, touch: boolean, canRetry: boolean) {
    if (currentCleanup) { currentCleanup(); currentCleanup = null; }
    setState('loading');
    // The tap-to-load path needs the progress bar back: the poster branch hid
    // it, and on a phone the model is a real wait.
    if (loadingContainer instanceof HTMLElement) loadingContainer.style.display = '';
    if (progressBar instanceof HTMLProgressElement) progressBar.value = 0;

    // Where the scene stops short of running: back to the poster and button
    // where there is one to tap, otherwise the blank "off" state. Never leave
    // "loading" behind, since that keeps the poster up with the button hidden.
    const fallBack = () => {
      setState(canRetry ? 'poster' : 'off');
      if (loadingContainer instanceof HTMLElement) loadingContainer.style.display = 'none';
    };

    let modules: ThreeModules;
    try {
      modules = await resolveThree();
    } catch {
      // A failed chunk fetch (flaky cellular, mostly) should leave the poster
      // and the button, not a stuck progress bar. heavy3d.ts drops the failed
      // promise, so the next tap starts a fresh fetch.
      if (gen !== initGeneration) return;
      fallBack();
      return;
    }
    if (gen !== initGeneration || !container || !modelContainer) return;
    ({ THREE, lib } = adoptModules(modules));

    // Get fresh container dimensions
    ({ width, height, aspectRatio } = getContainerSize());
    if (!width || !height) {
      fallBack();
      return;
    }
    pixelRatio = Math.min(window.devicePixelRatio, touch ? 1.5 : 2);

    _disposing = false;
    clock = new THREE.Clock();

    // WebGLRenderer throws when the browser refuses a context (iOS Safari under
    // memory pressure, WebGL disabled, a GPU process crash). Without this the
    // exception escapes the async function and the viewer is stranded in
    // "loading": poster up, button hidden, nothing to tap.
    try {
      initScene(touch);
    } catch (err) {
      console.error('[viewer] could not create the WebGL scene', err);
      fallBack();
      return;
    }

    // Loading manager for tracking progress
    const manager = new THREE.LoadingManager();

    manager.onProgress = (_url, loaded, total) => {
      if (progressBar instanceof HTMLProgressElement) {
        progressBar.value = (loaded / total) * 100;
      }
    };

    // Desktop hides the bar straight away (the model streams in behind the
    // copy in a second or two); on touch it stays until the model is in, since
    // the visitor asked for it and is watching for it.
    if (!touch && loadingContainer instanceof HTMLElement) {
      loadingContainer.style.display = "none";
    }
    manager.onLoad = () => {
      if (loadingContainer instanceof HTMLElement) {
        loadingContainer.style.display = "none";
      }
    };

    // Configure Draco loader for compressed models
    dracoLoader = new lib.DRACOLoader();
    // Self-hosted: a third-party CDN on the critical path of the hero model costs
    // an extra DNS lookup and TLS handshake before any geometry can decode.
    dracoLoader.setDecoderPath('/draco/');
    dracoLoader.preload();

    // Load robot model with Draco support
    const loader = new lib.GLTFLoader(manager);
    loader.setDRACOLoader(dracoLoader);
    loadedGeometries = [];
    loadedMaterials = [];
    // Per-scene flags, as opposed to the module-level model handles. A loader
    // callback that lands after this scene was torn down (and possibly after
    // the next one started, which resets _disposing) must not add its model
    // to the new scene, and the poster crossfade must key on *this* scene
    // having its model, not on whatever handle a previous scene left behind.
    let sceneDisposed = false;
    let modelInScene = false;
    loader.load(
      "/models/robot_playground_draco.glb", // Draco-compressed model
      async (glb) => {
        if (_disposing || sceneDisposed) return;
        _robot = glb.scene;

        // Create material with customized properties
        const newMaterial = new THREE.MeshPhongMaterial({
          color: new THREE.Color(robotColor),
          emissive: new THREE.Color(robotEmissive),
          specular: new THREE.Color(robotSpecular),
          shininess: 15,
          flatShading: true,
        });
        loadedMaterials.push(newMaterial);

        // Apply material to all meshes in the model
        _robot.traverse((o) => {
          if (o instanceof THREE.Mesh) {
            loadedGeometries.push(o.geometry);
            o.material = newMaterial;
            o.castShadow = true;
            o.receiveShadow = true;
          }
        });

        // Position and scale the robot
        _robot.position.set(0, -0.4, 0);
        _robot.scale.set(1.5, 1.5, 1.5);

        scene.add(_robot);
        modelInScene = true;

        // Set up animation
        _mixerRobot = new THREE.AnimationMixer(_robot);
        _mixerRobot.timeScale = 1;

        if (glb.animations.length > 0) {
          _mixerRobot.clipAction(glb.animations[0]).play();
        }
      },
      undefined, // Progress callback not needed
      () => {
        if (_disposing || sceneDisposed) return;
        // Without the model there is nothing to draw, so tear the scene down
        // rather than leave a render loop and a WebGL context running behind
        // the poster. On the tap path that brings the button back so the
        // visitor can try again; before this the state stuck at "loading"
        // with the button hidden and no way out short of a reload.
        if (currentCleanup) { currentCleanup(); currentCleanup = null; }
        fallBack();
      }
    );

    // Animation loop
    let _animationId: number;
    let _loopRunning = false;
    let _live = false;
    function animate() {
      if (_disposing) return;
      if (!_loopRunning) return;
      _animationId = requestAnimationFrame(animate);

      // Update animation mixer — the clip runs continuously.
      const delta = clock.getDelta();
      const elapsed = clock.getElapsedTime();

      if (_mixerRobot) {
        _mixerRobot.update(delta);
      }

      // Animate lights for subtle dramatic effect (much dimmer)
      if (animatedLights) {
        // Subtle pulse spotlight intensity
        // Pulse around the rig's own exposure-scaled intensity rather than a
        // hardcoded value, so the per-page exposure actually reaches this light.
        if (animatedLights.spotlight) {
          animatedLights.spotlight.intensity =
            spotlightBase * (1 + Math.sin(elapsed * 0.8) * 0.33);
        }

        // Slowly rotate cyan accent
        const cyanAngle = elapsed * 0.3;
        animatedLights.cyanAccent.position.x = Math.cos(cyanAngle) * 3;
        animatedLights.cyanAccent.position.z = Math.sin(cyanAngle) * 3;

        // Subtle pulse magenta accent
        // Pulse around the rig's exposure-scaled value, like the spotlight —
        // a hardcoded intensity here would silently override the per-page
        // exposure and reintroduce the drift the shared rig removed.
        animatedLights.magentaAccent.intensity =
          magentaBase * (1 + Math.sin(elapsed * 1.2) * 0.4);
      }


      // Update controls
      if (controls) {
        controls.update();
      }

      // Process any pending mouse position (from throttled updates)
      if (pendingMousePosition) {
        performRaycastUpdate(pendingMousePosition.x, pendingMousePosition.y);
        pendingMousePosition = null;
        lastRaycastTime = performance.now();
      }

      // Render with Sobel post-processing
      if (composer) {
        composer.render();
      } else {
        renderer.render(scene, camera);
      }

      // The poster only crossfades once a frame with the model in it has
      // actually been drawn; flipping on load would show an empty canvas
      // for the frame in between.
      if (!_live && modelInScene) {
        _live = true;
        setState('live');
      }
    }

    // Only render while the canvas is actually on screen. These heroes sit
    // above long pages, so without this the scene kept running a full
    // composer pass every frame — model, lights and a Sobel post-process —
    // the entire time the reader was scrolled past it.
    function startLoop() {
      if (_loopRunning || _disposing) return;
      _loopRunning = true;
      // Discard the time accumulated while paused, otherwise the first frame
      // back gets a delta of however long the viewer was off screen and the
      // animation jumps.
      clock.getDelta();
      _animationId = requestAnimationFrame(animate);
    }

    function stopLoop() {
      _loopRunning = false;
      if (_animationId) cancelAnimationFrame(_animationId);
    }

    // rootMargin gives the loop a head start so the model is already moving
    // by the time it scrolls into view.
    visibilityObserver = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) startLoop();
        else stopLoop();
      },
      { rootMargin: '200px' }
    );
    if (container) visibilityObserver.observe(container);
    startLoop();

    // Add resize event listener
    window.addEventListener("resize", handleResize);

    // Create a ResizeObserver to watch for container size changes
    const resizeObserver = new ResizeObserver(() => {
      handleResize();
    });

    // Start observing the container
    if (container) {
      resizeObserver.observe(container);
    }

    // Context loss. iOS evicts WebGL contexts under memory pressure and when
    // too many are open; without handling this the loop keeps drawing into a
    // dead context. On the tap-to-load path the poster and button come back
    // so the visitor can retry; if the browser restores the context on its
    // own the loop resumes and the next frame flips back to live.
    const canvas = renderer.domElement;
    const onContextLost = (event: Event) => {
      event.preventDefault();
      if (_disposing) return;
      stopLoop();
      _live = false;
      if (canRetry) setState('poster');
    };
    const onContextRestored = () => {
      if (_disposing) return;
      setState('loading');
      startLoop();
    };
    canvas.addEventListener('webglcontextlost', onContextLost);
    canvas.addEventListener('webglcontextrestored', onContextRestored);

    // Scene-level listeners live on their own controller so a tap-to-load
    // re-run after context loss does not stack a second set.
    const sceneAbort = new AbortController();

    // Store cleanup function (called on navigation or re-init)
    currentCleanup = () => {
      _disposing = true;
      sceneDisposed = true;
      sceneAbort.abort();
      cancelAnimationFrame(_animationId);
      visibilityObserver?.disconnect();
      visibilityObserver = null;
      resizeObserver.disconnect();
      window.removeEventListener('resize', handleResize);
      canvas.removeEventListener('webglcontextlost', onContextLost);
      canvas.removeEventListener('webglcontextrestored', onContextRestored);
      // Drop the model handles with the scene: the next scene's raycasts and
      // mixer updates must not run against a model that is no longer drawn.
      _robot = null;
      _mixerRobot = null;
      loadedGeometries.forEach((g) => g.dispose());
      loadedMaterials.forEach((m) => m.dispose());
      loadedGeometries = [];
      loadedMaterials = [];
      dracoLoader?.dispose();
      dracoLoader = null;
      composer?.dispose();
      renderer.dispose();
      if (renderer.getContext()) {
        renderer.forceContextLoss();
      }
      renderer.domElement?.parentNode?.removeChild(renderer.domElement);
      controls?.dispose();
    };

    // ===== INVISIBLE LIGHTING SYSTEM WITH RAYCASTING (THROTTLED) =====
    // Helper function to perform raycasting update
    function performRaycastUpdate(x: number, y: number) {
      if (!mousePointLight || !hemisphereLight || !raycaster || !mouseVector || !camera || !_robot) return;

      // Convert to normalized device coordinates (-1 to +1)
      mouseVector.x = (x * 2) - 1;
      mouseVector.y = -(y * 2) + 1; // Inverted for WebGL

      // Update raycaster with mouse position
      raycaster.setFromCamera(mouseVector, camera);

      // Check if ray intersects with robot
      const intersects = raycaster.intersectObject(_robot, true);

      let distance = 4.5; // Default distance
      let intensityMultiplier = 1.0; // Normal intensity
      const robotCenter = new THREE.Vector3(0, -0.4, 0); // Robot's center position

      if (intersects.length > 0) {
        // Mouse is over robot - position light between camera and intersection point
        const intersectPoint = intersects[0].point;
        const distanceToIntersect = camera.position.distanceTo(intersectPoint);

        // Position light much further from robot (30% of the way from camera)
        distance = distanceToIntersect * 0.3;

        // Check distance from intersection point to robot center
        const distanceFromCenter = intersectPoint.distanceTo(robotCenter);

        // If within 0.6 units of center, boost intensity significantly
        if (distanceFromCenter < 0.6) {
          intensityMultiplier = 2.0; // Double intensity over center
        } else if (distanceFromCenter < 1.0) {
          // Gradual falloff from center
          intensityMultiplier = 1.0 + (1.0 - (distanceFromCenter - 0.6) / 0.4);
        }
      }

      // Position light at calculated distance along ray
      const targetPosition = new THREE.Vector3();
      targetPosition.copy(raycaster.ray.direction);
      targetPosition.multiplyScalar(distance);
      targetPosition.add(raycaster.ray.origin);

      // Smoothly interpolate light position
      lightPosition.lerp(targetPosition, 0.25);
      mousePointLight.position.copy(lightPosition);

      // Position yellow light above and red light below for gradient effect
      if (animatedLights.yellowLight) {
        animatedLights.yellowLight.position.copy(lightPosition);
        animatedLights.yellowLight.position.y += 1.2; // Above orange
      }
      if (animatedLights.redLight) {
        animatedLights.redLight.position.copy(lightPosition);
        animatedLights.redLight.position.y -= 1.0; // Below orange
      }

      // Determine target intensity based on center proximity
      const baseIntensity = 10.8;
      const targetIntensity = baseIntensity * intensityMultiplier;

      // Increase point light intensity - PRIMARY LIGHT SOURCE (orange)
      if (mousePointLight.intensity < targetIntensity) {
        mousePointLight.intensity += 0.48;
      }

      // Increase gradient lights (yellow slightly less, red slightly less)
      if (animatedLights.yellowLight && animatedLights.yellowLight.intensity < targetIntensity * 0.7) {
        animatedLights.yellowLight.intensity += 0.36;
      }
      if (animatedLights.redLight && animatedLights.redLight.intensity < targetIntensity * 0.8) {
        animatedLights.redLight.intensity += 0.42;
      }

      // Increase hemisphere light for better ambient distribution
      if (hemisphereLight.intensity < 0.48) {
        hemisphereLight.intensity += 0.03;
      }
    }

    // Listen for mouse movement events from Home.astro (with throttling)
    // Scoped to the scene's controller so listeners are cleaned up on
    // navigation and on re-init.
    const { signal } = sceneAbort;
    document.addEventListener('robotMouseMove', (e: any) => {
      if (e.detail && mousePointLight && hemisphereLight && raycaster && mouseVector && camera && _robot) {
        const { x, y } = e.detail; // Normalized 0-1 coordinates
        const now = performance.now();

        // Throttle raycasting to ~30fps for performance
        if (now - lastRaycastTime < RAYCAST_THROTTLE_MS) {
          pendingMousePosition = { x, y };
          return;
        }

        lastRaycastTime = now;
        pendingMousePosition = null;
        performRaycastUpdate(x, y);
      }
    }, { signal });

    // Slowly fade out light when mouse becomes inactive (slow for admiration)
    document.addEventListener('robotMouseInactive', () => {
      if (mousePointLight && hemisphereLight) {
        const fadeOut = () => {
          if (mousePointLight && hemisphereLight) {
            // Slower fade for psychology - let user admire
            const hasIntensity = mousePointLight.intensity > 0.06 || hemisphereLight.intensity > 0.006;
            if (hasIntensity) {
              mousePointLight.intensity *= 0.93;
              hemisphereLight.intensity *= 0.93;
              if (animatedLights.yellowLight) animatedLights.yellowLight.intensity *= 0.93;
              if (animatedLights.redLight) animatedLights.redLight.intensity *= 0.93;
              requestAnimationFrame(fadeOut);
            } else {
              mousePointLight.intensity = 0;
              hemisphereLight.intensity = 0;
              if (animatedLights.yellowLight) animatedLights.yellowLight.intensity = 0;
              if (animatedLights.redLight) animatedLights.redLight.intensity = 0;
            }
          }
        };
        fadeOut();
      }
    }, { signal });

    // Fade out when mouse leaves (slightly faster than inactive)
    document.addEventListener('robotMouseLeave', () => {
      if (mousePointLight && hemisphereLight) {
        const fadeOut = () => {
          if (mousePointLight && hemisphereLight) {
            const hasIntensity = mousePointLight.intensity > 0.03 || hemisphereLight.intensity > 0.006;
            if (hasIntensity) {
              mousePointLight.intensity *= 0.9;
              hemisphereLight.intensity *= 0.9;
              if (animatedLights.yellowLight) animatedLights.yellowLight.intensity *= 0.9;
              if (animatedLights.redLight) animatedLights.redLight.intensity *= 0.9;
              requestAnimationFrame(fadeOut);
            } else {
              mousePointLight.intensity = 0;
              hemisphereLight.intensity = 0;
              if (animatedLights.yellowLight) animatedLights.yellowLight.intensity = 0;
              if (animatedLights.redLight) animatedLights.redLight.intensity = 0;
            }
          }
        };
        fadeOut();
      }
    }, { signal });

    // Reset light when mouse enters
    document.addEventListener('robotMouseEnter', () => {
      if (mousePointLight && hemisphereLight) {
        mousePointLight.intensity = 0;
        hemisphereLight.intensity = 0;
        if (animatedLights.yellowLight) animatedLights.yellowLight.intensity = 0;
        if (animatedLights.redLight) animatedLights.redLight.intensity = 0;
      }
    }, { signal });
  }

  // Initialize on page load (supports View Transitions)
  // Guarded: this component's script is inlined into the bundle of every page
  // that uses it, so it re-executes on navigation and would otherwise stack up
  // an extra init() — and an extra WebGL context — per route visited.
  bindOnce('robot-model-viewer', () => {
    onPageReady(init);
    document.addEventListener("astro:before-swap", () => {
      eventAbort?.abort();
      eventAbort = null;
      // Invalidate any scene start still awaiting its modules.
      initGeneration++;
      if (currentCleanup) { currentCleanup(); currentCleanup = null; }
    });
  });
</script>

<style>
  .robot-model-viewer-container {
    display: flex;
    height: var(--height, 100%);
    width: var(--width, 100%);
    position: relative;
  }

  #robot-animation-container {
    width: 100%;
    height: 100%;
    position: relative;
  }

  #robot-animation-container canvas {
    width: 100% !important;
    height: 100% !important;
    display: block;
  }

  .model-display-container {
    overflow: hidden;
    background: transparent;
    z-index: 10;
    width: 100%;
    height: 100%;
  }

  /* Poster: covers the canvas until the live scene has drawn the model.
     Phone-only, in both the poster and off states. Desktop never fetches it
     (no <source> matches, the fallback is a 1x1 transparent GIF) and hides
     the element outright below so that GIF can never paint over the canvas;
     the same rule keeps a reduced-motion or data-saver desktop on the blank
     hero it always had rather than an upscaled portrait crop. */
  .hero-poster img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 45%;
    transition: opacity 0.6s ease-out;
    pointer-events: none;
  }

  [data-state="live"] .hero-poster img {
    opacity: 0;
  }

  @media (min-width: 768px) {
    .hero-poster {
      display: none;
    }
  }

  /* On desktop this z-index lifts the canvas above the page's .robot-overlay
     scrim (the page dims what is behind the robot, the robot's own exposure
     does the rest). Where the poster shows it has to sit *under* that scrim
     instead, or a full-brightness photo lands behind the hero copy. */
  @media (max-width: 767px) {
    .model-display-container {
      z-index: auto;
    }
  }

  /* Tap-to-load. Hidden until the script sets data-state="poster"; the
     page's hero copy is pointer-events:none so taps reach it through the
     text. z-index clears the page's scrim (z-index 1 in the same context). */
  .load-3d {
    display: none;
    position: absolute;
    left: 50%;
    bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px));
    transform: translateX(-50%);
    z-index: 30;
    pointer-events: auto;
    align-items: baseline;
    gap: 0.6em;
    min-height: 44px;
    padding: 0.7rem 1.2rem;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.6);
    color: rgba(255, 255, 255, 0.92);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .load-3d small {
    font-size: 0.6rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    opacity: 0.6;
  }

  .load-3d:active {
    background: rgba(255, 255, 255, 0.14);
  }

  [data-state="poster"] .load-3d {
    display: inline-flex;
  }

  @media (min-width: 768px) {
    .load-3d {
      display: none !important;
    }
  }

  .loading-container {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    text-align: center;
    z-index: 20;
  }

  #progress-bar {
    width: 80%;
    height: 8px;
    border-radius: 4px;
    overflow: hidden;
  }

  #progress-bar::-webkit-progress-bar {
    background-color: rgba(0, 0, 0, 0.1);
  }

  #progress-bar::-webkit-progress-value {
    background-color: rgba(var(--color-primary, 75, 85, 99), 0.8);
  }
</style>
