---
// src/components/ProjectImage.astro
import { Image } from "astro:assets";
import { allowedWidths, getImageSize } from "../utils/imageSize";

interface Props {
  image?: string;
  title: string;
  tags?: string[];
  bgColor?: string;
}

const { 
  image, 
  title, 
  tags = [], 
  bgColor = "#1a1a2e" 
} = Astro.props;

// Determine if we need to render a dynamic placeholder
const hasRealImage = !!image;

// Extract initials for placeholder
const initials = title
  .split(' ')
  .map(word => word[0])
  .join('')
  .substring(0, 2)
  .toUpperCase();

// Choose a tag for display in the placeholder
const mainTag = tags.length > 0 ? tags[0] : "";

// Generate a unique ID for this component instance
const uniqueId = `image-${Math.random().toString(36).substring(2, 10)}`;

// Fix the image path with more intelligent path handling
const getImagePath = (path: string | undefined) => {
  if (!path) return '';
  
  // For paths that look like @images/project/image.jpg
  if (path.startsWith('@images/')) {
    // Convert to /images/project/image.jpg
    return path.replace('@images/', '/images/');
  }
  
  // If the path doesn't start with / or http, add /
  if (!path.startsWith('/') && !path.startsWith('http')) {
    return `/${path}`;
  }
  
  return path;
};

const imagePath = getImagePath(image);

// The card slot is h-48 (192px) at the full column width. The widest column is
// about 507 CSS px (1728px viewport, 3 columns) and a 3x phone draws a 342px
// column at 1026 device px, so 1080 covers both and 1200 the 2x 1920 desktop.
// Every value must be on Vercel's allowed list; see VERCEL_WIDTHS.
const size = hasRealImage ? getImageSize(imagePath) : undefined;
const widths = size ? allowedWidths(size.naturalWidth, [640, 828, 1080, 1200]) : [];
const declaredWidth = widths[widths.length - 1] ?? 1200;

// Very wide sources (the spectrogram is 3.44:1) are height-limited in a
// 192px box under object-cover: it would crop most of the figure and need
// about 2000 device px to stay sharp. Letterbox them on black instead, which
// keeps the whole figure and keeps the slot width-limited, so `sizes` holds.
const isVeryWide = !!size && size.naturalWidth / size.naturalHeight > 2.5;
const fitClass = isVeryWide ? "object-contain bg-black" : "object-cover";
---

{hasRealImage ? (
  <div class="w-full h-48 overflow-hidden rounded-lg image-container" id={uniqueId}>
    {/* Served through Astro's image pipeline rather than as a raw <img>.
        These source files are 3-4MB camera originals in public/, and the card
        renders them into a 192px-tall box; a plain <img src> shipped the full
        original, roughly 20x more bytes than the slot can use. `widths` +
        `sizes` emit a srcset so the browser picks a size that matches the
        card's real width in the 1/2/3-column grid.

        `sizes` mirrors the layout in src/pages/project.astro: px-6 (48px)
        below 640, sm:px-20 (160px) from 640, then gap-6 (24px) between the
        2 columns at md and the 3 columns at lg. The old 400px desktop value
        undercounted the 410-507px column, and its 414w candidate was off
        Vercel's list, so a 1x phone picked it, got a 400, and fell back to
        the initials placeholder. */}
    <Image
      src={imagePath}
      alt={title}
      width={declaredWidth}
      height={Math.round(declaredWidth / 2)}
      widths={widths}
      sizes="(max-width: 639px) calc(100vw - 48px), (max-width: 767px) calc(100vw - 160px), (max-width: 1023px) calc((100vw - 184px) / 2), calc((100vw - 208px) / 3)"
      format="webp"
      quality={80}
      loading="lazy"
      decoding="async"
      class={`w-full h-full ${fitClass} object-center transition-transform duration-300 group-hover:scale-105 real-image`}
      onerror={`
        // The path-guessing retry this used to carry was dead code: every image
        // referenced by the project collection resolves. Keep only the graceful
        // degradation to the initials placeholder.
        this.onerror = null;
        this.style.display = 'none';
        document.getElementById('${uniqueId}').querySelector('.fallback').style.display = 'flex';
      `}
    />
    <div 
      class="fallback w-full h-full flex-col items-center justify-center text-center p-4"
      style={`background-color: ${bgColor}; color: #e0e0e0; display: none;`}
    >
      <div class="text-3xl font-bold mb-2">{initials}</div>
      <div class="text-sm opacity-80">{mainTag}</div>
      <div class="text-xs mt-4 opacity-60">{title}</div>
    </div>
  </div>
) : (
  <div 
    class="w-full h-48 rounded-lg flex flex-col items-center justify-center text-center p-4"
    style={`background-color: ${bgColor}; color: #e0e0e0;`}
  >
    <div class="text-3xl font-bold mb-2">{initials}</div>
    <div class="text-sm opacity-80">{mainTag}</div>
    <div class="text-xs mt-4 opacity-60">{title}</div>
  </div>
)}

<style>
  .image-container img {
    transition: transform 0.4s ease-out;
  }
  
  .project-card:hover .image-container img {
    transform: scale(1.05);
  }
  
  .fallback {
    background: linear-gradient(135deg, #1a1a2a 0%, #2a2a3a 100%);
  }
</style>