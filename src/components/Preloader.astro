<!-- Preloader: shows on first visit per session -->
<div id="preloader" class="preloader" aria-hidden="true">
  <div class="preloader-content">
    <div class="preloader-initials">
      <span class="preloader-char">R</span><span class="preloader-char">S</span>
    </div>
    <div class="preloader-line"></div>
  </div>
</div>

<style>
  .preloader {
    position: fixed;
    inset: 0;
    z-index: 10000;
    background: #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .preloader.hidden {
    display: none;
  }

  .preloader-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .preloader-initials {
    font-family: 'IBM Plex Mono', monospace;
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 900;
    letter-spacing: 0.2em;
    color: #ffffff;
    display: flex;
    gap: 0.1em;
  }

  .preloader-char {
    display: inline-block;
    opacity: 0;
    transform: translateY(40px);
  }

  .preloader-line {
    width: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, #ffffff, transparent);
  }
</style>

<script>
  import gsap from 'gsap';

  function runPreloader() {
    const preloader = document.getElementById('preloader');
    if (!preloader) return;

    // Only show on first visit per session
    if (sessionStorage.getItem('preloader-shown')) {
      preloader.classList.add('hidden');
      document.dispatchEvent(new CustomEvent('preloader:complete'));
      return;
    }

    // Check reduced motion
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      preloader.classList.add('hidden');
      sessionStorage.setItem('preloader-shown', '1');
      document.dispatchEvent(new CustomEvent('preloader:complete'));
      return;
    }

    const chars = preloader.querySelectorAll('.preloader-char');
    const line = preloader.querySelector('.preloader-line');

    const tl = gsap.timeline({
      onComplete: () => {
        sessionStorage.setItem('preloader-shown', '1');
        document.dispatchEvent(new CustomEvent('preloader:complete'));
      },
    });

    tl.to(chars, {
      opacity: 1,
      y: 0,
      duration: 0.8,
      stagger: 0.1,
      ease: 'expo.out',
    })
      .to(
        line,
        {
          width: '120px',
          duration: 0.6,
          ease: 'expo.out',
        },
        '-=0.3'
      )
      .to(
        preloader,
        {
          yPercent: -100,
          duration: 0.8,
          ease: 'expo.inOut',
        },
        '+=0.3'
      )
      .set(preloader, { display: 'none' });
  }

  // Run on initial load
  runPreloader();
</script>
